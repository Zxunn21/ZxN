-- Auto-ON berdasarkan kesesuaian UniverseId
-- Memeriksa setiap baris: jika game.GameId sama dengan universeId baris tersebut,
-- maka otomatis ON. Ada jeda 1 detik antar baris agar tidak konflik.
task.spawn(function()
	local currentUniverseId = game.GameId
	for i, feature in ipairs(gameLinkFeatures) do
		if feature.universeId and feature.universeId ~= 0 and feature.universeId == currentUniverseId then
			task.wait(1)
			if gameFeatureEnableFns[i] then
				gameFeatureEnableFns[i]()
			end
		end
	end
end)

