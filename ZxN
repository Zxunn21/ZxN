	button.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	button.BorderSizePixel = 0
	button.Text = "OFF"
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 12
	button.Font = Enum.Font.GothamBold
	button.ZIndex = 512
	button.Parent = row

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = button

	local function updateButton()
		if enabled then
			button.Text = "ON"
			button.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
		else
			button.Text = "OFF"
			button.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		end
	end

	local function doEnable()
		if enabled then return end
		enabled = true
		updateButton()

		local guiExists = false
		if feature.guiToHide and playerGui then
			for _, descendant in ipairs(playerGui:GetDescendants()) do
				if descendant.Name == feature.guiToHide then
					guiExists = true
					break
				end
			end
		end

		if guiExists then
			setGuiVisible(feature.guiToHide, true)
		else
			local success, result = pcall(function()
				if type(loadstring) ~= "function" then
					error("loadstring tidak tersedia di lingkungan ini")
				end
				if type(game.HttpGet) ~= "function" then
					error("game:HttpGet tidak tersedia di lingkungan ini")
				end
				return loadstring(game:HttpGet(feature.url, true))()
			end)

			if not success then
				warn("[ZxN] " .. feature.description .. " gagal dimuat: " .. tostring(result))
				enabled = false
				updateButton()
			end
		end
	end

	local function doDisable()
		if not enabled then return end
		enabled = false
		updateButton()
		setGuiVisible(feature.guiToHide, false)
	end

	table.insert(featureStateRefs, doDisable)
	table.insert(gameFeatureEnableFns, doEnable)

	button.Activated:Connect(function()
		if enabled then
			doDisable()
		else
			doEnable()
		end

		menuFrame.Visible = false
		menuOpen = false
	end)
end

