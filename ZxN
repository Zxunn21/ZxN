-- === Logika tombol "<<" (buka kembali frame terakhir yang ditutup) ===
-- Semua frame yang dilacak: menu utama, control frame, dan teleport frame.
local trackedFrames = {
	{ frame = menuFrame, onOpen = function() menuOpen = true end },
	{ frame = frameRideAPet, onOpen = function() frameOpen = true end },
	{ frame = teleportFrame },
}

local lastClosedFrame = nil
local lastClosedOnOpen = nil

local function updateReopenButton()
	local allClosed = true
	for _, entry in ipairs(trackedFrames) do
		if entry.frame.Visible then
			allClosed = false
			break
		end
	end
	-- Tombol hanya muncul jika semua frame tertutup
	-- dan ada frame yang pernah ditutup
	reopenButton.Visible = allClosed and lastClosedFrame ~= nil
end

for _, entry in ipairs(trackedFrames) do
	entry.frame:GetPropertyChangedSignal("Visible"):Connect(function()
		if entry.frame.Visible then
			updateReopenButton()
		else
			-- Catat frame ini sebagai frame terakhir yang ditutup
			lastClosedFrame = entry.frame
			lastClosedOnOpen = entry.onOpen
			-- Defer agar rangkaian perubahan (mis. buka frame lain) selesai dulu
			task.defer(updateReopenButton)
		end
	end)
end

reopenButton.Activated:Connect(function()
	if lastClosedFrame and lastClosedFrame.Parent then
		lastClosedFrame.Visible = true
		if lastClosedOnOpen then
			lastClosedOnOpen()
		end
		updateReopenButton()
	end
end)

