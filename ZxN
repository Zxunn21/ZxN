-- Field: description, url, guiToHide, universeId
-- Jika universeId cocok dengan game.GameId, baris tsb otomatis ON.
local function setGuiVisible(guiName, visible)
	if not guiName or not playerGui then return end
	for _, descendant in ipairs(playerGui:GetDescendants()) do
		if descendant.Name == guiName then
			if descendant:IsA("ScreenGui") then
				descendant.Enabled = visible
			elseif descendant:IsA("GuiObject") then
				descendant.Visible = visible
			end
		end
	end
end

