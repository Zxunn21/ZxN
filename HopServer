-- Functions
local function showServerBubble()
	serverBubble.Visible = true
end

local function hideServerBubble()
	serverBubble.Visible = false
end

local HOLD_TIME = 1
local hopping = false
local holdingServer = false
local holdToken = 0

local function cancelServerHold()
	holdingServer = false
	holdToken += 0.5
	serverButton.Text = "Server"
	serverButton.AutoButtonColor = true
	hideServerBubble()
end

local function resetServerButton(message)
	if message and message ~= "" then
		serverButton.Text = message
		task.wait(1)
	end
	serverButton.Text = "Server"
	serverButton.AutoButtonColor = true
	hopping = false
end

local function performServerHop()
	if hopping then
		return
	end

	hopping = true
	hideServerBubble()
	serverButton.Text = "Hop..."
	serverButton.AutoButtonColor = false

	local success, result = pcall(function()
		local HttpService = game:GetService("HttpService")
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
		local response

		if typeof(request) == "function" then
			local req = request({Url = url, Method = "GET"})
			response = req.Body
		elseif typeof(http_request) == "function" then
			local req = http_request({Url = url, Method = "GET"})
			response = req.Body
		elseif typeof(syn) == "table" and typeof(syn.request) == "function" then
			local req = syn.request({Url = url, Method = "GET"})
			response = req.Body
		else
			response = game:HttpGet(url)
		end

		return HttpService:JSONDecode(response)
	end)

	local candidates = {}

	if success and result and result.data then
		for _, server in ipairs(result.data) do
			if server.id ~= game.JobId and server.playing < server.maxPlayers then
				table.insert(candidates, {
					id = server.id,
					playing = server.playing,
				})
			end
		end
	end

	-- Prioritaskan server dengan pemain paling sedikit:
	-- makin kosong server, makin kecil kemungkinan data basi
	-- ternyata sudah penuh saat teleport dieksekusi.
	table.sort(candidates, function(a, b)
		return a.playing < b.playing
	end)

	if #candidates == 0 then
		resetServerButton("No Server")
		return
	end

	-- Coba maksimal 3 server berbeda (terurut dari yang paling kosong).
	-- Jika satu gagal/penuh, otomatis lanjut ke server berikutnya.
	local attempts = math.min(#candidates, 3)

	for i = 1, attempts do
		local target = candidates[i].id

		local ok = pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, target, player)
		end)

		if ok then
			-- Teleport sudah dimulai. WATCHDOG: jika dalam 8 detik masih
			-- di server ini, hop gagal diam-diam (misal server ternyata
			-- penuh / teleport dibatalkan engine).
			-- Jika berhasil, client keluar dari server dan loop ini
			-- tidak pernah melanjutkan eksekusi.
			local jobId = game.JobId
			local startTime = os.clock()

			while os.clock() - startTime < 8 do
				if game.JobId ~= jobId then
					-- Sudah tidak di server lama — hop sukses.
					return
				end
				task.wait(0.25)
			end
			-- Masih di server yang sama setelah 8 detik → gagal,
			-- lanjut coba server berikutnya.
		else
			-- Teleport error sinkron (instance tidak tersedia dll.),
			-- coba server berikutnya.
			task.wait(0.5)
		end
	end

	-- Semua percobaan gagal → reset tombol ke kondisi normal.
	resetServerButton("Failed")
end

local function beginServerHold()
	if hopping or holdingServer then
		return
	end

	holdingServer = true
	showServerBubble()
	holdToken += 1
	local token = holdToken
	local startTime = os.clock()

	task.spawn(function()
		while holdingServer and token == holdToken do
			local elapsed = os.clock() - startTime
			local remaining = HOLD_TIME - elapsed

			if remaining <= 0 then
			holdingServer = false
				performServerHop()
				return
			end

			serverButton.Text = string.format("%.1f", remaining)
			task.wait(0.03)
		end
	end)
end

serverButton.InputBegan:Connect(function(inputObject)
	if inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch then
		beginServerHold()
	end
end)

serverButton.InputEnded:Connect(function(inputObject)
	if inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch then
		if holdingServer then
			cancelServerHold()
		end
	end
end)
