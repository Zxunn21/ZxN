		serverButton.Text = message

		task.wait(1)
	end

	serverButton.Text = "Server"
	serverButton.AutoButtonColor = true

	hopping = false
end

-- =========================================================
-- GET SERVER LIST
-- =========================================================

local function getServerList()

	local url =
		"https://games.roblox.com/v1/games/"
		.. game.PlaceId
		.. "/servers/Public?sortOrder=Asc&limit=100"

	local response

	local success, result = pcall(function()

		-- Executor request
		if typeof(request) == "function" then

			local req = request({
				Url = url,
				Method = "GET"
			})

			return req.Body

		elseif typeof(http_request) == "function" then

			local req = http_request({
				Url = url,
				Method = "GET"
			})

			return req.Body

		elseif typeof(syn) == "table"
			and typeof(syn.request) == "function" then

			local req = syn.request({
				Url = url,
				Method = "GET"
			})

			return req.Body

		else
			return game:HttpGet(url)
		end

	end)

	if not success or not result then
		return nil
	end

	local decodeSuccess, data = pcall(function()
		return HttpService:JSONDecode(result)
	end)

	if not decodeSuccess then
		return nil
	end

	return data
end

-- =========================================================
-- FIND EMPTY SERVER
-- =========================================================

local function findEmptyServers()

	local data = getServerList()

	if not data or not data.data then
		return {}
	end

	local candidates = {}

	for _, server in ipairs(data.data) do

		local serverId = server.id
		local playing = tonumber(server.playing) or 0
		local maxPlayers = tonumber(server.maxPlayers) or 0

		-- Jangan masuk server sekarang
		if serverId ~= game.JobId then

			-- Harus benar-benar <= 1 pemain
			if playing <= MAX_PLAYERS_FOR_EMPTY then

				-- Harus masih memiliki slot
				if playing < maxPlayers then

					table.insert(candidates, {
						id = serverId,
						playing = playing,
						maxPlayers = maxPlayers
					})

				end
			end
		end
	end

	-- Server paling kosong di depan
	table.sort(candidates, function(a, b)

		if a.playing == b.playing then
			return a.maxPlayers < b.maxPlayers
		end

		return a.playing < b.playing

	end)

	return candidates
end

-- =========================================================
-- TELEPORT TO SPECIFIC SERVER
-- =========================================================

local function teleportToServer(serverId)

	local oldJobId = game.JobId

	local success = pcall(function()

		TeleportService:TeleportToPlaceInstance(
			game.PlaceId,
			serverId,
			player
		)

	end)

	if not success then
		return false
	end

	local startTime = os.clock()

	while os.clock() - startTime < TELEPORT_TIMEOUT do

		if game.JobId ~= oldJobId then
			return true
		end

		task.wait(0.25)
	end

	return false
end

-- =========================================================
-- FALLBACK ROBLOX MATCHMAKING
-- =========================================================

local function fallbackTeleport()

	serverButton.Text = "New..."

	local oldJobId = game.JobId

	local success = pcall(function()

		TeleportService:Teleport(
			game.PlaceId,
			player
		)

	end)

	if not success then
		return false
	end

	local startTime = os.clock()

	while os.clock() - startTime < TELEPORT_TIMEOUT do

		if game.JobId ~= oldJobId then
			return true
		end

		task.wait(0.25)
	end

	return false
end

-- =========================================================
-- MAIN SERVER HOP
-- =========================================================

local function performServerHop()

	if hopping then
		return
	end

	hopping = true

	hideServerBubble()

	serverButton.Text = "Check..."
	serverButton.AutoButtonColor = false

	-- =====================================================
	-- CEK BLOCKED PLAYER DI SERVER SEKARANG
	-- =====================================================

	local blockedHere, blockedPlayer = hasBlockedPlayerHere()

	if blockedHere then

		serverButton.Text = "Blocked"

		task.wait(0.5)

		-- Langsung cari server lain
	end

	-- =====================================================
	-- CARI SERVER ≤ 1 PEMAIN
	-- =====================================================

	serverButton.Text = "Scan..."

	local candidates = findEmptyServers()

	-- =====================================================
	-- ADA SERVER KOSONG
	-- =====================================================

	if #candidates > 0 then

		serverButton.Text = "Found"

		task.wait(0.3)

		local attempts = math.min(
			#candidates,
			MAX_ATTEMPTS
		)

		for i = 1, attempts do

			local target = candidates[i]

			serverButton.Text =
				"Hop " .. target.playing

			local success = teleportToServer(target.id)

			if success then
				return
			end

			task.wait(0.5)
		end
	end

	-- =====================================================
	-- TIDAK ADA EMPTY SERVER
	-- =====================================================

	serverButton.Text = "No Empty"

	task.wait(0.5)

	-- Biarkan Roblox memilih server
	local success = fallbackTeleport()

	if success then
		return
	end

	-- =====================================================
	-- RETRY
	-- =====================================================

	serverButton.Text = "Retry..."

	task.wait(1)

	local retryCandidates = findEmptyServers()

	for i = 1, math.min(#retryCandidates, MAX_ATTEMPTS) do

		local target = retryCandidates[i]

		serverButton.Text =
			"Hop " .. target.playing

		if teleportToServer(target.id) then
			return
		end

		task.wait(0.5)
	end

	resetServerButton("Failed")
end

-- =========================================================
-- HOLD
-- =========================================================

local function beginServerHold()

	if hopping or holdingServer then
		return
	end

	holdingServer = true

	showServerBubble()

	holdToken += 1

	local token = holdToken
	local startTime = os.clock()

	task.spawn(function()

		while holdingServer
			and token == holdToken do

			local elapsed = os.clock() - startTime
			local remaining = HOLD_TIME - elapsed

			if remaining <= 0 then

				holdingServer = false

				performServerHop()

				return
			end

			serverButton.Text =
				string.format("%.1f", remaining)

			task.wait(0.03)
		end

	end)
end

