-- =========================================================
-- BLOCKED USER CACHE
-- =========================================================

local blockedUsers = {}

local function updateBlockedUsers()

	table.clear(blockedUsers)

	local success, result = pcall(function()
		return StarterGui:GetBlockedUserIds()
	end)

	if not success or typeof(result) ~= "table" then
		return
	end

	for _, userId in ipairs(result) do
		blockedUsers[tonumber(userId)] = true
	end
end

-- Ambil daftar blocked saat script mulai
updateBlockedUsers()

-- Roblox akan memberi event saat daftar block berubah
pcall(function()

	local blockedEvent = StarterGui.PlayerBlockedEvent

	if blockedEvent then

		blockedEvent.Event:Connect(function(userId)

			if userId then
				blockedUsers[tonumber(userId)] = true
			end

		end)

	end

end)

-- =========================================================
-- CEK PLAYER BLOCKED DI SERVER SEKARANG
-- =========================================================

local function hasBlockedPlayerHere()

	updateBlockedUsers()

	for _, otherPlayer in ipairs(Players:GetPlayers()) do

		if otherPlayer ~= player then

			local userId = tonumber(otherPlayer.UserId)

			if userId and blockedUsers[userId] then
				return true, otherPlayer
			end

		end
	end

	return false, nil
end

