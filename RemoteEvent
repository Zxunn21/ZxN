		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = true,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 6) }),
		create("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Transparency = 0.6, Thickness = 1 }),
	})
	btn.MouseButton1Click:Connect(function()
		-- Refresh path (bisa berubah jika dipindah, dan remote bisa sudah hancur)
		if entry.remote and entry.remote.Parent then
			entry.remotePath = entry.remote:GetFullName()
		end
		selectEntry(entry)
	end)
	return btn
end

local function recordTrigger(remote, method, caller, callerLine, args)
	-- Abaikan trigger dari tool ini sendiri agar daftar tetap bersih
	if caller == thisScriptPath then return end
	if not remote or not remote.Parent then return end

	local key = tostring(remote) .. method .. caller
	local existingIdx = entryKeyToIndex[key]
	if existingIdx then
		-- Update argument terbaru untuk entry yang sudah ada
		entries[existingIdx].args = args
		return
	end

	local entry = {
		remote = remote,
		remoteClass = remote.ClassName,
		remotePath = remote:GetFullName(),
		method = method,
		caller = caller,
		callerLine = callerLine,
		args = args,
	}
	table.insert(entries, entry)
	entryKeyToIndex[key] = #entries

	local btn = makeEntryButton(entry)
	btn.LayoutOrder = #entries
	btn.Parent = leftScroll
end

-- === HOOK __namecall ===
-- Intercept semua FireServer (RemoteEvent) dan InvokeServer (RemoteFunction)
-- yang dipanggil dari script client, lalu catat siapa pememicunya.
local instanceMT = getmetatable(game)
local oldNamecall = instanceMT.__namecall
instanceMT.__namecall = function(self, ...)
	local methodName = (select(1, ...))
	if methodName == "FireServer" and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
		local caller = debug.info(2, "s") or "(tidak diketahui)"
		local line = tostring(debug.info(2, "l")) or "?"
		local args = { select(2, ...) }
		local ok, err = pcall(recordTrigger, self, "FireServer", caller, line, args)
		if not ok then warn("RemoteEvent Spy error: " .. tostring(err)) end
	elseif methodName == "InvokeServer" and typeof(self) == "Instance" and self:IsA("RemoteFunction") then
		local caller = debug.info(2, "s") or "(tidak diketahui)"
		local line = tostring(debug.info(2, "l")) or "?"
		local args = { select(2, ...) }
		local ok, err = pcall(recordTrigger, self, "InvokeServer", caller, line, args)
		if not ok then warn("RemoteEvent Spy error: " .. tostring(err)) end
	end
	return oldNamecall(self, ...)
end

-- === TOMBOL EXECUTE ===
-- Menembakkan ulang remote dengan argument yang terekam
executeButton.MouseButton1Click:Connect(function()
	if not selectedEntry then return end
	local entry = selectedEntry
	if not entry.remote or not entry.remote.Parent then
		warn("Remote sudah tidak ada: " .. entry.remotePath)
		return
	end
	local ok, err
	if entry.method == "FireServer" then
		ok, err = pcall(function()
			entry.remote:FireServer(table.unpack(entry.args))
		end)
	else
		ok, err = pcall(function()
			entry.remote:InvokeServer(table.unpack(entry.args))
		end)
	end
	if not ok then
		warn("Execute gagal: " .. tostring(err))
	end
end)

-- === TOPBAR DRAGABLE ===
do
	local dragging = false
	local dragStart = nil
	local startPos = nil

	topBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
		end
	end)

	topBar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

