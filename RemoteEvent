-- === DATA & LOGIKA ===
local entries = {} -- array of {remote, remoteClass, remotePath, caller, callerLine, args, method}
local entryKeyToIndex = {}
local selectedEntry = nil

local function describeValue(v)
	if type(v) == "table" then
		local ok, encoded = pcall(function() return game:GetService("HttpService"):JSONEncode(v) end)
		if ok then return encoded end
		return tostring(v)
	end
	return tostring(v)
end

local function formatArgs(args)
	local parts = {}
	for i, v in ipairs(args) do
		parts[i] = "  [" .. i .. "] " .. describeValue(v)
	end
	if #parts == 0 then
		return "  (tanpa argument)"
	end
	return table.concat(parts, "\n")
end

local function selectEntry(entry)
	selectedEntry = entry
	clearDetails()
	addDetailRow(1, "Class", entry.remoteClass)
	addDetailRow(2, "Remote", entry.remotePath)
	addDetailRow(3, "Method", entry.method)
	addDetailRow(4, "Aksi Pemicu", entry.trigger)
	addDetailRow(5, "Arguments", formatArgs(entry.args))
	executeButton.Visible = true
end

local function makeEntryButton(entry)
	local label = entry.remote.Name .. " - " .. entry.trigger
	local btn = create("TextButton", {
		Name = entry.remotePath .. entry.method,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Color3.fromRGB(60, 120, 200),
		BackgroundTransparency = 0.3,
		Text = label,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = true,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 6) }),
		create("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Transparency = 0.6, Thickness = 1 }),
	})
	btn.MouseButton1Click:Connect(function()
		-- Refresh path (bisa berubah jika dipindah, dan remote bisa sudah hancur)
		if entry.remote and entry.remote.Parent then
			entry.remotePath = entry.remote:GetFullName()
		end
		selectEntry(entry)
	end)
	return btn
end

local function recordTrigger(remote, method, trigger, args)
	if not remote or not remote.Parent then return end

	local key = tostring(remote) .. method
	local existingIdx = entryKeyToIndex[key]
	if existingIdx then
		-- Update trigger & argument terbaru untuk entry yang sudah ada
		entries[existingIdx].trigger = trigger
		entries[existingIdx].args = args
		return
	end

	local entry = {
		remote = remote,
		remoteClass = remote.ClassName,
		remotePath = remote:GetFullName(),
		method = method,
		trigger = trigger,
		args = args,
	}
	table.insert(entries, entry)
	entryKeyToIndex[key] = #entries

	local btn = makeEntryButton(entry)
	btn.LayoutOrder = #entries
	btn.Parent = leftScroll
end

-- === TRACKING AKSI PEMAIN ===
-- Catat aksi terakhir (lompat, klik, pukul, dll) agar tiap remote yang
-- menyala bisa diberi label aksi apa yang memicunya.
local lastAction = "(belum ada aksi)"
local lastActionAt = 0
local ACTION_WINDOW = 5 -- detik; remote yang menyala > 5 dtk setelah aksi dianggap dari server

local function setAction(label)
	lastAction = label
	lastActionAt = os.clock()
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	local label
	if input.KeyCode == Enum.KeyCode.Space then
		label = "Lompat (Space)"
	elseif input.KeyCode == Enum.KeyCode.ButtonA then
		label = "Lompat (Tombol A)"
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		label = "Klik kiri"
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		label = "Klik kanan"
	elseif input.UserInputType == Enum.UserInputType.Touch then
		label = "Sentuh layar"
	elseif input.UserInputType == Enum.UserInputType.Keyboard then
		label = "Tombol " .. input.KeyCode.Name
	end
	if label then setAction(label) end
end)

-- Aksi memukul / menggunakan Tool (misal pedang, tinju)
local function watchCharacter(character)
	local function watchTool(tool)
		if tool:IsA("Tool") then
			tool.Activated:Connect(function()
				setAction("Pukul/Gunakan (Tool " .. tool.Name .. ")")
			end)
		end
	end
	for _, child in ipairs(character:GetChildren()) do
		watchTool(child)
	end
	character.ChildAdded:Connect(watchTool)
end
if player.Character then watchCharacter(player.Character) end
player.CharacterAdded:Connect(watchCharacter)

-- === MONITORING REMOTE ===
-- Pasang listener OnClientEvent ke semua RemoteEvent yang ada (dan yang
-- muncul nanti, lewat DescendantAdded). Setiap kali remote menyala ke
-- client - misal server mem-broadcast efek setelah kamu memukul atau
-- melakukan aksi - remote itu tercatat di panel kiri beserta aksinya.
local function isRemoteEvent(inst)
	return inst.ClassName == "RemoteEvent" or inst.ClassName == "UnreliableRemoteEvent"
end

local function getTriggerLabel()
	if os.clock() - lastActionAt <= ACTION_WINDOW then
		return lastAction
	end
	return "(server / tanpa aksi baru)"
end

local function hookRemote(remote)
	local ok, err = pcall(function()
		remote.OnClientEvent:Connect(function(...)
			recordTrigger(remote, "OnClientEvent", getTriggerLabel(), { ... })
		end)
	end)
	if not ok then
		warn("RemoteEvent Spy: gagal memasang listener di " .. remote:GetFullName())
	end
end

for _, descendant in ipairs(game:GetDescendants()) do
	if isRemoteEvent(descendant) then
		hookRemote(descendant)
	end
end
game.DescendantAdded:Connect(function(descendant)
	if isRemoteEvent(descendant) then
		hookRemote(descendant)
	end
end)

-- === TOMBOL EXECUTE ===
-- Menembakkan ulang remote dengan argument yang terekam
executeButton.MouseButton1Click:Connect(function()
	if not selectedEntry then return end
	local entry = selectedEntry
	if not entry.remote or not entry.remote.Parent then
		warn("Remote sudah tidak ada: " .. entry.remotePath)
		return
	end
	local ok, err
	if entry.method == "InvokeServer" then
		ok, err = pcall(function()
			entry.remote:InvokeServer(table.unpack(entry.args))
		end)
	else
		ok, err = pcall(function()
			entry.remote:FireServer(table.unpack(entry.args))
		end)
	end
	if not ok then
		warn("Execute gagal: " .. tostring(err))
	end
end)

-- === TOPBAR DRAGABLE ===
do
	local dragging = false
	local dragStart = nil
	local startPos = nil

	topBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
		end
	end)

	topBar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

