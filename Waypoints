-- ===================== WAYPOINT HELPER =====================
-- Format data waypoint:
--   { universe = <UniverseId>, name = "<Nama>", emoji = "📍", position = Vector3.new(x, y, z) }
local WAYPOINTS = {
	-- Contoh:
	-- { universe = 1234567890, name = "Spawn", emoji = "📍", position = Vector3.new(0, 5, 0) },
}
-- ============================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local UNIVERSE_ID = game.GameId

-- ===================== Util =====================

local function formatNumber(n)
	return tostring(math.round(n * 100) / 100)
end

-- Posisi karakter saat ini (dipakai saat membuat waypoint baru)
local function getCharacterPosition()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		return hrp.Position
	end
	return Vector3.zero
end

-- Semua waypoint yang cocok dengan universe saat ini
local function getWaypointsForThisUniverse()
	local result = {}
	for _, wp in WAYPOINTS do
		if wp.universe == UNIVERSE_ID then
			table.insert(result, wp)
		end
	end
	return result
end

-- Serialisasi seluruh data waypoint (helper + yang baru dibuat)
-- dengan format yang sama persis seperti tabel WAYPOINTS di atas.
local function serializeAllWaypoints()
	local lines = { "local WAYPOINTS = {" }
	for _, wp in WAYPOINTS do
		local p = wp.position
		table.insert(
			lines,
			string.format(
				'\t{ universe = %d, name = "%s", emoji = "%s", position = Vector3.new(%s, %s, %s) },',
				wp.universe,
				wp.name,
				wp.emoji or "📍",
				formatNumber(p.X),
				formatNumber(p.Y),
				formatNumber(p.Z)
			)
		)
	end
	table.insert(lines, "}")
	return table.concat(lines, "\n")
end

