local function openSpeedInput()
	speedBubbleText.Text = "Speed"
	speedBubbleText.Size = UDim2.new(1, -12, 0, 22)
	speedBubbleText.Position = UDim2.fromOffset(6, 4)
	speedInput.Visible = true
	speedInput:CaptureFocus()
end

local function hideSpeedBubble()
	speedBubble.Visible = false
	if speedInput:IsFocused() then
		speedInput:ReleaseFocus()
	end
end

local speedHoldTime = 1
local speedHolding = false
local speedHoldToken = 0

local function beginSpeedHold()
	if speedHolding then
		return
	end

	speedHolding = true
	showSpeedBubble()
	speedHoldToken += 1
	local token = speedHoldToken
	local startTime = os.clock()

	task.spawn(function()
		while speedHolding and token == speedHoldToken do
			if os.clock() - startTime >= speedHoldTime then
				speedHolding = false
				openSpeedInput()
				return
			end
			task.wait(0.03)
		end
	end)
end

local function cancelSpeedHold()
	speedHolding = false
	speedHoldToken += 0.3
	hideSpeedBubble()
end

