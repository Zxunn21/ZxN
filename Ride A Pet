local function getSpecialEggModel(eggName)
	findRenderedEggs()
	if not renderedEggs or not renderedEggs.Parent then
		return nil
	end

	for _, model in ipairs(renderedEggs:GetChildren()) do
		if model:IsA("Model") and model.Name == eggName then
			return model
		end
	end

	return nil
end

local function teleportToEgg(model)
	if not model or not model.Parent then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local pivot = model:GetPivot()
	root.CFrame = CFrame.new(pivot.Position + Vector3.new(0, 3, 0))

	teleportFrame.Visible = false
end

local lastTeleportKey = nil

local function updateTeleportList()
	local found = {}
	local keyParts = {}

	for _, eggName in ipairs({"Cherub Egg", "Blackhole Egg", "Galaxy Egg"}) do
		local model = getSpecialEggModel(eggName)

		if model then
			found[eggName] = model
			table.insert(keyParts, eggName .. ":" .. model:GetDebugId())
		end
	end

	local key = table.concat(keyParts, "|")

	teleportButton.Visible = not minimized and key ~= ""

	if key == lastTeleportKey then
		return
	end

	lastTeleportKey = key

	for _, child in ipairs(teleportList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local order = 0

	for _, eggName in ipairs({"Cherub Egg", "Blackhole Egg", "Galaxy Egg"}) do
		local model = found[eggName]

		if model then
			order += 1

			local button = Instance.new("TextButton")
			button.Name = eggName:gsub("%s+", "")
			button.Size = UDim2.new(1, -4, 0, 42)
			button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			button.BorderSizePixel = 0
			button.Text = eggName
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextSize = 15
			button.Font = Enum.Font.GothamBold
			button.LayoutOrder = order
			button.ZIndex = 702
			button.Parent = teleportList

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 7)
			corner.Parent = button

			button.Activated:Connect(function()
				teleportToEgg(model)
			end)
		end
	end

	if order == 0 then
		teleportFrame.Visible = false
	end
end

