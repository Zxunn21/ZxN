local function makeDraggable(resolve, canDrag, onTap)
	local dragging = false
	local moved = false
	local dragStart = nil
	local startPos = nil
	local connectedBtn = nil

	local function onInputBegan(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			local btn = resolve()
			startPos = btn and btn.AbsolutePosition or nil
		end
	end
	local function onInputEnded(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging and not moved and onTap then
				onTap()
			end
			dragging = false
		end
	end
	UserInputService.InputChanged:Connect(function(input)
		if dragging and canDrag() and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local btn = resolve()
			if not btn or not startPos then return end
			local dx = input.Position.X - dragStart.X
			local dy = input.Position.Y - dragStart.Y
			if math.abs(dx) > 8 or math.abs(dy) > 8 then
				moved = true
			end
			if moved then
				local vw, vh = getViewport()
				local w = btn.AbsoluteSize.X
				local h = btn.AbsoluteSize.Y
				local x = math.clamp(startPos.X + dx, 4, vw - w - 4)
				local y = math.clamp(startPos.Y + dy, 60, vh - h - 4)
				btn.Position = UDim2.new(0, x, 0, y)
			end
		end
	end)
	return function()
		local btn = resolve()
		if btn and btn ~= connectedBtn then
			connectedBtn = btn
			btn.InputBegan:Connect(onInputBegan)
			btn.InputEnded:Connect(onInputEnded)
		end
		return dragging, moved
	end
end

