		end
	end
	table.clear(objectStartAttachments)

	for _, highlight in ipairs(objectHighlights) do
		if highlight and highlight.Parent then highlight:Destroy() end
	end
	table.clear(objectHighlights)
end

-- P = BasePart, M = Model.
-- Pencarian case-insensitive dan partial/contains:
-- "m cherub" -> "Cherub Egg"
-- "p part"  -> semua BasePart yang namanya mengandung "part"
local function findObjects(targetType, targetName)
	local results = {}

	if not targetType or not targetName then
		return results
	end

	targetName = targetName:match("^%s*(.-)%s*$")
	if targetName == "" then
		return results
	end

	local wanted = string.lower(targetName)

	for _, obj in ipairs(workspace:GetDescendants()) do
		local typeMatches =
			(targetType == "P" and obj:IsA("BasePart"))
			or (targetType == "M" and obj:IsA("Model"))

		if typeMatches and string.find(string.lower(obj.Name), wanted, 1, true) then
			table.insert(results, obj)
		end
	end

	return results
end

local function getRootPart()
	local character = player.Character
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function createObjectLines(targetType, targetName)
	clearObjectLines()

	if not objectLineEnabled then
		return
	end

	local rootPart = getRootPart()
	if not rootPart then
		return
	end

	local targets = findObjects(targetType, targetName)
	if #targets == 0 then
		return
	end

	for _, target in ipairs(targets) do
		local position = getObjectPosition(target)

		if position then
			local highlight = Instance.new("Highlight")
			highlight.Name = "ZxN_ObjectLineHighlight"
			highlight.Adornee = target
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillColor = Color3.fromRGB(255, 220, 60)
			highlight.FillTransparency = 0.72
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.OutlineTransparency = 0
			highlight.Parent = gui
			table.insert(objectHighlights, highlight)

			local targetPart = Instance.new("Part")
			targetPart.Name = "ObjectLineTarget"
			targetPart.Anchored = true
			targetPart.CanCollide = false
			targetPart.CanTouch = false
			targetPart.CanQuery = false
			targetPart.CastShadow = false
			targetPart.Transparency = 1
			targetPart.Size = Vector3.new(0.1, 0.1, 0.1)
			targetPart.CFrame = CFrame.new(position)
			targetPart.Parent = workspace

			local startAttachment = Instance.new("Attachment")
			startAttachment.Name = "ObjectLineStart"
			startAttachment.Parent = rootPart

			local endAttachment = Instance.new("Attachment")
			endAttachment.Name = "ObjectLineEnd"
			endAttachment.Parent = targetPart

			local beam = Instance.new("Beam")
			beam.Name = "ObjectLineBeam"
			beam.Attachment0 = startAttachment
			beam.Attachment1 = endAttachment
			beam.Width0 = 0.35
			beam.Width1 = 0.35
			beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
			beam.Transparency = NumberSequence.new(0)
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.Segments = 1
			beam.Parent = targetPart

			table.insert(objectBeams, beam)
			table.insert(objectTargetParts, {
				part = targetPart,
				target = target
			})
			table.insert(objectStartAttachments, startAttachment)
		end
	end

	currentTargetType = targetType
	currentTargetName = targetName
end

local function parseObjectInput()
	local input = objectInput.Text:match("^%s*(.-)%s*$")

	if input == "" then
		return nil, nil
	end

	local targetType, targetName = input:match("^([PpMm])%s+(.+)$")
	if not targetType or not targetName then
		return nil, nil
	end

	targetName = targetName:match("^%s*(.-)%s*$")
	if targetName == "" then
		return nil, nil
	end

	return string.upper(targetType), targetName
end

local function updateObjectLine()
	local targetType, targetName = parseObjectInput()

	if not targetType or not targetName then
		currentTargetType = nil
		currentTargetName = nil
		clearObjectLines()
		return
	end

	currentTargetType = targetType
	currentTargetName = targetName

	if objectLineEnabled then
		createObjectLines(targetType, targetName)
	else
		clearObjectLines()
	end
end

-- PLAYER LINE
local playerLineEnabled = false
local playerBeams = {}
local playerTargetParts = {}
local currentPlayerName = nil

local function clearPlayerLines()
	for _, beam in ipairs(playerBeams) do
		if beam and beam.Parent then
			beam:Destroy()
		end
	end
	table.clear(playerBeams)

	for _, data in ipairs(playerTargetParts) do
		if data.part and data.part.Parent then
			data.part:Destroy()
		end
	end
	table.clear(playerTargetParts)
end

local function findPlayers(targetName)
	local results = {}
	if not targetName then return results end

	targetName = targetName:match("^%s*(.-)%s*$")
	if targetName == "" then return results end

	local wanted = string.lower(targetName)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and string.find(string.lower(other.Name), wanted, 1, true) then
			table.insert(results, other)
		end
	end

	return results
end

local function getPlayerRoot(other)
	local character = other and other.Character
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function createPlayerLines(targetName)
	clearPlayerLines()

	if not playerLineEnabled then return end

	local rootPart = getRootPart()
	if not rootPart then return end

	local targets = findPlayers(targetName)

	for _, other in ipairs(targets) do
		local targetRoot = getPlayerRoot(other)

		if targetRoot then
			local targetPart = Instance.new("Part")
			targetPart.Name = "PlayerLineTarget"
			targetPart.Anchored = true
			targetPart.CanCollide = false
			targetPart.CanTouch = false
			targetPart.CanQuery = false
			targetPart.CastShadow = false
			targetPart.Transparency = 1
			targetPart.Size = Vector3.new(0.1, 0.1, 0.1)
			targetPart.Position = targetRoot.Position
			targetPart.Parent = workspace

			local startAttachment = Instance.new("Attachment")
			startAttachment.Name = "PlayerLineStart"
			startAttachment.Parent = rootPart

			local endAttachment = Instance.new("Attachment")
			endAttachment.Name = "PlayerLineEnd"
			endAttachment.Parent = targetPart

			local beam = Instance.new("Beam")
			beam.Name = "PlayerLineBeam"
			beam.Attachment0 = startAttachment
			beam.Attachment1 = endAttachment
			beam.Width0 = 0.35
			beam.Width1 = 0.35
			beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
			beam.Transparency = NumberSequence.new(0)
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.Segments = 1
			beam.Parent = targetPart

			table.insert(playerBeams, beam)
			table.insert(playerTargetParts, {
				part = targetPart,
				player = other
			})
		end
	end

	currentPlayerName = targetName
end

local function updatePlayerLine()
	local name = featurePlayerInput.Text:match("^%s*(.-)%s*$")

	if name == "" then
		currentPlayerName = nil
		clearPlayerLines()
		return
	end

	currentPlayerName = name

	if playerLineEnabled then
		createPlayerLines(name)
	else
		clearPlayerLines()
	end
end

local function updatePlayerLineButton()
	if playerLineEnabled then
		playerLineToggle.Text = "ON"
		playerLineToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		playerLineToggle.Text = "OFF"
		playerLineToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

playerLineToggle.Activated:Connect(function()
	playerLineEnabled = not playerLineEnabled
	updatePlayerLineButton()

	if playerLineEnabled then
		updatePlayerLine()
	else
		clearPlayerLines()
	end
end)

featurePlayerInput.FocusLost:Connect(function()
	updatePlayerLine()
end)

featurePlayerInput:GetPropertyChangedSignal("Text"):Connect(function()
	if playerLineEnabled then
		updatePlayerLine()
	else
		clearPlayerLines()
	end
end)

Players.PlayerRemoving:Connect(function(other)
	if playerLineEnabled and currentPlayerName then
		createPlayerLines(currentPlayerName)
	end
end)

Players.PlayerAdded:Connect(function()
	if playerLineEnabled and currentPlayerName then
		task.defer(createPlayerLines, currentPlayerName)
	end
end)

player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.2)

	if playerLineEnabled and currentPlayerName then
		createPlayerLines(currentPlayerName)
	end
end)

task.spawn(function()
	while featurePlayerInput and featurePlayerInput.Parent do
		task.wait(0.1)

		if playerLineEnabled and currentPlayerName then
			local needsRefresh = false

			for _, data in ipairs(playerTargetParts) do
				local other = data.player
				local targetRoot = getPlayerRoot(other)

				if not targetRoot or not data.part or not data.part.Parent then
					needsRefresh = true
					break
				end

				data.part.Position = targetRoot.Position
			end

			if needsRefresh then
				createPlayerLines(currentPlayerName)
			elseif #playerTargetParts == 0 then
				createPlayerLines(currentPlayerName)
			end
		end
	end

	clearPlayerLines()
end)

updatePlayerLineButton()

local function updateObjectLineButton()
	if objectLineEnabled then
		objectLineToggle.Text = "ON"
		objectLineToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		objectLineToggle.Text = "OFF"
		objectLineToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

objectLineToggle.Activated:Connect(function()
	objectLineEnabled = not objectLineEnabled
	updateObjectLineButton()

	if objectLineEnabled then
		updateObjectLine()
	else
		clearObjectLines()
	end
end)

objectInput.FocusLost:Connect(function()
	updateObjectLine()
end)

objectInput:GetPropertyChangedSignal("Text"):Connect(function()
	if objectLineEnabled then
		updateObjectLine()
	else
		-- Saat OFF, jangan membuat line baru.
		clearObjectLines()
	end
end)

player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.2)

	if objectLineEnabled and currentTargetType and currentTargetName then
		createObjectLines(currentTargetType, currentTargetName)
	end
end)

task.spawn(function()
	while objectInput and objectInput.Parent do
		task.wait(0.1)

		if objectLineEnabled then
			local needsRefresh = false

			for _, data in ipairs(objectTargetParts) do
				local target = data.target
				local targetPart = data.part

				if not target or not target.Parent or not targetPart or not targetPart.Parent then
					needsRefresh = true
					break
				end

				local position = getObjectPosition(target)
				if position then
					targetPart.Position = position
				end
			end

			if needsRefresh and currentTargetType and currentTargetName then
				createObjectLines(currentTargetType, currentTargetName)
			elseif currentTargetType and currentTargetName and #objectTargetParts == 0 then
				createObjectLines(currentTargetType, currentTargetName)
			end
		end
	end

	clearObjectLines()
end)

updateObjectLineButton()
