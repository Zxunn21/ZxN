-- Drag helper
local function makeDraggable(object)
	local dragging = false
	local dragStart
	local startPosition

	object.InputBegan:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1
			or inputObject.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = inputObject.Position
			startPosition = object.Position
		end
	end)

	object.InputChanged:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseMovement
			or inputObject.UserInputType == Enum.UserInputType.Touch then

			if dragging then
				local delta = inputObject.Position - dragStart

				object.Position = UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1
			or inputObject.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)
end

makeDraggable(title)
makeDraggable(serverButton)
makeDraggable(trigger)

-- Billboard
local function createBillboard()
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EggESP"
	billboard.Size = UDim2.fromOffset(220, 45)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = math.huge
	billboard.Enabled = false
	billboard.Parent = gui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextSize = 18
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	return billboard, label
end

local function makeESP(eggBase)
	if espList[eggBase] then
		return
	end

	local billboard, label = createBillboard()

	espList[eggBase] = {
		Billboard = billboard,
		Label = label
	}
end

local function makeModelESP(model)
	if espList[model] then
		return
	end

	local billboard, label = createBillboard()

	espList[model] = {
		Billboard = billboard,
		Label = label
	}
end

function updateESP()
	findRenderedEggs()
	if not renderedEggs or not renderedEggs.Parent then
		return
	end

	for _, model in ipairs(renderedEggs:GetChildren()) do
		if not model:IsA("Model") then
			continue
		end

		if model.Name == "Cherub Egg" then
			makeModelESP(model)

			local data = espList[model]

			local part = model.PrimaryPart
				or model:FindFirstChildWhichIsA("BasePart", true)

			if part then
				data.Billboard.Adornee = part
				data.Billboard.StudsOffset = Vector3.new(
					0,
					part.Size.Y / 2 + 2,
					0
				)

				data.Label.Text = "Cherub Egg"
				data.Billboard.Enabled = enabled
			end
		else
			local eggBase = model:FindFirstChild("EggBase", true)

			if eggBase and eggBase:IsA("BasePart") then
				makeESP(eggBase)

				local data = espList[eggBase]
				local size = eggBase.Size
				local eggName = model.Name
				local specialEgg = specialEggs[eggName] == true

				data.Billboard.Adornee = eggBase
				data.Billboard.StudsOffset = Vector3.new(
					0,
					size.Y / 2 + 2,
					0
				)

				data.Label.Text = string.format(
					"%.2f (%s)",
					size.X,
					eggName
				)

				data.Billboard.Enabled =
					enabled and (specialEgg or size.X >= minSize)
			end
		end
	end
end

