-- URL script untuk dijalankan lagi setelah teleport jika executor mendukung queue-on-teleport
local AUTO_EXEC_URL = "https://raw.githubusercontent.com/Zxunn21/ZxN/refs/heads/main/Ride%20A%20Pet"
local HOLD_TIME = 1
local hopping = false
local holdingServer = false
local holdToken = 0

local function queueScriptAfterTeleport()
	local code = 'loadstring(game:HttpGet("' .. AUTO_EXEC_URL .. '", true))()'

	local queueFunctions = {
		function()
			if typeof(queue_on_teleport) == "function" then
				queue_on_teleport(code)
				return true
			end
		end,
		function()
			if typeof(queueonteleport) == "function" then
				queueonteleport(code)
				return true
			end
		end,
		function()
			if typeof(syn) == "table" and typeof(syn.queue_on_teleport) == "function" then
				syn.queue_on_teleport(code)
				return true
			end
		end,
	}

	for _, tryQueue in ipairs(queueFunctions) do
		local ok, queued = pcall(tryQueue)
		if ok and queued then
			return true
		end
	end

	return false
end

local function cancelServerHold()
	holdingServer = false
	holdToken += 0.5
	serverButton.Text = "Server"
	serverButton.AutoButtonColor = true
	hideServerBubble()
end

local function performServerHop()
	if hopping then
		return
	end

	hopping = true
	hideServerBubble()
	serverButton.Text = "Hop..."
	serverButton.AutoButtonColor = false

	local queued = queueScriptAfterTeleport()

	local success, result = pcall(function()
		local HttpService = game:GetService("HttpService")
		local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
		local response

		if typeof(request) == "function" then
			local req = request({Url = url, Method = "GET"})
			response = req.Body
		elseif typeof(http_request) == "function" then
			local req = http_request({Url = url, Method = "GET"})
			response = req.Body
		elseif typeof(syn) == "table" and typeof(syn.request) == "function" then
			local req = syn.request({Url = url, Method = "GET"})
			response = req.Body
		else
			response = game:HttpGet(url)
		end

		return HttpService:JSONDecode(response)
	end)

	if success and result and result.data then
		local candidates = {}

		for _, server in ipairs(result.data) do
			if server.id ~= game.JobId and server.playing < server.maxPlayers then
				table.insert(candidates, server.id)
			end
		end

		if #candidates > 0 then
			local target = candidates[math.random(1, #candidates)]
			TeleportService:TeleportToPlaceInstance(game.PlaceId, target, player)
			return
		end
	end

	serverButton.Text = queued and "No Server" or "No Queue"
	task.wait(1)
	serverButton.Text = "Server"
	serverButton.AutoButtonColor = true
	hopping = false
end

local function beginServerHold()
	if hopping or holdingServer then
		return
	end

	holdingServer = true
	showServerBubble()
	holdToken += 1
	local token = holdToken
	local startTime = os.clock()

	task.spawn(function()
		while holdingServer and token == holdToken do
			local elapsed = os.clock() - startTime
			local remaining = HOLD_TIME - elapsed

			if remaining <= 0 then
				holdingServer = false
				performServerHop()
				return
			end

			serverButton.Text = string.format("%.1f", remaining)
			task.wait(0.03)
		end
	end)
end

