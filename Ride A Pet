local mainFrameDragging = false
local mainFrameDragStart
local mainFrameStartPosition
local mainFrameDragInputConnection

local function beginMainFrameDrag(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	mainFrameDragging = true
	mainFrameDragStart = input.Position
	mainFrameStartPosition = menuFrame.Position
end

local function updateMainFrameDrag(input)
	if not mainFrameDragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - mainFrameDragStart
	menuFrame.Position = UDim2.new(
		mainFrameStartPosition.X.Scale,
		mainFrameStartPosition.X.Offset + delta.X,
		mainFrameStartPosition.Y.Scale,
		mainFrameStartPosition.Y.Offset + delta.Y
	)
end

dragArea.InputBegan:Connect(beginMainFrameDrag)
dragArea.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		mainFrameDragInputConnection = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == mainFrameDragInputConnection then
		updateMainFrameDrag(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		mainFrameDragging = false
	end
end)

