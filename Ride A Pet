local function applyJumpSettings()
	local btn = jumpButton or findJumpButton()
	if btn then
		jumpButton = btn
	else
		return
	end
	local scale = getAttr("JumpSize", 100) / 100
	local s = math.floor(JUMP_BASE_SIZE * scale)
	btn.Size = UDim2.new(0, s, 0, s)
	btn.Position = UDim2.new(1, JUMP_BASE_OFFSET.X + getAttr("JumpPosX", 0), 1, JUMP_BASE_OFFSET.Y + getAttr("JumpPosY", 0))
end

local function applyShiftSize()
	local scale = getAttr("ShiftSize", 100) / 100
	local s = math.floor(SHIFT_BASE_SIZE * scale)
	shiftButton.Size = UDim2.new(0, s, 0, s)
end

local function applyShiftSettings()
	applyShiftSize()
	local savedX = player:GetAttribute("ShiftX")
	local savedY = player:GetAttribute("ShiftY")
	if savedX == nil or savedY == nil then
		shiftButton.Position = UDim2.new(0.9, 0, 0.5, 0)
		return
	end
	local vw, vh = getViewport()
	if vw <= 0 or vh <= 0 then
		return
	end
	local s = shiftButton.AbsoluteSize.X
	local x = math.clamp(savedX, 4, math.max(4, vw - s - 4))
	local y = math.clamp(savedY, 60, math.max(60, vh - s - 4))
	shiftButton.Position = UDim2.new(0, x, 0, y)
end

