local function getBundledItems(bundleId)
    local success, bundle = pcall(function() return AssetService:GetBundleDetailsAsync(bundleId) end)
    if not success or not bundle then return nil end
    local bundledItems = {}
    for _, item in ipairs(bundle.Items or {}) do
        if item.Type == "Asset" and item.Id then table.insert(bundledItems, item.Id) end
    end
    return bundledItems, bundle
end

local function resolveAnimationMappings(assetIds)
    local mappings = {}
    for _, assetId in ipairs(assetIds) do
        local success, objects = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
        if success and objects then
            local function searchTree(parent, parentPath)
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("Animation") then
                        local pathParts = (parentPath .. "." .. child.Name):split(".")
                        local weightVals = {}
                        for _, wChild in ipairs(child:GetChildren()) do
                            if wChild:IsA("NumberValue") and wChild.Name == "Weight" then table.insert(weightVals, wChild.Value) end
                        end
                        local category = pathParts[#pathParts - 1]
                        if category then table.insert(mappings, {category = category, name = pathParts[#pathParts], animationId = child.AnimationId, weights = weightVals}) end
                    elseif #child:GetChildren() > 0 then
                        searchTree(child, parentPath .. "." .. child.Name)
                    end
                end
            end
            for _, obj in ipairs(objects) do searchTree(obj, obj.Name) obj:Destroy() end
        end
    end
    return mappings
end

local function findCategory(animate, categoryName)
    local exact = animate:FindFirstChild(categoryName)
    if exact then return exact end
    for _, child in ipairs(animate:GetChildren()) do
        if child.Name:lower() == categoryName:lower() then return child end
    end
end

local function applyAnimationToObject(animObj, animId, weights)
    if not animObj or not animObj:IsA("Animation") then return end
    animObj.AnimationId = animId
    if weights ~= nil then
        for _, child in ipairs(animObj:GetChildren()) do
            if child:IsA("NumberValue") and child.Name == "Weight" then child:Destroy() end
        end
        for _, value in ipairs(weights) do
            local weight = Instance.new("NumberValue")
            weight.Name = "Weight"
            weight.Value = value
            weight.Parent = animObj
        end
    end
end

local function restartAnimate(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local animate = character:FindFirstChild("Animate")
    if humanoid then
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end
    end
    if animate then
        animate.Disabled = true
        task.wait()
        animate.Disabled = false
    end
end

local function applyBundle(bundleId)
    local Character = Player.Character or Player.CharacterAdded:Wait()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Animate = Character:FindFirstChild("Animate")
    if not Humanoid or not Animate then error("Humanoid atau Animate tidak ditemukan") end
    if not DefaultAnimations then DefaultAnimations = captureAnimations(Animate) end
    local assetIds, bundle = getBundledItems(bundleId)
    if not assetIds or #assetIds == 0 then error("Bundle tidak memiliki asset") end
    local mappings = resolveAnimationMappings(assetIds)
    if #mappings == 0 then error("Animation mapping tidak ditemukan") end
    for _, track in ipairs(Humanoid:GetPlayingAnimationTracks()) do track:Stop() end
    local mappingMap = {}
    for _, mapping in ipairs(mappings) do
        local category = mapping.category:lower()
        mappingMap[category] = mappingMap[category] or {folderName = mapping.category, items = {}}
        mappingMap[category].items[mapping.name:lower()] = mapping
    end
    local changed = 0
    for _, data in pairs(mappingMap) do
        local categoryFolder = findCategory(Animate, data.folderName)
        if categoryFolder then
            local sourceByName = {}
            for name, mapping in pairs(data.items) do sourceByName[name] = mapping end
            for _, animObj in ipairs(categoryFolder:GetChildren()) do
                if animObj:IsA("Animation") then
                    local mapping = sourceByName[animObj.Name:lower()]
                    if mapping then
                        sourceByName[animObj.Name:lower()] = nil
                        applyAnimationToObject(animObj, mapping.animationId, mapping.weights)
                        animObj.Name = mapping.name
                        changed += 1
                    else
                        animObj:Destroy()
                    end
                end
            end
            for _, mapping in pairs(sourceByName) do
                local animObj = Instance.new("Animation")
                animObj.Name = mapping.name
                applyAnimationToObject(animObj, mapping.animationId, mapping.weights)
                animObj.Parent = categoryFolder
                changed += 1
            end
        end
    end
    if changed == 0 then error("Tidak ada kategori Animate yang cocok") end
    if Humanoid.MoveDirection.Magnitude == 0 then restartAnimate(Character) end
    return bundle and bundle.Name or tostring(bundleId)
end

