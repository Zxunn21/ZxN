local BubbleFrame = nil

local function hideBubble()
    if BubbleFrame and BubbleFrame.Parent then
        BubbleFrame.Visible = false
    end
end

local function showBubble()
    if not BubbleFrame then
        BubbleFrame = Instance.new("Frame")
        BubbleFrame.Name = "TriggerBubble"
        BubbleFrame.Size = UDim2.fromOffset(130, 44)
        BubbleFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
        BubbleFrame.BackgroundTransparency = 0.05
        BubbleFrame.BorderSizePixel = 0
        BubbleFrame.ZIndex = 100
        BubbleFrame.Visible = false
        BubbleFrame.Parent = ScreenGui
        Instance.new("UICorner", BubbleFrame).CornerRadius = UDim.new(0, 8)

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Color = Color3.fromRGB(120, 120, 120)
        stroke.Parent = BubbleFrame

        local hideGuiButton = Instance.new("TextButton")
        hideGuiButton.Size = UDim2.new(1, -12, 1, -12)
        hideGuiButton.Position = UDim2.fromOffset(6, 6)
        hideGuiButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        hideGuiButton.BorderSizePixel = 0
        hideGuiButton.Text = "Hide Gui"
        hideGuiButton.TextColor3 = Color3.new(1, 1, 1)
        hideGuiButton.TextSize = 13
        hideGuiButton.Font = Enum.Font.GothamBold
        hideGuiButton.ZIndex = 101
        hideGuiButton.Parent = BubbleFrame
        Instance.new("UICorner", hideGuiButton).CornerRadius = UDim.new(0, 6)

        hideGuiButton.Activated:Connect(function()
            hideBubble()
            Frame.Visible = false
            FavoriteFrame.Visible = false
            Trigger.Visible = false
            ScreenGui.Enabled = false
        end)
    end

    local triggerPosition = Trigger.Position
    BubbleFrame.Position = UDim2.new(
        triggerPosition.X.Scale, triggerPosition.X.Offset,
        triggerPosition.Y.Scale, triggerPosition.Y.Offset - 50
    )
    BubbleFrame.Visible = true
end

local triggerPressing = false
local triggerDragging = false
local triggerLongPressFired = false
local triggerDragStart = Vector2.new(0, 0)
local triggerStartPos = UDim2.new(0, 0, 0, 0)
local longPressThread = nil

Minimize.MouseButton1Click:Connect(function()
    Trigger.Position = Frame.Position
    Frame.Visible = false
    FavoriteFrame.Visible = false
    Trigger.Visible = true
end)

Trigger.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        triggerPressing = true
        triggerDragging = false
        triggerLongPressFired = false
        triggerDragStart = input.Position
        triggerStartPos = Trigger.Position
        hideBubble()
        longPressThread = task.delay(0.5, function()
            if triggerPressing and not triggerDragging then
                triggerLongPressFired = true
                showBubble()
            end
        end)
    end
end)

Trigger.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and triggerPressing then
        local delta = input.Position - triggerDragStart
        local moveDistance = math.sqrt(delta.X ^ 2 + delta.Y ^ 2)
        if moveDistance > 5 then
            triggerDragging = true
            hideBubble()
            if longPressThread then
                task.cancel(longPressThread)
                longPressThread = nil
            end
            Trigger.Position = UDim2.new(
                triggerStartPos.X.Scale, triggerStartPos.X.Offset + delta.X,
                triggerStartPos.Y.Scale, triggerStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if triggerPressing then
            if longPressThread then
                task.cancel(longPressThread)
                longPressThread = nil
            end
            if not triggerDragging and not triggerLongPressFired then
                Frame.Visible = true
                Trigger.Visible = false
                hideBubble()
            end
            triggerPressing = false
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if BubbleFrame and BubbleFrame.Visible and not triggerPressing then
            hideBubble()
        end
    end
end)

local function initializeCharacter(character)
    local animate = character:WaitForChild("Animate", 10)
    if not animate then return end
    DefaultAnimations = captureAnimations(animate)
    if FavoriteData.active then
        task.defer(function()
            task.wait(1)
            local success, err = pcall(function() applyBundle(FavoriteData.active) end)
            if not success then warn(err) end
        end)
    end
end

if Player.Character then task.defer(initializeCharacter, Player.Character) end
Player.CharacterAdded:Connect(function(character)
    task.wait(1)
    initializeCharacter(character)
end)
