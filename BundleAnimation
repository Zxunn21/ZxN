local function normalizeFavorites()
    FavoriteData.favorites = FavoriteData.favorites or {}
    if FavoriteData.active then
        for i, data in ipairs(FavoriteData.favorites) do
            if tostring(data.id) == tostring(FavoriteData.active) then
                if i ~= 1 then
                    table.remove(FavoriteData.favorites, i)
                    table.insert(FavoriteData.favorites, 1, data)
                end
                break
            end
        end
    end
end

local function loadFavorites()
    if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(FavoriteFile) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(FavoriteFile))
        end)
        if success and type(data) == "table" then
            if data.favorites then
                FavoriteData = data
            else
                FavoriteData = {favorites = data, active = nil}
            end
        end
    end
    normalizeFavorites()
end

local function saveFavorites()
    normalizeFavorites()
    if typeof(writefile) == "function" then
        pcall(function()
            writefile(FavoriteFile, HttpService:JSONEncode(FavoriteData))
        end)
    end
end

local function getFavoriteIndex(bundleId)
    for i, data in ipairs(FavoriteData.favorites) do
        if tostring(data.id) == tostring(bundleId) then
            return i, data
        end
    end
end

local function isFavorite(bundleId)
    return getFavoriteIndex(bundleId) ~= nil
end

local function addFavorite(bundleId, name)
    if not isFavorite(bundleId) then
        table.insert(FavoriteData.favorites, {id = bundleId, name = name or tostring(bundleId)})
    end
    saveFavorites()
end

local function removeFavorite(bundleId)
    local index = getFavoriteIndex(bundleId)
    if index then
        table.remove(FavoriteData.favorites, index)
    end
    if tostring(FavoriteData.active) == tostring(bundleId) then
        FavoriteData.active = nil
    end
    saveFavorites()
end

local function setDefaultFavorite(bundleId)
    local index, data = getFavoriteIndex(bundleId)
    if not index then return end
    FavoriteData.active = bundleId
    if index ~= 1 then
        table.remove(FavoriteData.favorites, index)
        table.insert(FavoriteData.favorites, 1, data)
    end
    saveFavorites()
end

local function moveFavorite(index, direction)
    local target = index + direction
    if index < 1 or index > #FavoriteData.favorites then return end
    if target < 1 or target > #FavoriteData.favorites then return end
    if FavoriteData.active and tostring(FavoriteData.favorites[index].id) == tostring(FavoriteData.active) then return end
    if FavoriteData.active and tostring(FavoriteData.favorites[target].id) == tostring(FavoriteData.active) then return end
    FavoriteData.favorites[index], FavoriteData.favorites[target] = FavoriteData.favorites[target], FavoriteData.favorites[index]
    saveFavorites()
end

local function captureAnimations(animate)
    local data = {}
    for _, category in ipairs(animate:GetChildren()) do
        local items = {}
        for _, anim in ipairs(category:GetChildren()) do
            if anim:IsA("Animation") then
                local weights = {}
                for _, child in ipairs(anim:GetChildren()) do
                    if child:IsA("NumberValue") and child.Name == "Weight" then
                        table.insert(weights, child.Value)
                    end
                end
                table.insert(items, {name = anim.Name, animationId = anim.AnimationId, weights = weights})
            end
        end
        if #items > 0 then
            data[category.Name] = items
        end
    end
    return data
end

local function restoreAnimations(animate, data)
    for categoryName, items in pairs(data) do
        local category = animate:FindFirstChild(categoryName)
        if category then
            for _, child in ipairs(category:GetChildren()) do
                if child:IsA("Animation") then
                    child:Destroy()
                end
            end
            for _, item in ipairs(items) do
                local anim = Instance.new("Animation")
                anim.Name = item.name
                anim.AnimationId = item.animationId
                for _, value in ipairs(item.weights or {}) do
                    local weight = Instance.new("NumberValue")
                    weight.Name = "Weight"
                    weight.Value = value
                    weight.Parent = anim
                end
                anim.Parent = category
            end
        end
    end
end

