-- Build hierarchy path from object to root
local function getIconForInstance(obj)
	if obj:IsA("Workspace") or obj == game:GetService("Workspace") then
		return "🌐"
	elseif obj:IsA("Folder") then
		return "📂"
	elseif obj:IsA("Model") then
		return "📦"
	elseif obj:IsA("BasePart") then
		return "🧱"
	else
		return "📄"
	end
end

local function buildPath(obj)
	local path = {}
	local current = obj
	while current and current ~= game do
		table.insert(path, 1, current)
		current = current.Parent
	end
	return path
end

local function showPathFrame(obj)
	-- Clear old buttons
	for _, child in ipairs(pathScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local path = buildPath(obj)

	for i, instance in ipairs(path) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -4, 0, 36)
		btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		btn.BorderSizePixel = 0
		btn.Text = getIconForInstance(instance) .. " " .. instance.Name
		btn.TextColor3 = Color3.new(1, 1, 1)
		btn.TextSize = 14
		btn.Font = Enum.Font.GothamBold
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.LayoutOrder = i
		btn.ZIndex = 602
		btn.Parent = pathScroll

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 7)
		btnCorner.Parent = btn

		local btnPadding = Instance.new("UIPadding")
		btnPadding.PaddingLeft = UDim.new(0, 10)
		btnPadding.Parent = btn

		btn.Activated:Connect(function()
			showConfirm(instance)
		end)
	end

	pathFrame.Visible = true
end

