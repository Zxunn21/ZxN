-- === TOGGLE ===
local function updateToggleButton()
	if clickEnabled then
		toggleButton.Text = "ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		toggleButton.Text = "OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

toggleButton.Activated:Connect(function()
	clickEnabled = not clickEnabled
	updateToggleButton()
	if not clickEnabled then
		clearHighlight()
	end
end)

-- === HIGHLIGHT ===
local function clearHighlight()
	if currentHighlight and currentHighlight.Parent then
		currentHighlight:Destroy()
	end
	currentHighlight = nil
end

local function highlightObject(obj)
	clearHighlight()

	if not obj or not obj.Parent then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ClickHighlight"
	highlight.FillColor = Color3.fromRGB(255, 200, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = obj

	currentHighlight = highlight
end

