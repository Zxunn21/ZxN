local function parseObjectInput()
	local input = objectInput.Text:match("^%s*(.-)%s*$")

	if input == "" then
		return nil
	end

	-- Support multi input dipisah koma, contoh: "m snail, m tiger, p block"
	-- Format tiap entri: <tipe> <nama>
	-- tipe: p = part, m = model, f = model in folder
	local targetList = {}
	local validCount = 0

	for chunk in input:gmatch("[^,]+") do
		local firstToken, rest = chunk:match("^%s*(%S+)%s+(.-)%s*$")
		if firstToken then
			local entryType = string.lower(firstToken)
			local mainName = rest

			if (entryType == "p" or entryType == "m" or entryType == "f") and mainName ~= "" then
				validCount += 1
				targetList[validCount] = {
					type = string.upper(entryType),
					name = mainName,
				}
			end
		end
	end

