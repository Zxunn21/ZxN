-- Drag + click/long-press detection untuk trigger button
local triggerPressing = false
local triggerDragging = false
local triggerLongPressFired = false
local triggerDragStart = Vector2.new(0, 0)
local triggerStartPos = UDim2.new(0, 0, 0, 0)
local longPressThread = nil

triggerBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		triggerPressing = true
		triggerDragging = false
		triggerLongPressFired = false
		triggerDragStart = input.Position
		triggerStartPos = triggerBtn.Position
		hideBubble()

		-- Timer long-press (0.5 detik)
		longPressThread = task.delay(0.5, function()
			if triggerPressing and not triggerDragging then
				triggerLongPressFired = true
				showBubble()
			end
		end)
	end
end)

triggerBtn.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		if triggerPressing then
			local delta = input.Position - triggerDragStart
			local moveDist = math.sqrt(delta.X ^ 2 + delta.Y ^ 2)

			if moveDist > 5 then
				triggerDragging = true

				-- Batalkan timer long-press
				if longPressThread then
					task.cancel(longPressThread)
					longPressThread = nil
				end

				-- Update posisi (drag)
				triggerBtn.Position = UDim2.new(
					triggerStartPos.X.Scale,
					triggerStartPos.X.Offset + delta.X,
					triggerStartPos.Y.Scale,
					triggerStartPos.Y.Offset + delta.Y
				)
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		if triggerPressing then
			-- Batalkan timer long-press
			if longPressThread then
				task.cancel(longPressThread)
				longPressThread = nil
			end

			if not triggerDragging and not triggerLongPressFired then
				-- Klik singkat: toggle mainFrame
				mainFrame.Visible = not mainFrame.Visible
			end

			triggerPressing = false
		end
	end
end)

-- Tutup bubble saat klik di luar bubble (bukan di trigger button)
-- gameProcessed = true berarti klik mengenai elemen GUI (mis. tombol Hide Gui di
-- dalam bubble), jadi skip agar tidak menutup bubble sebelum tombol di dalamnya
-- sempat memproses event Activated.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		if bubbleFrame and bubbleFrame.Visible and not triggerPressing then
			hideBubble()
		end
	end
end)

