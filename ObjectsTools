local function getObjectPosition(object)
	if not object or not object.Parent then
		return nil
	end

	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		return object:GetPivot().Position
	end

	return nil
end

local function clearObjectLines()
	for _, beam in ipairs(objectBeams) do
		if beam and beam.Parent then
			beam:Destroy()
		end
	end
	table.clear(objectBeams)

	for _, data in ipairs(objectTargetParts) do
		if data.part and data.part.Parent then
			data.part:Destroy()
		end
	end
	table.clear(objectTargetParts)

	for _, attachment in ipairs(objectStartAttachments) do
		if attachment and attachment.Parent then
			attachment:Destroy()
		end
	end
	table.clear(objectStartAttachments)

	for _, highlight in ipairs(objectHighlights) do
		if highlight and highlight.Parent then highlight:Destroy() end
	end
	table.clear(objectHighlights)

	for _, billboard in ipairs(objectBillboards) do
		if billboard and billboard.Parent then billboard:Destroy() end
	end
	table.clear(objectBillboards)
end

local function findObjects(targetType, targetName)
	local results = {}

	if not targetType or not targetName then
		return results
	end

	targetName = targetName:match("^%s*(.-)%s*$")
	if targetName == "" then
		return results
	end

	local wanted = string.lower(targetName)

	for _, obj in ipairs(workspace:GetDescendants()) do
		local typeMatches =
			(targetType == "P" and obj:IsA("BasePart"))
			or (targetType == "M" and obj:IsA("Model"))

		if typeMatches and string.find(string.lower(obj.Name), wanted, 1, true) then
			table.insert(results, obj)
		end
	end

	return results
end

-- Cek apakah part berada langsung dalam struktur container (bukan di dalam Model)
-- Dipakai agar part loose di dalam folder (kedalaman berapa pun) masuk list,
-- tapi part internal model (mis. Handle) tidak ikut
local function isLoosePart(part, container)
	if not part:IsA("BasePart") then return false end

	local current = part.Parent
	while current and current ~= container do
		if current:IsA("Model") then
			return false
		end
		current = current.Parent
	end

	return current == container
end

-- Ambil kandidat objek dari satu entri input
-- Tipe entri: "P" = part, "M" = model, "MIF" = model in folder
-- entry.exclude (opsional) = nama model yang dikecualikan (Exc)
local function getEntryTargets(entry)
	local candidates = {}

	if entry.type == "F" then
		-- Model In Folder: semua model di dalam folder yang namanya cocok
		local wanted = string.lower(entry.name)

		for _, obj in ipairs(workspace:GetDescendants()) do
			local isContainer = obj:IsA("Folder") or obj:IsA("Model")
			if isContainer and string.find(string.lower(obj.Name), wanted, 1, true) then
				for _, descendant in ipairs(obj:GetDescendants()) do
					if descendant:IsA("Model")
						or (descendant:IsA("BasePart") and isLoosePart(descendant, obj)) then
						table.insert(candidates, descendant)
					end
				end
			end
		end
	else
		candidates = findObjects(entry.type, entry.name)
	end

	-- Filter list exclusions (dari tombol List UI)
	if next(listExclusions) then
		local filtered2 = {}
		for _, obj in ipairs(candidates) do
			if not listExclusions[string.lower(obj.Name)] then
				table.insert(filtered2, obj)
			end
		end
		candidates = filtered2
	end

	return candidates
end

-- Kumpulkan semua objek yang cocok dari seluruh entri input (multi target)
local function collectAllTargets(targetList)
	local targets = {}
	local seen = {}

	for _, entry in ipairs(targetList or {}) do
		for _, obj in ipairs(getEntryTargets(entry)) do
			if not seen[obj] then
				seen[obj] = true
				table.insert(targets, obj)
			end
		end
	end

	return targets
end

