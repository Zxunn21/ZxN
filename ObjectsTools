local function getUniquePromptGroups()
	local groupsByKey = {}
	local groups = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local objectName, action, promptName = getPromptListValues(obj)
			local key = action .. "\31" .. promptName
			local group = groupsByKey[key]
			if not group then
				group = {
					key = key,
					objectName = objectName,
					action = action,
					promptName = promptName,
					prompts = {},
				}
				groupsByKey[key] = group
				table.insert(groups, group)
			end
			table.insert(group.prompts, obj)
		end
	end
	table.sort(groups, function(a, b)
		local ao, bo = a.objectName:lower(), b.objectName:lower()
		if ao == bo then
			local aa, ba = a.action:lower(), b.action:lower()
			if aa == ba then return a.promptName:lower() < b.promptName:lower() end
			return aa < ba
		end
		return ao < bo
	end)
	return groups
end
