local triggerPressing = false
local triggerDragging = false
local triggerLongPressFired = false
local triggerDragStart = Vector2.new(0, 0)
local triggerStartPos = UDim2.new(0, 0, 0, 0)
local longPressThread = nil
triggerBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		triggerPressing = true
		triggerDragging = false
		triggerLongPressFired = false
		triggerDragStart = input.Position
		triggerStartPos = triggerBtn.Position
		hideBubble()
		longPressThread = task.delay(0.5, function()
			if triggerPressing and not triggerDragging then
				triggerLongPressFired = true
				showBubble()
			end
		end)
	end
end)
triggerBtn.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		if triggerPressing then
			local delta = input.Position - triggerDragStart
			local moveDist = math.sqrt(delta.X ^ 2 + delta.Y ^ 2)
			if moveDist > 5 then
				triggerDragging = true
				if longPressThread then
					task.cancel(longPressThread)
					longPressThread = nil
				end
				triggerBtn.Position = UDim2.new(
					triggerStartPos.X.Scale,
					triggerStartPos.X.Offset + delta.X,
					triggerStartPos.Y.Scale,
					triggerStartPos.Y.Offset + delta.Y
				)
			end
		end
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		if triggerPressing then
			if longPressThread then
				task.cancel(longPressThread)
				longPressThread = nil
			end
			if not triggerDragging and not triggerLongPressFired then
				mainFrame.Visible = not mainFrame.Visible
				triggerBtn.Visible = not mainFrame.Visible
			end
			triggerPressing = false
		end
	end
end)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
