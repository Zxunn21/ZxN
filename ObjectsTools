-- Deteksi part baru yang mendapatkan TouchInterest
workspace.DescendantAdded:Connect(function(descendant)
	if not touchInterestEnabled then return end
	if descendant:IsA("TouchInterest") then
		local part = descendant.Parent
		if part and part:IsA("BasePart") then
			addTouchInterestHighlight(part)
			local model = findModelFromPart(part)
			if model then
				if touchHighlightModelEnabled then
					addTouchInterestModelHighlight(model)
