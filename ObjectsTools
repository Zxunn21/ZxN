local function removeTouchInterestModelBillboard(model)
	local billboard = touchInterestModelBillboards[model]
	if billboard then
		billboard:Destroy()
	end
	touchInterestModelBillboards[model] = nil
end

local function clearTouchInterestModelBillboards()
	for model, billboard in pairs(touchInterestModelBillboards) do
		if billboard then
			billboard:Destroy()
		end
	end
	table.clear(touchInterestModelBillboards)
end

local function updateTouchInterestButtons()
	if touchModelEnabled then
		touchModelToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchModelToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if touchHighlightModelEnabled then
		touchHighlightToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchHighlightToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if touchInterestEnabled then
		touchInterestToggle.Text = "ON"
		touchInterestToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchInterestToggle.Text = "OFF"
		touchInterestToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

local function applyTouchInterestESP()
	if not touchInterestEnabled then return end

	-- Highlight individual parts
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if hasTouchInterest(descendant) then
			addTouchInterestHighlight(descendant)
		end
	end

	-- Highlight dan billboard untuk models
	local models = getModelsFromTouchInterest()
	for model in pairs(models) do
		if touchHighlightModelEnabled then
			addTouchInterestModelHighlight(model)
		end
		if touchModelEnabled then
			addTouchInterestModelBillboard(model)
		end
	end
end

local function setTouchInterestESP(state)
	touchInterestEnabled = state

	if state then
		applyTouchInterestESP()
	else
		clearTouchInterestHighlights()
		clearTouchInterestModelHighlights()
		clearTouchInterestModelBillboards()
	end

	updateTouchInterestButtons()
end

local function refreshTouchInterestESP()
	if not touchInterestEnabled then return end
	clearTouchInterestModelHighlights()
	clearTouchInterestModelBillboards()
	applyTouchInterestESP()
end

