		if existing.beam and existing.beam.Parent
			and existing.anchor and existing.anchor.Parent
			and existing.startAtt and existing.startAtt.Parent then
			existing.anchor.Position = part.Position
			return
		end
		touchInterestLines[part] = nil
	end

	local anchor = Instance.new("Part")
	anchor.Name = "TouchInterestLineAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.1, 0.1, 0.1)
	anchor.Position = part.Position
	anchor.Parent = workspace

	local startAtt = Instance.new("Attachment")
	startAtt.Name = "TouchInterestLineStart"
	startAtt.Parent = rootPart

	local endAtt = Instance.new("Attachment")
	endAtt.Name = "TouchInterestLineEnd"
	endAtt.Parent = anchor

	local beam = Instance.new("Beam")
	beam.Name = "TouchInterestLineBeam"
	beam.Attachment0 = startAtt
	beam.Attachment1 = endAtt
	beam.Width0 = 0.3
	beam.Width1 = 0.3
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 100, 255))
	beam.Transparency = NumberSequence.new(0)
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 1
	beam.Parent = anchor

	touchInterestLines[part] = {
		anchor = anchor,
		beam = beam,
		startAtt = startAtt,
		endAtt = endAtt,
	}
end

local function removeTouchInterestLine(part)
	local data = touchInterestLines[part]
	if data then
		if data.anchor and data.anchor.Parent then
			data.anchor:Destroy()
		end
		if data.startAtt and data.startAtt.Parent then
			data.startAtt:Destroy()
		end
		touchInterestLines[part] = nil
	end
end

local function clearTouchInterestLines()
	for part in pairs(touchInterestLines) do
		removeTouchInterestLine(part)
	end
	table.clear(touchInterestLines)
end

local function updateTouchInterestButtons()
	if touchNameEnabled then
		touchNameToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchNameToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if touchLineEnabled then
		touchLineToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchLineToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if touchHighlightEnabled then
		touchHighlightToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchHighlightToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if touchInterestEnabled then
		touchInterestToggle.Text = "ON"
		touchInterestToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		touchInterestToggle.Text = "OFF"
		touchInterestToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

local function applyTouchInterestESP()
	if not touchInterestEnabled then return end

	-- Highlight + billboard nama + line untuk BasePart dengan TouchInterest
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if hasTouchInterest(descendant) then
			if touchHighlightEnabled then
				addTouchInterestHighlight(descendant)
			else
				removeTouchInterestHighlight(descendant)
			end

			if touchNameEnabled then
				addTouchInterestBillboard(descendant)
			else
				removeTouchInterestBillboard(descendant)
			end

			if touchLineEnabled then
				addTouchInterestLine(descendant)
			else
				removeTouchInterestLine(descendant)
			end
		end
	end

	-- Cleanup: hapus ESP (highlight, billboard, line) dari part yang sudah tidak lolos hasTouchInterest
	-- (mis. transparency berubah menjadi 1, TouchInterest dihapus, atau part hilang dari workspace)
	for part in pairs(touchInterestHighlights) do
		if not hasTouchInterest(part) then
			removeTouchInterestHighlight(part)
		end
	end

	for part in pairs(touchInterestBillboards) do
		if not hasTouchInterest(part) then
			removeTouchInterestBillboard(part)
		end
	end

	for part in pairs(touchInterestLines) do
		if not hasTouchInterest(part) then
			removeTouchInterestLine(part)
		end
	end
end

local function setTouchInterestESP(state)
	touchInterestEnabled = state

	if state then
		applyTouchInterestESP()
	else
		clearTouchInterestHighlights()
		clearTouchInterestBillboards()
		clearTouchInterestLines()
	end

	updateTouchInterestButtons()
end

