	if dragDetectorBillboards[model] then
		local b = dragDetectorBillboards[model]
		if b and b.Parent then
			b.Adornee = model
			b.Enabled = true
			return
		end
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ObjekTools_DragDetectorESP"
	billboard.Adornee = model
	billboard.Size = UDim2.new(0, 200, 0, 50)
