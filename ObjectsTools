local function targetsChanged(newTargets)
	-- Bandingkan jumlah
	if #newTargets ~= #objectTargetParts then
		return true
	end

	-- Bandingkan isi (cek apakah ada target baru yang belum punya garis)
	local existing = {}
	for _, data in ipairs(objectTargetParts) do
		if data.target then
			existing[data.target] = true
		end
	end

	for _, t in ipairs(newTargets) do
		if not existing[t] then
			return true
		end
	end

	return false
end

task.spawn(function()
	local RESCAN_INTERVAL = 1 -- detik, interval pemindaian ulang part/model baru
	local lastRescan = os.clock()

	while objectInput and objectInput.Parent do
		task.wait(0.1)

		if objectLineEnabled and currentTargets then
			local needsRefresh = false

			-- Update posisi garis setiap 0.1s
			for _, data in ipairs(objectTargetParts) do
				local target = data.target
				local targetPart = data.part

				if not target or not target.Parent or not targetPart or not targetPart.Parent then
					needsRefresh = true
					break
				end

				local position = getObjectPosition(target)
				if position then
					targetPart.Position = position
				end
			end

			-- Pindai ulang otomatis: setiap RESCAN_INTERVAL, atau langsung jika ada target yang hilang
			if needsRefresh or (os.clock() - lastRescan) >= RESCAN_INTERVAL then
				lastRescan = os.clock()

				local freshTargets = collectAllTargets(currentTargets)
				if targetsChanged(freshTargets) then
					createObjectLines(currentTargets)
				end
			end
		end
	end

	clearObjectLines()
end)

updateObjectLineButton()

