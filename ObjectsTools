	if not dragDetectorEnabled then return end

	local models = getModelsFromDragDetectors()
	for model in pairs(models) do
		if dragHighlightEnabled then
			addDragDetectorHighlight(model)
		end
		if dragModelEnabled then
			addDragDetectorBillboard(model)
		end
	end
end

