local function getScanDistance()
	local text = objectDistanceInput.Text:match("^%s*(.-)%s*$")
	local num = tonumber(text)
	if num and num > 0 then
		return num
	end
	return nil
end
local function scanNearbyObjects()
	local results = {}
	local radius = getScanDistance()
	local rootPart = getRootPart()
	local character = player.Character
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj ~= character and not (character and obj:IsDescendantOf(character)) then
			local isCandidate = obj:IsA("Model")
				or (obj:IsA("BasePart") and isLoosePart(obj, workspace))
			if isCandidate then
				local position = getObjectPosition(obj)
				if position then
					local inRange = true
					if radius and rootPart then
						inRange = (position - rootPart.Position).Magnitude <= radius
					end
					if inRange then
						table.insert(results, obj)
					end
				end
			end
		end
	end
	return results
end
local function updateScanList()
	if not scanModeEnabled then
		return
	end
	local nearby = scanNearbyObjects()
	table.clear(scanNearbyNames)
	for _, obj in ipairs(nearby) do
		local lowerName = string.lower(obj.Name)
		scanNearbyNames[lowerName] = true
		if not modelHistory[lowerName] then
			modelHistory[lowerName] = {
				name = obj.Name,
				kind = obj:IsA("Model") and "M" or "P",
			}
		end
	end
	if listFrame and listFrame.Visible then
		refreshListFrame()
	end
end
