local function findModelFromDragDetector(dragDetector)
	local current = dragDetector.Parent
	while current do
		if current:IsA("Model") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function getModelsFromDragDetectors()
	local models = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("DragDetector") then
			local model = findModelFromDragDetector(descendant)
			if model then
				models[model] = true
			end
		end
	end
	return models
end

local function addDragDetectorHighlight(model)
	if dragDetectorHighlights[model] then
		local h = dragDetectorHighlights[model]
		if h and h.Parent then
			h.Adornee = model
			h.Enabled = true
			return
		end
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ObjekTools_DragDetectorHighlight"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(100, 150, 255)
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = screenGui
	dragDetectorHighlights[model] = highlight
end

