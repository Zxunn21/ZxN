				+ child.Size.Y.Scale * contentFrame.AbsoluteSize.Y + child.Size.Y.Offset
			bottom = math.max(bottom, childBottom)
		end
	end
	local oldY = contentFrame.CanvasSize.Y.Offset
	contentFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(oldY + 100, bottom + 20))
end
end
