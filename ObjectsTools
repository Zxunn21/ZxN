local function scanModelHistory(targetList)
	local changed = false
	for _, entry in ipairs(targetList or {}) do
		if entry.type == "P" or entry.type == "M" then
			-- Part/model hasil pencarian input p/m juga masuk list
			for _, obj in ipairs(findObjects(entry.type, entry.name)) do
				local lowerName = string.lower(obj.Name)
				if not modelHistory[lowerName] then
					modelHistory[lowerName] = { name = obj.Name, kind = entry.type }
					changed = true
				end
			end
		elseif entry.type == "F" then
			local wanted = string.lower(entry.name)
			for _, obj in ipairs(workspace:GetDescendants()) do
				local isContainer = obj:IsA("Folder") or obj:IsA("Model")
				if isContainer and string.find(string.lower(obj.Name), wanted, 1, true) then
					for _, descendant in ipairs(obj:GetDescendants()) do
						if descendant:IsA("Model")
							or (descendant:IsA("BasePart") and isLoosePart(descendant, obj)) then
							local lowerName = string.lower(descendant.Name)
							if not modelHistory[lowerName] then
								modelHistory[lowerName] = { name = descendant.Name, kind = descendant:IsA("Model") and "M" or "P" }
								changed = true
							end
						end
					end
				end
			end
		end
	end
	return changed
end

