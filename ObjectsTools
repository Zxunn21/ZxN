-- LOGIKA TOUCHINTEREST ESP
local touchInterestEnabled = false
local touchInterestHighlights = {}

local function hasTouchInterest(part)
	if not part or not part.Parent then return false end
	if not part:IsA("BasePart") then return false end
	return part:FindFirstChild("TouchInterest") ~= nil
end

local function addTouchInterestHighlight(part)
	if not hasTouchInterest(part) then return end
	if touchInterestHighlights[part] then
		local h = touchInterestHighlights[part]
		if h and h.Parent then
			h.Adornee = part
			h.Enabled = true
			return
		end
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ObjekTools_TouchInterestHighlight"
	highlight.Adornee = part
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(255, 100, 255)
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = screenGui
	touchInterestHighlights[part] = highlight
end

local function removeTouchInterestHighlight(part)
	local highlight = touchInterestHighlights[part]
	if highlight then
		highlight:Destroy()
	end
	touchInterestHighlights[part] = nil
end

local function clearTouchInterestHighlights()
	for part, highlight in pairs(touchInterestHighlights) do
		if highlight then
			highlight:Destroy()
		end
	end
	table.clear(touchInterestHighlights)
end

local function applyTouchInterestESP()
	if not touchInterestEnabled then return end

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if hasTouchInterest(descendant) then
			addTouchInterestHighlight(descendant)
		end
	end
end

local function setTouchInterestESP(state)
	touchInterestEnabled = state

	if state then
		touchInterestToggle.Text = "ON"
		touchInterestToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
		applyTouchInterestESP()
	else
		touchInterestToggle.Text = "OFF"
		touchInterestToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		clearTouchInterestHighlights()
	end
end

touchInterestToggle.Activated:Connect(function()
	setTouchInterestESP(not touchInterestEnabled)
end)

-- Deteksi part baru yang mendapatkan TouchInterest
workspace.DescendantAdded:Connect(function(descendant)
	if not touchInterestEnabled then return end
	if descendant:IsA("TouchInterest") then
		local part = descendant.Parent
		if part and part:IsA("BasePart") then
			addTouchInterestHighlight(part)
		end
	elseif hasTouchInterest(descendant) then
		addTouchInterestHighlight(descendant)
	end
end)

-- Deteksi part yang hilang atau TouchInterest dihapus
workspace.DescendantRemoving:Connect(function(descendant)
	if descendant:IsA("TouchInterest") then
		local part = descendant.Parent
		if part and touchInterestHighlights[part] then
			local highlight = touchInterestHighlights[part]
			if not part:FindFirstChild("TouchInterest") then
				removeTouchInterestHighlight(part)
			else
				if highlight then highlight.Enabled = false end
			end
		end
	elseif touchInterestHighlights[descendant] then
		removeTouchInterestHighlight(descendant)
	end
end)

-- Loop untuk refresh highlight secara berkala
task.spawn(function()
	while touchInterestToggle and touchInterestToggle.Parent do
		task.wait(0.5)
		if touchInterestEnabled then
			applyTouchInterestESP()
		end
	end
end)

