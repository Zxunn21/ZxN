-- LOGIKA DELATE FAR OBJECTS
delateFarButton.Activated:Connect(function()
	local character = player.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local maxDistance = tonumber(delateFarInput.Text)
	if not maxDistance or maxDistance < 0 then
		delateFarInput.Text = ""
		delateFarInput.PlaceholderText = "Masukkan angka!"
		return
	end

	local origin = root.Position
	local deleted = 0

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart") or object:IsA("Model") then
			if not object:IsDescendantOf(character) then
				local position

				if object:IsA("BasePart") then
					position = object.Position
				elseif object:IsA("Model") then
					local primary = object.PrimaryPart

					if primary then
						position = primary.Position
					else
						local part = object:FindFirstChildWhichIsA("BasePart", true)
						if part then
							position = part.Position
						end
					end
				end

				if position then
					local distance = (position - origin).Magnitude

					if distance > maxDistance then
						object:Destroy()
						deleted += 1
					end
				end
			end
		end
	end

	delateFarButton.Text = "Del: " .. deleted

	task.delay(1.5, function()
		if delateFarButton and delateFarButton.Parent then
			delateFarButton.Text = "Delate"
		end
	end)
end)
