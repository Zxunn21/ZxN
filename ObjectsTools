UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not infoESPEnabled then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	if not screenGui.Enabled or not mainFrame.Parent then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	local screenPosition
	if input.UserInputType == Enum.UserInputType.Touch then
		screenPosition = Vector2.new(input.Position.X, input.Position.Y)
	else
		screenPosition = UserInputService:GetMouseLocation()
	end
	if mainFrame.Visible then
		local p, size = mainFrame.AbsolutePosition, mainFrame.AbsoluteSize
		if screenPosition.X >= p.X and screenPosition.X <= p.X + size.X and screenPosition.Y >= p.Y and screenPosition.Y <= p.Y + size.Y then return end
	end
	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = true
	local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not result then return end
	local hit = result.Instance
	local selected
	if infoESPMode == "Part" then
		if hit:IsA("BasePart") then selected = hit end
	else
		local current = hit
		while current and current ~= workspace do
			if current:IsA("Model") then selected = current; break end
			current = current.Parent
		end
	end
	if selected then
		addInfoESP(selected)
		refreshInfoESPPaths()
	end
end)
