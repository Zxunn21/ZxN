-- LOGIKA PROXIMITY PROMPT ESP
local proximityESPEnabled = false
local proximityESPData = {}
local showObjectText = true
local showActionText = true
local showName = true

local function getPromptAdornee(prompt)
	if not prompt or not prompt.Parent then
		return nil
	end

	local parent = prompt.Parent
	if parent:IsA("BasePart") or parent:IsA("Model") or parent:IsA("Attachment") then
		return parent
	end

	local basePart = parent:FindFirstAncestorWhichIsA("BasePart")
	if basePart then
		return basePart
	end

	return parent:FindFirstAncestorWhichIsA("Model")
end

local function clearProximityESP(prompt)
	local data = proximityESPData[prompt]
	if not data then
		return
	end

	if data.Billboard then
		data.Billboard:Destroy()
	end
	if data.Highlight then
		data.Highlight:Destroy()
	end

	proximityESPData[prompt] = nil
end

local function getPromptTextInfo(prompt)
	local objectText = tostring(prompt.ObjectText or "")
	local actionText = tostring(prompt.ActionText or "")
	local promptName = tostring(prompt.Name or "")

	local mainText = objectText ~= "" and objectText or promptName
	if mainText == "" then
		mainText = "ProximityPrompt"
	end

	return mainText, actionText, promptName, objectText
end

local function createProximityESP(prompt)
	if not proximityESPEnabled or not prompt or not prompt:IsA("ProximityPrompt") then
		return
	end

	if not prompt.Parent or not prompt.Enabled then
		clearProximityESP(prompt)
		return
	end

	local adornee = getPromptAdornee(prompt)
	if not adornee then
		clearProximityESP(prompt)
		return
	end

	local mainText, actionText, promptName, objectText = getPromptTextInfo(prompt)

	local data = proximityESPData[prompt]
	if data and data.Billboard and data.Billboard.Parent and data.Highlight and data.Highlight.Parent then
		data.Billboard.Adornee = adornee
		data.Highlight.Adornee = adornee
		data.Billboard.Enabled = true
		data.Highlight.Enabled = true
		data.ObjectTextLabel.Visible = showObjectText
		data.ActionTextLabel.Visible = showActionText
		data.NameLabel.Visible = showName
		data.ObjectTextLabel.Text = mainText
		data.ActionTextLabel.Text = actionText ~= "" and ("[" .. actionText .. "]") or ""
		data.NameLabel.Text = (objectText ~= "" and promptName ~= "") and ("@" .. promptName) or ""
		return
	end

	clearProximityESP(prompt)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ObjekTools_ProximityESP"
	billboard.Size = UDim2.fromOffset(260, 62)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = math.huge
	billboard.Adornee = adornee
	billboard.Enabled = true
	billboard.Parent = playerGui

	local objectTextLabel = Instance.new("TextLabel")
	objectTextLabel.Name = "ObjectText"
	objectTextLabel.Size = UDim2.new(1, 0, 0, 22)
	objectTextLabel.Position = UDim2.fromOffset(0, 0)
	objectTextLabel.BackgroundTransparency = 1
	objectTextLabel.Text = mainText
	objectTextLabel.TextColor3 = Color3.new(1, 1, 1)
	objectTextLabel.TextStrokeTransparency = 0
	objectTextLabel.TextSize = 16
	objectTextLabel.Font = Enum.Font.GothamBold
	objectTextLabel.TextXAlignment = Enum.TextXAlignment.Center
	objectTextLabel.TextYAlignment = Enum.TextYAlignment.Center
	objectTextLabel.Visible = showObjectText
	objectTextLabel.Parent = billboard

	local actionTextLabel = Instance.new("TextLabel")
	actionTextLabel.Name = "ActionText"
	actionTextLabel.Size = UDim2.new(1, 0, 0, 18)
	actionTextLabel.Position = UDim2.fromOffset(0, 20)
	actionTextLabel.BackgroundTransparency = 1
	actionTextLabel.Text = actionText ~= "" and ("[" .. actionText .. "]") or ""
	actionTextLabel.TextColor3 = Color3.fromRGB(180, 220, 255)
	actionTextLabel.TextStrokeTransparency = 0
	actionTextLabel.TextSize = 13
	actionTextLabel.Font = Enum.Font.Gotham
	actionTextLabel.TextXAlignment = Enum.TextXAlignment.Center
	actionTextLabel.TextYAlignment = Enum.TextYAlignment.Center
	actionTextLabel.Visible = showActionText
	actionTextLabel.Parent = billboard

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "PromptName"
	nameLabel.Size = UDim2.new(1, 0, 0, 18)
	nameLabel.Position = UDim2.fromOffset(0, 37)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = (objectText ~= "" and promptName ~= "") and ("@" .. promptName) or ""
	nameLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	nameLabel.TextStrokeTransparency = 0
	nameLabel.TextSize = 12
	nameLabel.Font = Enum.Font.Gotham
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center
	nameLabel.Visible = showName
	nameLabel.Parent = billboard

	local highlight = Instance.new("Highlight")
	highlight.Name = "ObjekTools_ProximityHighlight"
	highlight.Adornee = adornee
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(80, 170, 255)
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Enabled = true
	highlight.Parent = screenGui

	proximityESPData[prompt] = {
		Billboard = billboard,
		Highlight = highlight,
		ObjectTextLabel = objectTextLabel,
		ActionTextLabel = actionTextLabel,
		NameLabel = nameLabel,
	}
end

local function refreshProximityESP()
	for prompt in pairs(proximityESPData) do
		local data = proximityESPData[prompt]
		if data then
			data.ObjectTextLabel.Visible = showObjectText
			data.ActionTextLabel.Visible = showActionText
			data.NameLabel.Visible = showName
		end
	end
end

local function clearAllProximityESP()
	for prompt in pairs(proximityESPData) do
		clearProximityESP(prompt)
	end
end

local function scanProximityESP()
	if not proximityESPEnabled then
		return
	end

	local seen = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			seen[obj] = true
			createProximityESP(obj)
		end
	end

	for prompt in pairs(proximityESPData) do
		if not seen[prompt] or not prompt.Parent or not prompt.Enabled then
			clearProximityESP(prompt)
		end
	end
end

local function setProximityESP(state)
	proximityESPEnabled = state
	proximityToggle.Text = state and "ON" or "OFF"
	proximityToggle.BackgroundColor3 = state
		and Color3.fromRGB(40, 150, 70)
		or Color3.fromRGB(180, 50, 50)

	if not state then
		clearAllProximityESP()
		return
	end

	scanProximityESP()
end

local function updateProximityToggleButtons()
	if showObjectText then
		proximityObjekToggle.Text = "Objek: ON"
		proximityObjekToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		proximityObjekToggle.Text = "Objek: OFF"
		proximityObjekToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if showActionText then
		proximityActionToggle.Text = "Action: ON"
		proximityActionToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		proximityActionToggle.Text = "Action: OFF"
		proximityActionToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end

	if showName then
		proximityNameToggle.Text = "Name: ON"
		proximityNameToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		proximityNameToggle.Text = "Name: OFF"
		proximityNameToggle.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

proximityToggle.Activated:Connect(function()
	setProximityESP(not proximityESPEnabled)
end)

proximityObjekToggle.Activated:Connect(function()
	showObjectText = not showObjectText
	updateProximityToggleButtons()
	refreshProximityESP()
end)

proximityActionToggle.Activated:Connect(function()
	showActionText = not showActionText
	updateProximityToggleButtons()
	refreshProximityESP()
end)

proximityNameToggle.Activated:Connect(function()
	showName = not showName
	updateProximityToggleButtons()
	refreshProximityESP()
end)

workspace.DescendantAdded:Connect(function(obj)
	if proximityESPEnabled and obj:IsA("ProximityPrompt") then
		task.defer(createProximityESP, obj)
	end
end)

workspace.DescendantRemoving:Connect(function(obj)
	if obj:IsA("ProximityPrompt") then
		clearProximityESP(obj)
	end
end)

task.spawn(function()
	while proximityToggle and proximityToggle.Parent do
		task.wait(0.5)
		if proximityESPEnabled then
			scanProximityESP()
		end
	end
	clearAllProximityESP()
end)

updateProximityToggleButtons()

