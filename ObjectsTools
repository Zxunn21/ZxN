local function infoObjectPath(obj)
	local names = {}
	local current = obj
	while current and current ~= game do
		table.insert(names, 1, current.Name)
		current = current.Parent
	end
	return table.concat(names, " - ")
end
local function infoESPBillboardPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart end
		return obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end
local function removeInfoESP(obj)
	local data = infoESPObjects[obj]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.billboard then data.billboard:Destroy() end
	infoESPObjects[obj] = nil
end
local function addInfoESP(obj)
	if not obj or not obj.Parent then return end
	if infoESPObjects[obj] then
		removeInfoESP(obj)
		return
	end
	if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end
	local highlight = Instance.new("Highlight")
