-- ===================== LIST EGG =====================
local lineStates = {} -- [model] = {Beam, Att0, Att1, HRP}
local listRefreshTimer = 0

local function getEggPart(model)
	return model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart", true)
end

-- Ambil nilai luck dari: model -> Handle (part) -> EggLuck (BillboardGui) -> Luck (TextLabel) -> Text
local function getLuckText(model)
	local handle = model:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		return "-"
	end

	local eggLuck = handle:FindFirstChild("EggLuck")
	if not eggLuck or not eggLuck:IsA("BillboardGui") then
		return "-"
	end

	-- Cari TextLabel "Luck" (toleran terhadap variasi huruf besar/kecil)
	local luckLabel = eggLuck:FindFirstChild("Luck")
	if not luckLabel then
		for _, child in ipairs(eggLuck:GetChildren()) do
			if child:IsA("TextLabel") and string.lower(child.Name) == "luck" then
				luckLabel = child
				break
			end
		end
	end

	if luckLabel and luckLabel:IsA("TextLabel") and luckLabel.Text ~= "" then
		return luckLabel.Text
	end

	return "-"
end

local function removeLine(model)
	local data = lineStates[model]
	if data then
		if data.Beam then data.Beam:Destroy() end
		if data.Att0 then data.Att0:Destroy() end
		if data.Att1 then data.Att1:Destroy() end
		lineStates[model] = nil
	end
end

-- Buat line (Beam) dari pemain ke model egg
local function createLine(model)
	local part = getEggPart(model)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not part or not hrp then
		return false
	end

	local att0 = Instance.new("Attachment")
	att0.Name = "EggLineAttachment"
	att0.Parent = hrp

	local att1 = Instance.new("Attachment")
	att1.Name = "EggLineAttachment"
	att1.Parent = part

	local beam = Instance.new("Beam")
	beam.Attachment0 = att0
	beam.Attachment1 = att1
	beam.Width0 = 0.3
	beam.Width1 = 0.3
	beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 127))
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.2)
	beam.Parent = part

	lineStates[model] = {
		Beam = beam,
		Att0 = att0,
		Att1 = att1,
		HRP = hrp
	}

	return true
end

-- Ambil nilai size X dari: model -> EggBase (part) -> Size.X
local function getSizeText(model)
	local eggBase = model:FindFirstChild("EggBase", true)
	if eggBase and eggBase:IsA("BasePart") then
		return string.format("%.2f", eggBase.Size.X)
	end

	return "-"
end

-- ===================== SORT =====================
local sortMode = "Luck" -- default: Luck

-- Ubah teks luck seperti "20B", "1.5M", "500K" menjadi angka
-- (B = Milyar, M = Juta, K = Ribu, dst)
local luckSuffixes = {
	K = 1e3,
	M = 1e6,
	B = 1e9,
	T = 1e12,
	Qa = 1e15,
	Qi = 1e18,
	Sx = 1e21,
	Sp = 1e24,
	Oc = 1e27,
	No = 1e30,
	Dc = 1e33,
}

local function parseLuckValue(text)
	if type(text) ~= "string" then
		return -1
	end

	local cleaned = text:gsub(",", ""):gsub("%s+", "")
	local numberPart = cleaned:match("^%-?%d+%.?%d*")
	if not numberPart then
		return -1
	end

	local number = tonumber(numberPart)
	if not number then
		return -1
	end

	local suffix = cleaned:sub(#numberPart + 1)
	if suffix == "" then
		return number
	end

	-- Normalisasi suffix: "b" -> "B", "QA" -> "Qa"
	local normalized
	if #suffix == 1 then
		normalized = string.upper(suffix)
	else
		normalized = string.upper(suffix:sub(1, 1)) .. string.lower(suffix:sub(2))
	end

	local multiplier = luckSuffixes[normalized]
	if multiplier then
		return number * multiplier
	end

	return number
end

local function getLuckValue(model)
	return parseLuckValue(getLuckText(model))
end

local function getSizeValue(model)
	local eggBase = model:FindFirstChild("EggBase", true)
	if eggBase and eggBase:IsA("BasePart") then
		return eggBase.Size.X
	end
	return -1
end

