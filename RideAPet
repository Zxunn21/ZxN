	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.ZIndex = 702
	nameLabel.Parent = row

	local luckLabel = Instance.new("TextLabel")
	luckLabel.Name = "Luck"
	luckLabel.Size = UDim2.new(0.3, 0, 1, 0)
	luckLabel.Position = UDim2.new(0.45, 0, 0, 0)
	luckLabel.BackgroundTransparency = 1
	luckLabel.Text = "luck: " .. getLuckText(model)
	luckLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
	luckLabel.TextSize = 14
	luckLabel.Font = Enum.Font.GothamBold
	luckLabel.TextXAlignment = Enum.TextXAlignment.Left
	luckLabel.TextTruncate = Enum.TextTruncate.AtEnd
	luckLabel.ZIndex = 702
	luckLabel.Parent = row

	local lineButton = Instance.new("TextButton")
	lineButton.Name = "LineButton"
	lineButton.Size = UDim2.fromOffset(70, 30)
	lineButton.Position = UDim2.new(1, -78, 0.5, -15)
	lineButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	lineButton.BorderSizePixel = 0
	lineButton.Text = "Line"
	lineButton.TextColor3 = Color3.new(1, 1, 1)
	lineButton.TextSize = 14
	lineButton.Font = Enum.Font.GothamBold
	lineButton.ZIndex = 702
	lineButton.Parent = row

	local lineButtonCorner = Instance.new("UICorner")
	lineButtonCorner.CornerRadius = UDim.new(0, 7)
	lineButtonCorner.Parent = lineButton

	if lineStates[model] then
		lineButton.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	end

	lineButton.Activated:Connect(function()
		if lineStates[model] then
			removeLine(model)
			lineButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		else
			if createLine(model) then
				lineButton.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
			end
		end
	end)

	return row
end

local function refreshEggList()
	-- Simpan posisi scroll agar tidak lompat saat refresh
	local savedScrollY = eggScroll.CanvasPosition.Y

	-- Bersihkan baris lama
	for _, child in ipairs(eggScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	-- Bersihkan line dari model yang sudah tidak ada
	for model in pairs(lineStates) do
		if not model.Parent then
			lineStates[model] = nil
		end
	end

	findRenderedEggs()
	if not renderedEggs or not renderedEggs.Parent then
		return
	end

	local order = 0
	for _, model in ipairs(renderedEggs:GetChildren()) do
		if model:IsA("Model") then
			order += 1
			createEggRow(model, order)
		end
	end

	-- Kembalikan posisi scroll
	eggScroll.CanvasPosition = Vector2.new(0, savedScrollY)
end

local function updateListEggToggle()
	if eggListFrame.Visible then
		listEggToggle.Text = "ON"
		listEggToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		listEggToggle.Text = "OFF"
		listEggToggle.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	end
end

listEggToggle.Activated:Connect(function()
	eggListFrame.Visible = not eggListFrame.Visible
	if eggListFrame.Visible then
		refreshEggList()
	end
	updateListEggToggle()
end)

-- Saat karakter respawn, pindahkan attachment line ke HRP baru
player.CharacterAdded:Connect(function(character)
	local hrp = character:WaitForChild("HumanoidRootPart", 5)
	if not hrp then
		return
	end

	for model, data in pairs(lineStates) do
		if data.HRP ~= hrp then
			local part = getEggPart(model)
			if part then
				local att0 = Instance.new("Attachment")
				att0.Name = "EggLineAttachment"
				att0.Parent = hrp

				if data.Att0 then
					data.Att0:Destroy()
				end

				data.Att0 = att0
				data.HRP = hrp

				if data.Beam then
					data.Beam.Attachment0 = att0
				end
			else
				removeLine(model)
			end
		end
	end
end)

-- ===================== LOOP =====================
task.spawn(function()
	while gui.Parent do
		task.wait(0.05)

		if espEnabled then
			updateESP()
		end

		-- Refresh daftar egg secara berkala saat frame terbuka
		if eggListFrame.Visible then
			listRefreshTimer += 0.05
			if listRefreshTimer >= 2 then
				listRefreshTimer = 0
				refreshEggList()
			end
		end
	end
end)

updateEspToggle()
updateListEggToggle()
updateESP()
