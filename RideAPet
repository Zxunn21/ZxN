local function refreshEggList()
	-- Simpan posisi scroll agar tidak lompat saat refresh
	local savedScrollY = eggScroll.CanvasPosition.Y

	-- Bersihkan baris lama
	for _, child in ipairs(eggScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	-- Bersihkan line dari model yang sudah tidak ada
	for model in pairs(lineStates) do
		if not model.Parent then
			lineStates[model] = nil
		end
	end

	local order = 0

	findRenderedEggs()
	if not renderedEggs or not renderedEggs.Parent then
		return
	end

	local models = {}
	for _, model in ipairs(renderedEggs:GetChildren()) do
		if model:IsA("Model") then
			table.insert(models, model)
		end
	end

	-- Urutkan sesuai mode sort
	if sortMode == "Luck" then
		table.sort(models, function(a, b)
			return getLuckValue(a) > getLuckValue(b)
		end)
	elseif sortMode == "Size" then
		table.sort(models, function(a, b)
			return getSizeValue(a) > getSizeValue(b)
		end)
	else -- Name
		table.sort(models, function(a, b)
			return string.lower(a.Name) < string.lower(b.Name)
		end)
	end

	for _, model in ipairs(models) do
		order += 1
		createEggRow(model, order)
	end

	-- Kembalikan posisi scroll
	eggScroll.CanvasPosition = Vector2.new(0, savedScrollY)
end

