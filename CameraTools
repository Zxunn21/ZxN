-- === FREE CAM ===
-- Anchor avatar dan berikan kontrol penuh ke default Roblox camera (sudah support mobile)
local freeCamEnabled = false
local camera = workspace.CurrentCamera
local anchoredParts = {}

local function startFreeCam()
	freeCamEnabled = true

	-- Anchor semua part karakter
	local character = player.Character
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and not part.Anchored then
			part.Anchored = true
				table.insert(anchoredParts, part)
			end
		end
	end

	-- Pastikan kamera di mode Classic (default controls, support mobile touch look & zoom)
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 500
end

local function stopFreeCam()
	freeCamEnabled = false

	-- Unanchor kembali semua part yang sebelumnya di-anchor
	for _, part in ipairs(anchoredParts) do
		if part and part.Parent then
			part.Anchored = false
		end
	end
	anchoredParts = {}
end

-- Re-apply saat karakter respawn
player.CharacterAdded:Connect(function(character)
	anchoredParts = {}
	if freeCamEnabled then
		task.wait(0.1)
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and not part.Anchored then
				part.Anchored = true
				table.insert(anchoredParts, part)
			end
		end
	end
end)

-- Free Cam toggle row
local freeCamButton
freeCamButton = makeButton("OFF", function()
	if freeCamEnabled then
		stopFreeCam()
		freeCamButton.Text = "OFF"
		freeCamButton.BackgroundColor3 = Color3.fromRGB(60, 120, 200)
	else
		startFreeCam()
		freeCamButton.Text = "ON"
		freeCamButton.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	end
end)

local freeCamRow = makeRow(3, "Free Cam", { freeCamButton })
