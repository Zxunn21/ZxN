local function hideAllGuis()
	guiHidden = true
	savedGuiStates = {}

	for _, child in ipairs(playerGui:GetChildren()) do
		if child:IsA("ScreenGui") and child ~= controlsGui then
			savedGuiStates[child] = child.Enabled
			child.Enabled = false
		end
	end

	for _, cgType in ipairs(CORE_GUI_TYPES) do
		pcall(function()
			savedCoreGuiStates[cgType] =
				StarterGui:GetCoreGuiEnabled(cgType)

			StarterGui:SetCoreGuiEnabled(cgType, false)
		end)
	end

	pcall(function()
		StarterGui:SetCore("TopbarEnabled", false)
	end)
end

local function showAllGuis()
	guiHidden = false

	for inst, state in pairs(savedGuiStates) do
		if inst and inst.Parent then
			if inst:IsA("ScreenGui") then
				inst.Enabled = state
			else
				inst.Visible = state
			end
		end
	end

	for cgType, state in pairs(savedCoreGuiStates) do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(cgType, state)
		end)
	end

	pcall(function()
		StarterGui:SetCore("TopbarEnabled", true)
	end)

	savedGuiStates = {}
	savedCoreGuiStates = {}
end

local function setPadTransparency(transparency)
	for _, button in ipairs({forwardBtn, backwardBtn, leftBtn, rightBtn, upBtn, downBtn}) do
		button.BackgroundTransparency = transparency
		button.TextTransparency = transparency >= 0.95 and 0.15 or 0
	end
end

local function setCameraControlsHidden(hidden)
	controlsHidden = hidden
	-- Panah tetap aktif untuk menggerakkan kamera, tetapi hampir transparan.
	movePad.Visible = UserInputService.TouchEnabled and freeCamEnabled
	vertPad.Visible = UserInputService.TouchEnabled and freeCamEnabled
	setPadTransparency(hidden and 0.95 or 0.35)
	zoomSlider.Visible = not hidden and freeCamEnabled
	sensitivitySlider.Visible = not hidden and freeCamEnabled
	speedSlider.Visible = not hidden and freeCamEnabled
	teleportButton.Visible = not hidden and freeCamEnabled
	showPanelButton.Visible = not hidden and freeCamEnabled
	-- Tombol lingkaran tetap tampil sebagai tombol untuk memulihkan kontrol.
	circleButton.Visible = freeCamEnabled
end

