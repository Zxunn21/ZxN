-- === SETTINGS: kecepatan gerak & sensitivitas kamera (input kecil) ===
local function makeNumberInput(name, getValue, setValue, min, max, fmt)
	local box = create("TextBox", {
		Name = name .. "Input",
		Size = UDim2.new(0, 90, 0, 28),
		BackgroundColor3 = Color3.fromRGB(25, 25, 32),
		BackgroundTransparency = 0.2,
		Text = fmt(getValue()),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		PlaceholderText = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		ClearTextOnFocus = false,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 6) }),
		create("UIStroke", { Color = Color3.fromRGB(90, 90, 110), Transparency = 0.4, Thickness = 1 }),
	})
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			setValue(math.clamp(n, min, max))
		end
		box.Text = fmt(getValue())
	end)
	return box
end

