local function hideAllGuis()
	guiHidden = true
	savedGuiStates = {}

	for _, child in ipairs(playerGui:GetChildren()) do
		if child:IsA("ScreenGui") and child ~= controlsGui then
			savedGuiStates[child] = child.Enabled
			child.Enabled = false
		end
	end

	for _, child in ipairs(controlsGui:GetChildren()) do
		if child ~= circleButton then
			savedGuiStates[child] = child.Visible
			child.Visible = false
		end
	end

	for _, cgType in ipairs(CORE_GUI_TYPES) do
		pcall(function()
			savedCoreGuiStates[cgType] =
				StarterGui:GetCoreGuiEnabled(cgType)

			StarterGui:SetCoreGuiEnabled(cgType, false)
		end)
	end

	pcall(function()
		StarterGui:SetCore("TopbarEnabled", false)
	end)
end

local function showAllGuis()
	guiHidden = false

	for inst, state in pairs(savedGuiStates) do
		if inst and inst.Parent then
			if inst:IsA("ScreenGui") then
				inst.Enabled = state
			else
				inst.Visible = state
			end
		end
	end

	for cgType, state in pairs(savedCoreGuiStates) do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(cgType, state)
		end)
	end

	pcall(function()
		StarterGui:SetCore("TopbarEnabled", true)
	end)

	savedGuiStates = {}
	savedCoreGuiStates = {}
end

