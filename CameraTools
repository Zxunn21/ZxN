	end
end)

local function startFreeCam()
	if freeCamEnabled then
		return
	end

	camera = workspace.CurrentCamera

	if not camera then
		return
	end

	-- Simpan keadaan kamera agar dapat dipulihkan saat Free Cam dimatikan.
	savedCameraType = camera.CameraType
	savedCameraSubject = camera.CameraSubject
	savedCameraCFrame = camera.CFrame
	savedFieldOfView = camera.FieldOfView
	local focusPosition = camera.Focus.Position
	local measuredDistance = (camera.CFrame.Position - focusPosition).Magnitude
	savedInitialCameraDistance = math.max(measuredDistance, 1)

	freeCamEnabled = true
	freeCamPosition = camera.CFrame.Position

	-- Sembunyikan seluruh GUI lain secara otomatis, tetapi pertahankan kontrol kamera.
	hideAllGuis()

	-- Free Cam hanya menggerakkan kamera. Karakter tidak perlu di-anchor,
	-- karena itu dapat mengganggu kontrol pemain dan tidak diperlukan untuk pergerakan kamera.

	local look = camera.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))

	camera.CameraType = Enum.CameraType.Scriptable

	mainFrame.Visible = false
	showPanelButton.Visible = true

	vertPad.Visible = UserInputService.TouchEnabled
 	controlsHidden = false
	movePad.Visible = UserInputService.TouchEnabled
	zoomSlider.Visible = true
	sensitivitySlider.Visible = true
	speedSlider.Visible = true
	teleportButton.Visible = true
	setPadTransparency(0.35)
	circleButton.Visible = true

	setZoom(zoomValue)
end

local function stopFreeCam()
	if not freeCamEnabled then
		return
	end

	freeCamEnabled = false

	keysDown = {}
	btnState = {}

	zoomDragging = false

	vertPad.Visible = false
	movePad.Visible = false
 	zoomSlider.Visible = false
	sensitivitySlider.Visible = false
	speedSlider.Visible = false
	teleportButton.Visible = false
	sensitivityDragging = false
	speedDragging = false
	controlsHidden = false
	circleButton.Visible = false
	showPanelButton.Visible = false

	mainFrame.Visible = true

	if guiHidden then
		showAllGuis()
	end

	if camera then
		camera.FieldOfView = savedFieldOfView or BASE_FOV

		if savedCameraType then
			camera.CameraType = savedCameraType
		else
			camera.CameraType = Enum.CameraType.Custom
		end

		if savedCameraSubject and savedCameraSubject.Parent then
			camera.CameraSubject = savedCameraSubject
		else
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end

		if savedCameraCFrame then
			camera.CFrame = savedCameraCFrame
		end
	end

	freeCamPosition = nil
	savedCameraType = nil
	savedCameraSubject = nil
	savedCameraCFrame = nil
	savedFieldOfView = nil

	restoreAnchors()
end

local touchLookInput = nil
local mouseLookActive = false

local KEYMAP = {
	[Enum.KeyCode.W] = "forward",
	[Enum.KeyCode.Up] = "forward",

	[Enum.KeyCode.S] = "backward",
	[Enum.KeyCode.Down] = "backward",

	[Enum.KeyCode.A] = "left",
	[Enum.KeyCode.Left] = "left",

	[Enum.KeyCode.D] = "right",
	[Enum.KeyCode.Right] = "right",

	[Enum.KeyCode.Space] = "up",
	[Enum.KeyCode.E] = "up",
	[Enum.KeyCode.LeftShift] = "down",
	[Enum.KeyCode.Q] = "down",
}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not freeCamEnabled then
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		local dir = KEYMAP[input.KeyCode]

		if dir then
			keysDown[dir] = true
		end

	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		mouseLookActive = true

	elseif input.UserInputType == Enum.UserInputType.Touch then
		local pos = input.Position
		local screenWidth = camera and camera.ViewportSize.X or 0

		-- Sisi kanan layar untuk mengubah arah pandang.
		-- Sisi kiri dikhususkan untuk tombol gerak agar tidak saling mengganggu.
		if screenWidth > 0 and pos.X > screenWidth * 0.55 then
			touchLookInput = input
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local dir = KEYMAP[input.KeyCode]

		if dir then
			keysDown[dir] = nil
		end

	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		mouseLookActive = false

	elseif input.UserInputType == Enum.UserInputType.Touch then
		if input == touchLookInput then
			touchLookInput = nil
		end
	end
end)

UserInputService.WindowFocusReleased:Connect(function()
	keysDown = {}
	mouseLookActive = false
	touchLookInput = nil
	btnState = {}
end)

UserInputService.InputChanged:Connect(function(input)
	if not freeCamEnabled then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if mouseLookActive then
			yaw -= input.Delta.X * LOOK_SENSITIVITY * FREECAM_SENSITIVITY_MULTIPLIER / math.max(zoomValue, 1)
			pitch = math.clamp(
				pitch - input.Delta.Y * LOOK_SENSITIVITY * FREECAM_SENSITIVITY_MULTIPLIER / math.max(zoomValue, 1),
				-math.rad(89),
				math.rad(89)
			)
		end

	elseif input.UserInputType == Enum.UserInputType.Touch then
		if input == touchLookInput then
			yaw -= input.Delta.X * LOOK_SENSITIVITY * FREECAM_SENSITIVITY_MULTIPLIER / math.max(zoomValue, 1)
			pitch = math.clamp(
				pitch - input.Delta.Y * LOOK_SENSITIVITY * FREECAM_SENSITIVITY_MULTIPLIER / math.max(zoomValue, 1),
				-math.rad(89),
				math.rad(89)
			)
		end
	end
end)

RunService:BindToRenderStep(
	"CameraToolsFreeCam",
	Enum.RenderPriority.Camera.Value + 1,
	function(dt)
		if not freeCamEnabled then
			return
		end

		camera = workspace.CurrentCamera
		if not camera then
			return
		end

		-- Pertahankan posisi Free Cam sendiri. Jangan mengambil posisi dari CFrame
		-- kamera setiap frame karena sistem kamera lain dapat menimpanya.
		if not freeCamPosition then
			freeCamPosition = camera.CFrame.Position
		end

		local rotation = CFrame.fromOrientation(pitch, yaw, 0)
		local move = Vector3.zero

		if keysDown.forward or btnState.forward then move += Vector3.new(0, 0, -1) end
		if keysDown.backward or btnState.backward then move += Vector3.new(0, 0, 1) end
		if keysDown.left or btnState.left then move += Vector3.new(-1, 0, 0) end
		if keysDown.right or btnState.right then move += Vector3.new(1, 0, 0) end
		if keysDown.up or btnState.up then move += Vector3.new(0, 1, 0) end
		if keysDown.down or btnState.down then move += Vector3.new(0, -1, 0) end

		if move.Magnitude > 0 then
			move = move.Unit
		end

		-- Seluruh gerakan mengikuti orientasi kamera, termasuk sudut atas/bawah.
		-- Jadi tombol maju/panah atas bergerak tepat ke arah kamera sedang menghadap.
		local worldMove = rotation:VectorToWorldSpace(move)

		local speed = BASE_SPEED * FREECAM_SPEED_MULTIPLIER
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
			speed *= SPRINT_MULT
		end

		freeCamPosition += worldMove * speed * dt
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.new(freeCamPosition) * rotation
	end
)

