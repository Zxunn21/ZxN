joystickKnob.Parent = joystickBase
joystickBase.Active = false
joystickBase.Parent = screenGui

local function startFreeCam()
	freeCamEnabled = true
	freeCamPos = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	freeCamYaw = math.atan2(-look.X, -look.Z)
	freeCamPitch = math.asin(math.clamp(look.Y, -1, 1))
	camera.CameraType = Enum.CameraType.Scriptable
	if UserInputService.TouchEnabled then
		joystickBase.Visible = true
	end
end

local function stopFreeCam()
	freeCamEnabled = false
	camera.CameraType = Enum.CameraType.Custom
	joystickBase.Visible = false
	joystickTouchId = nil
	lookTouchId = nil
	joystickKnob.Position = UDim2.new(0.5, 0, 0.5, 0)
end

-- Helper: check if a screen position is on the mainFrame (so we don't interfere with buttons)
local function isOnMainFrame(pos)
	local vp = camera.ViewportSize
	local framePos = mainFrame.AbsolutePosition
	local frameSize = mainFrame.AbsoluteSize
	return pos.X >= framePos.X and pos.X <= framePos.X + frameSize.X
		and pos.Y >= framePos.Y and pos.Y <= framePos.Y + frameSize.Y
end

-- Touch input for mobile look + joystick
UserInputService.InputBegan:Connect(function(input, processed)
	if not freeCamEnabled then return end

	if input.UserInputType == Enum.UserInputType.Touch then
		local pos = input.Position
		local viewportX = camera.ViewportSize.X
		local viewportY = camera.ViewportSize.Y

		-- Skip touches on the mainFrame (button presses)
		if isOnMainFrame(pos) then return end

		-- Left-bottom quadrant = joystick movement
		if pos.X < viewportX * 0.5 and pos.Y > viewportY * 0.5 and not joystickTouchId then
			joystickTouchId = input.Id
			joystickStartPos = pos
			joystickCurrentPos = pos
		elseif not lookTouchId then
			lookTouchId = input.Id
			lookLastPos = pos
		end
	end
end)

UserInputService.InputChanged:Connect(function(input, processed)
	if not freeCamEnabled then return end

	if input.UserInputType == Enum.UserInputType.Touch then
		if input.Id == joystickTouchId then
			joystickCurrentPos = input.Position
			local delta = joystickCurrentPos - joystickStartPos
			local maxDist = 40
			local clampedX = math.clamp(delta.X, -maxDist, maxDist)
			local clampedY = math.clamp(delta.Y, -maxDist, maxDist)
			joystickKnob.Position = UDim2.new(0.5, clampedX, 0.5, clampedY)
		elseif input.Id == lookTouchId then
			local delta = input.Position - lookLastPos
			freeCamYaw -= delta.X * 0.005
			freeCamPitch = math.clamp(freeCamPitch - delta.Y * 0.005, -math.pi / 2 + 0.01, math.pi / 2 - 0.01)
			lookLastPos = input.Position
		end
	elseif input.UserInputType == Enum.UserInputType.MouseMovement then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			freeCamYaw -= input.Delta.X * 0.005
			freeCamPitch = math.clamp(freeCamPitch - input.Delta.Y * 0.005, -math.pi / 2 + 0.01, math.pi / 2 - 0.01)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if input.Id == joystickTouchId then
			joystickTouchId = nil
			joystickStartPos = nil
			joystickCurrentPos = nil
			joystickKnob.Position = UDim2.new(0.5, 0, 0.5, 0)
		elseif input.Id == lookTouchId then
			lookTouchId = nil
			lookLastPos = nil
		end
	end
end)

-- Camera update loop
RunService.RenderStepped:Connect(function(dt)
	if not freeCamEnabled then return end

	local moveVector = Vector3.zero

	-- Keyboard movement (desktop)
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector += Vector3.new(0, 0, -1) end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector += Vector3.new(0, 0, 1) end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector += Vector3.new(-1, 0, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector += Vector3.new(1, 0, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveVector += Vector3.new(0, 1, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveVector += Vector3.new(0, -1, 0) end

	-- Mobile joystick movement
	if joystickTouchId and joystickStartPos and joystickCurrentPos then
		local delta = joystickCurrentPos - joystickStartPos
		local maxDist = 40
		moveVector += Vector3.new(
			math.clamp(delta.X, -maxDist, maxDist) / maxDist,
			0,
			math.clamp(delta.Y, -maxDist, maxDist) / maxDist
		)
	end

	-- Apply movement relative to camera orientation
	if moveVector.Magnitude > 0 then
		local cf = CFrame.fromOrientation(freeCamPitch, freeCamYaw, 0)
		local worldMove = cf:VectorToWorldSpace(moveVector)
		freeCamPos += worldMove * freeCamSpeed * dt
	end

	camera.CFrame = CFrame.new(freeCamPos) * CFrame.fromOrientation(freeCamPitch, freeCamYaw, 0)
end)

