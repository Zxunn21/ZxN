local sensitivityDragging = false
local function setFreeCamSensitivity(value)
	FREECAM_SENSITIVITY_MULTIPLIER = math.clamp(value, 0.05, 1)
	local fraction = (FREECAM_SENSITIVITY_MULTIPLIER - 0.05) / 0.95
	sensitivityFill.Size = UDim2.new(fraction, 0, 1, 0)
	sensitivityKnob.Position = UDim2.new(fraction, 0, 0.5, 0)
	sensitivityLabel.Text = "Sensitivity " .. tostring(math.floor(FREECAM_SENSITIVITY_MULTIPLIER * 100 + 0.5)) .. "%"
end

local function sensitivityFromInput(input)
	local x = sensitivitySlider.AbsolutePosition.X
	local width = math.max(sensitivitySlider.AbsoluteSize.X, 1)
	local fraction = math.clamp((input.Position.X - x) / width, 0, 1)
	setFreeCamSensitivity(0.05 + fraction * 0.95)
end

setFreeCamSensitivity(FREECAM_SENSITIVITY_MULTIPLIER)

teleportButton.Activated:Connect(function()
	if not freeCamEnabled then
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	local lookDirection = CFrame.fromOrientation(pitch, yaw, 0).LookVector.Unit
	local distance = math.max(savedInitialCameraDistance, 1)
	-- Gunakan titik tepat di depan kamera. Jangan raycast ke lantai, karena
	-- posisi tujuan memang boleh berada lebih tinggi dari posisi pemain semula.
	local targetPosition = freeCamPosition + lookDirection * distance

	-- Pertahankan orientasi tubuh agar karakter tetap tegak walaupun kamera
	-- sedang melihat ke atas atau ke bawah.
	local currentPivot = character:GetPivot()
	local pivotRotation = currentPivot - currentPivot.Position
	local targetPivotPosition = targetPosition + (currentPivot.Position - root.Position)
	character:PivotTo(CFrame.new(targetPivotPosition) * pivotRotation)

	-- Hilangkan momentum lama agar karakter tidak terdorong kembali setelah teleport.
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end)

