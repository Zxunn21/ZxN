local function anchorCharacter(character)
	anchoredParts = {}
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and not part.Anchored then
			part.Anchored = true
			table.insert(anchoredParts, part)
		end
	end
end

local function startFreeCam()
	freeCamEnabled = true
	anchorCharacter(player.Character)

	-- Mulai orientasi dari arah pandang kamera saat ini
	local look = camera.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))

	-- Kamera dikendalikan penuh oleh script ini (mode fly)
	camera.CameraType = Enum.CameraType.Scriptable

	-- Tampilkan tombol navigasi hanya di perangkat touch
	local showPads = UserInputService.TouchEnabled
	movePad.Visible = showPads
	vertPad.Visible = showPads
end

local function stopFreeCam()
	freeCamEnabled = false
	lookDragging = false
	keysDown = {}
	btnState = {}
	movePad.Visible = false
	vertPad.Visible = false

	-- Unanchor kembali semua part yang sebelumnya di-anchor
	for _, part in ipairs(anchoredParts) do
		if part and part.Parent then
			part.Anchored = false
		end
	end
	anchoredParts = {}

	-- Kembalikan kamera ke kontrol default Roblox
	camera.CameraType = Enum.CameraType.Custom
end

-- Input keyboard & drag untuk memutar pandangan
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local dir = KEYMAP[input.KeyCode]
		if dir then keysDown[dir] = true end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2
		or input.UserInputType == Enum.UserInputType.Touch then
		if freeCamEnabled then lookDragging = true end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local dir = KEYMAP[input.KeyCode]
		if dir then keysDown[dir] = nil end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2
		or input.UserInputType == Enum.UserInputType.Touch then
		lookDragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not (freeCamEnabled and lookDragging) then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		yaw -= input.Delta.X * LOOK_SENSITIVITY
		pitch = math.clamp(pitch - input.Delta.Y * LOOK_SENSITIVITY, -math.rad(89), math.rad(89))
	end
end)

-- Update kamera setiap frame (gerak halus seperti fly)
RunService.RenderStepped:Connect(function(dt)
	if not freeCamEnabled then return end

	local rot = CFrame.fromOrientation(pitch, yaw, 0)

	local moveDir = Vector3.zero
	if keysDown.forward or btnState.forward then moveDir += rot.LookVector end
	if keysDown.backward or btnState.backward then moveDir -= rot.LookVector end
	if keysDown.left or btnState.left then moveDir -= rot.RightVector end
	if keysDown.right or btnState.right then moveDir += rot.RightVector end
	if keysDown.up or btnState.up then moveDir += Vector3.yAxis end
	if keysDown.down or btnState.down then moveDir -= Vector3.yAxis end

	local pos = camera.CFrame.Position
	if moveDir.Magnitude > 0 then
		local speed = BASE_SPEED
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			speed *= SPRINT_MULT
		end
		pos += moveDir.Unit * speed * dt
	end

	camera.CFrame = CFrame.new(pos) * rot
end)

-- Re-apply anchor saat karakter respawn
player.CharacterAdded:Connect(function(character)
	anchoredParts = {}
	if freeCamEnabled then
		task.wait(0.1)
		anchorCharacter(character)
	end
end)

