	else
		hideAllGuis()
	end
end)

local function startFreeCam()
	if freeCamEnabled then
		return
	end

	camera = workspace.CurrentCamera

	if not camera then
		return
	end

	freeCamEnabled = true

	anchorCharacter(player.Character)

	local look = camera.CFrame.LookVector

	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))

	camera.CameraType = Enum.CameraType.Scriptable

	mainFrame.Visible = false
	showPanelButton.Visible = true

	vertPad.Visible = UserInputService.TouchEnabled
	zoomSlider.Visible = true
	circleButton.Visible = true

	setZoom(zoomValue)
end

local function stopFreeCam()
	if not freeCamEnabled then
		return
	end

	freeCamEnabled = false

	keysDown = {}
	btnState = {}

	zoomDragging = false

	vertPad.Visible = false
	zoomSlider.Visible = false
	circleButton.Visible = false
	showPanelButton.Visible = false

	mainFrame.Visible = true

	if guiHidden then
		showAllGuis()
	end

	if camera then
		camera.FieldOfView = BASE_FOV
	end

	restoreAnchors()

	if camera then
		camera.CameraType = Enum.CameraType.Custom

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

local touchLookInput = nil
local mouseLookActive = false

local KEYMAP = {
	[Enum.KeyCode.W] = "forward",
	[Enum.KeyCode.Up] = "forward",

	[Enum.KeyCode.S] = "backward",
	[Enum.KeyCode.Down] = "backward",

	[Enum.KeyCode.A] = "left",
	[Enum.KeyCode.Left] = "left",

	[Enum.KeyCode.D] = "right",
	[Enum.KeyCode.Right] = "right",

	[Enum.KeyCode.Space] = "up",
	[Enum.KeyCode.LeftShift] = "down",
}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not freeCamEnabled then
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		local dir = KEYMAP[input.KeyCode]

		if dir then
			keysDown[dir] = true
		end

	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		mouseLookActive = true

	elseif input.UserInputType == Enum.UserInputType.Touch then
		local pos = input.Position

		local screenWidth = camera and camera.ViewportSize.X or 0

		if screenWidth > 0 and pos.X < screenWidth * 0.55 then
			touchLookInput = input
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local dir = KEYMAP[input.KeyCode]

		if dir then
			keysDown[dir] = nil
		end

	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		mouseLookActive = false

	elseif input.UserInputType == Enum.UserInputType.Touch then
		if input == touchLookInput then
			touchLookInput = nil
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not freeCamEnabled then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if mouseLookActive then
			yaw -= input.Delta.X * LOOK_SENSITIVITY
			pitch = math.clamp(
				pitch - input.Delta.Y * LOOK_SENSITIVITY,
				-math.rad(89),
				math.rad(89)
			)
		end

	elseif input.UserInputType == Enum.UserInputType.Touch then
		if input == touchLookInput then
			yaw -= input.Delta.X * LOOK_SENSITIVITY
			pitch = math.clamp(
				pitch - input.Delta.Y * LOOK_SENSITIVITY,
				-math.rad(89),
				math.rad(89)
			)
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not freeCamEnabled then
		return
	end

	if not camera then
		camera = workspace.CurrentCamera
	end

	if not camera then
		return
	end

	local rotation = CFrame.fromOrientation(
		pitch,
		yaw,
		0
	)

	local move = Vector3.zero

	if keysDown.forward then
		move += Vector3.new(0, 0, -1)
	end

	if keysDown.backward then
		move += Vector3.new(0, 0, 1)
	end

	if keysDown.left then
		move += Vector3.new(-1, 0, 0)
	end

	if keysDown.right then
		move += Vector3.new(1, 0, 0)
	end

	if btnState.up then
		move += Vector3.new(0, 1, 0)
	end

	if btnState.down then
		move += Vector3.new(0, -1, 0)
	end

	if move.Magnitude > 0 then
		move = move.Unit
	end

	local worldMove =
		rotation:VectorToWorldSpace(move)

	local speed = BASE_SPEED

	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then

		speed *= SPRINT_MULT
	end

	local position = camera.CFrame.Position

	position += worldMove * speed * dt

	camera.CFrame =
		CFrame.new(position) * rotation
end)

