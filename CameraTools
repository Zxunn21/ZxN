-- === FREE CAM ===
-- Mode seperti "fly": kamera bebas bergerak ke segala arah
-- (WASD untuk gerak, Space naik, Shift turun, tahan Ctrl untuk sprint,
-- drag mouse kanan / sentuh layar untuk memutar arah pandang),
-- sementara tubuh karakter tetap di-anchor di tempat.
local RunService = game:GetService("RunService")

local freeCamEnabled = false
local camera = workspace.CurrentCamera
local anchoredParts = {}

local BASE_SPEED = 50
local SPRINT_MULT = 3
local LOOK_SENSITIVITY = 0.005

local yaw, pitch = 0, 0
local keysDown = {}
local btnState = {}
local lookDragging = false

local KEYMAP = {
	[Enum.KeyCode.W] = "forward",
	[Enum.KeyCode.Up] = "forward",
	[Enum.KeyCode.S] = "backward",
	[Enum.KeyCode.Down] = "backward",
	[Enum.KeyCode.A] = "left",
	[Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.D] = "right",
	[Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.Space] = "up",
	[Enum.KeyCode.LeftShift] = "down",
}

-- Tombol navigasi on-screen (untuk mobile / touch)
local function makeMoveButton(text, dir)
	local btn = create("TextButton", {
		Name = dir .. "Button",
		Size = UDim2.new(0, 44, 0, 44),
		BackgroundColor3 = Color3.fromRGB(60, 60, 75),
		BackgroundTransparency = 0.35,
		Text = text,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		AutoButtonColor = false,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 10) }),
	})
	local function setActive(on)
		btnState[dir] = on or nil
		btn.BackgroundTransparency = on and 0 or 0.35
	end
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			setActive(true)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			setActive(false)
		end
	end)
	btn.MouseLeave:Connect(function()
		setActive(false)
	end)
	return btn
end

