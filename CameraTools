-- Pemetaan logaritmik agar rentang 0.5-10 terasa merata di sepanjang slider
local function zoomFromFraction(f)
	return ZOOM_MIN * (ZOOM_MAX / ZOOM_MIN) ^ f
end
local function fractionFromZoom(z)
	return math.log(z / ZOOM_MIN) / math.log(ZOOM_MAX / ZOOM_MIN)
end

local function setZoom(z)
	zoomValue = math.clamp(z, ZOOM_MIN, ZOOM_MAX)
	local f = fractionFromZoom(zoomValue)
	zoomFill.Size = UDim2.new(1, 0, f, 0)
	zoomKnob.Position = UDim2.new(0.5, 0, 1 - f, 0)
	zoomLabel.Text = "x" .. string.format("%.1f", zoomValue)
	-- Zoom 1x = FOV normal; zoom > 1 mempersempit FOV (telefoto), zoom < 1 melebarkan
	camera.FieldOfView = math.clamp(BASE_FOV / zoomValue, 5, 120)
end

-- Jika CurrentCamera diganti (mis. saat berganti map dalam sesi yang sama,
-- atau kamera lama dihancurkan oleh sistem map), perbarui referensi 'camera'
-- agar free cam, zoom, dan tombol foto tetap berfungsi di map manapun
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = workspace.CurrentCamera
	if freeCamEnabled then
		camera.CameraType = Enum.CameraType.Scriptable
		setZoom(zoomValue)
	end
end)

local zoomDragging = false
local function zoomFromInput(input)
	local absPos = zoomSlider.AbsolutePosition
	local h = math.max(zoomSlider.AbsoluteSize.Y, 1)
	local f = math.clamp(1 - (input.Position.Y - absPos.Y) / h, 0, 1)
	setZoom(zoomFromFraction(f))
end

zoomSlider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		zoomDragging = true
		zoomFromInput(input) -- tap langsung mengatur nilai di posisi sentuhan
	end
end)
zoomSlider.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		zoomDragging = false
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if not zoomDragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		zoomFromInput(input)
	end
end)

