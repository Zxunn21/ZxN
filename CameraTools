-- === FREE CAM ===
local freeCamEnabled = false
local freeCamSpeed = 50
local camera = workspace.CurrentCamera

local freeCamPos = Vector3.new(0, 50, 0)
local freeCamYaw = 0
local freeCamPitch = 0

-- Mobile joystick state
local joystickTouchId = nil
local joystickStartPos = nil
local joystickCurrentPos = nil
local lookTouchId = nil
local lookLastPos = nil

-- Mobile joystick UI
local joystickBase = create("Frame", {
	Name = "JoystickBase",
	Size = UDim2.fromOffset(100, 100),
	Position = UDim2.new(0, 20, 1, -120),
	BackgroundColor3 = Color3.fromRGB(50, 50, 60),
