local joystickKnob = create("Frame", {
	Name = "Knob",
	Size = UDim2.fromOffset(40, 40),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.5, 0),
	BackgroundColor3 = Color3.fromRGB(100, 150, 220),
