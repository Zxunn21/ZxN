-- Menyembunyikan/menampilkannya tubuh karakter
local function setCharacterVisible(visible)
	local char = player.Character
	if not char then return end

	if not visible then
		savedTransparencies = {}
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") or part:IsA("Decal") then
				savedTransparencies[part] = part.LocalTransparencyModifier
				part.LocalTransparencyModifier = 1
			end
		end
	else
		for part, alpha in pairs(savedTransparencies) do
			if part and part.Parent then
				part.LocalTransparencyModifier = alpha
			end
		end
		savedTransparencies = {}
	end
end

local function startFreeCam()
	if freeCamEnabled then return end
	local char = player.Character
	if not char then return end

	freeCamEnabled = true

	-- Mengubah kamera menjadi mode Lock First Person secara otomatis
	player.CameraMode = Enum.CameraMode.LockFirstPerson

	-- Menyembunyikan model karakter agar terasa seperti kamera terbang
	setCharacterVisible(false)

	-- Mengaktifkan Noclip agar kamera/karakter bisa bergerak bebas menembus dinding/udara
	noclipConnection = RunService.Stepped:Connect(function()
		if freeCamEnabled and player.Character then
			for _, part in ipairs(player.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
			-- Mencegah karakter jatuh terkena gravitasi
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Velocity = Vector3.zero
			end
		end
	end)

	mainFrame.Visible = false
	showPanelButton.Visible = true
	vertPad.Visible = true
end

local function stopFreeCam()
	if not freeCamEnabled then return end
	freeCamEnabled = false

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	-- Mengembalikan mode kamera ke default (Third Person)
	player.CameraMode = Enum.CameraMode.Classic
	setCharacterVisible(true)

	vertPad.Visible = false
	showPanelButton.Visible = false
	mainFrame.Visible = true
end

