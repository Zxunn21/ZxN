local function getCharacterPosition()
	local character = player.Character
	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end

	return root.Position
end

local function getObjectPosition(object)
	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		return object:GetPivot().Position
	end

	return nil
end

local function clearTargets()
	table.clear(targets)
	currentIndex = 0
end

local spectateActive = false
local spectateObject = nil
local spectateYaw = 0
local spectatePitch = math.rad(-15)
local spectateDistance = 30
local isDragging = false
local smoothedPosition = nil

local function getSmoothedPosition(object)
	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		return object:GetPivot().Position
	end

	return nil
end

local function cameraToTarget(object)
	if not object then
		return
	end

	local position = getSmoothedPosition(object)
	if not position then
		return
	end

	camera.CameraType = Enum.CameraType.Scriptable

	local camPos = camera.CFrame.Position
	local diff = camPos - position

	if diff.Magnitude > 0.5 then
		spectateYaw = math.atan2(diff.X, diff.Z)
		spectatePitch = math.atan2(diff.Y, math.sqrt(diff.X * diff.X + diff.Z * diff.Z))
		spectateDistance = math.clamp(diff.Magnitude, 10, 300)
	else
		spectateYaw = 0
		spectatePitch = math.rad(-15)
		spectateDistance = 30
	end

	spectateObject = object
	spectateActive = true
	smoothedPosition = position

	local offset = CFrame.fromOrientation(spectatePitch, spectateYaw, 0) * CFrame.new(0, 0, spectateDistance)
	camera.CFrame = CFrame.new(position) * offset
end

local function resetCamera()
	spectateActive = false
	spectateObject = nil
	isDragging = false
	smoothedPosition = nil
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	camera.CameraType = Enum.CameraType.Custom
end

RunService.RenderStepped:Connect(function()
	if not spectateActive or not spectateObject then
		return
	end

	if not spectateObject.Parent then
		resetCamera()
		return
	end

	local position = getSmoothedPosition(spectateObject)
	if not position then
		return
	end

	-- Smooth the object position so camera follows moving objects nicely
	smoothedPosition = smoothedPosition:Lerp(position, 0.15)

	spectatePitch = math.clamp(spectatePitch, math.rad(-80), math.rad(80))
	spectateDistance = math.clamp(spectateDistance, 5, 1000)

	-- Apply rotation directly (no lerp) so mouse control feels instant
	local offset = CFrame.fromOrientation(spectatePitch, spectateYaw, 0) * CFrame.new(0, 0, spectateDistance)
	camera.CFrame = CFrame.new(smoothedPosition) * offset
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if not spectateActive then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement and isDragging then
		spectateYaw = spectateYaw - input.Delta.X * 0.008
		spectatePitch = math.clamp(spectatePitch + input.Delta.Y * 0.008, math.rad(-80), math.rad(80))
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		spectateDistance = math.clamp(spectateDistance - input.Position.Z * 5, 5, 1000)
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not spectateActive then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isDragging = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isDragging = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)

local function searchObjects()
	clearTargets()

	local name = box.Text

	if name == "" then
		return
	end

	searchPosition = getCharacterPosition()

	if not searchPosition then
		return
	end

	local lowerName = string.lower(name)

	for _, object in ipairs(workspace:GetDescendants()) do
		local valid = false

		if searchType == "Part" then
			valid = object:IsA("BasePart")
		elseif searchType == "Model" then
			valid = object:IsA("Model")
		end

		if valid and string.lower(object.Name) == lowerName then
			local position = getObjectPosition(object)

			if position then
				local distance = (position - searchPosition).Magnitude

				table.insert(targets, {
					Object = object,
					Distance = distance
				})
			end
		end
	end

	table.sort(targets, function(a, b)
		return a.Distance < b.Distance
	end)

	if #targets > 0 then
		currentIndex = 1
		cameraToTarget(targets[currentIndex].Object)
	end
end

local function setFindMode(isFinding)
	if isFinding then
		findBtn.Text = "Find"
		findBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
	else
		findBtn.Text = "Reset"
		findBtn.BackgroundColor3 = Color3.fromRGB(160, 120, 50)
	end
end

local function selectTarget(index)
	if #targets == 0 then
		return
	end

	if index < 1 then
		index = #targets
	elseif index > #targets then
		index = 1
	end

	currentIndex = index

	local target = targets[currentIndex]

	if target and target.Object then
		cameraToTarget(target.Object)
	end
end

