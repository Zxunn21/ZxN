-- Fungsi mencari teks di dalam Part
local function getOfferingText(partName)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == partName then
            for _, gui in ipairs(obj:GetDescendants()) do
                if gui:IsA("SurfaceGui") or gui:IsA("BillboardGui") then
                    for _, child in ipairs(gui:GetDescendants()) do
                        if child:IsA("TextLabel") then
                            return child.Text
                        end
                    end
                end
            end

            return "TextLabel tidak ditemukan"
        end
    end

    return "Part tidak ditemukan"
end

-- Membersihkan teks offering agar hanya nama model yang tersisa.
-- Contoh: "0/1 Glimmering Pumpkin" -> "Pumpkin"
-- Mendukung variasi ejaan "Glimering" juga.
local function getFruitName(offeringText)
    if not offeringText or offeringText == "" then
        return nil
    end

    local cleaned = offeringText
    cleaned = cleaned:gsub("^%s*%d+%s*/%s*%d+%s*", "")
    cleaned = cleaned:gsub("^%s*[Gg]lim+ering%s+", "")
    cleaned = cleaned:gsub("^%s*[Gg]limmering%s+", "")
    cleaned = cleaned:gsub("^%s+", ""):gsub("%s+$", "")

    if cleaned == "" then
        return nil
    end

    return cleaned
end

-- Cari ProximityPrompt secara GLOBAL di seluruh Workspace.
-- Semua Model dengan nama yang cocok akan diperiksa, termasuk model yang
-- tersembunyi jauh di dalam root/folder/model lain. Jika satu model tidak
-- mempunyai ProximityPrompt, pencarian TIDAK berhenti dan lanjut ke kandidat lain.
local function findFruitPrompt(fruitName)
    if not fruitName or fruitName == "" then
        return nil
    end

    local targetName = fruitName:lower()

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower() == targetName then
            -- Prompt bisa berada langsung di model maupun jauh di dalam
            -- Part / MeshPart / Attachment / Model anak.
            local directPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
            if directPrompt and directPrompt.Enabled then
                return directPrompt
            end

            for _, descendant in ipairs(obj:GetDescendants()) do
                if descendant:IsA("ProximityPrompt") and descendant.Enabled then
                    return descendant
                end
            end

            -- Jangan return nil di sini. Bisa ada Model lain dengan nama sama
            -- pada root lain yang mempunyai ProximityPrompt aktif.
        end
    end

    return nil
end

