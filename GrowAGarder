    submitPressToken = submitPressToken + 1
    if submitButton.Parent then
        submitButton.Text = "Submit"
        submitButton.BackgroundColor3 = Color3.fromRGB(78, 105, 190)
    end
    showTemporaryStatus("Submit loop mati", 1.5)
end

local function startSubmitLoop()
    if submitLoopActive then
        return
    end

    submitLoopActive = true
    local loopToken = submitPressToken
    submitButton.Text = "Loop ON"
    submitButton.BackgroundColor3 = Color3.fromRGB(54, 145, 88)
    showTemporaryStatus("Submit loop aktif", 1.5)

    task.spawn(function()
        while screenGui.Parent and submitLoopActive and submitPressToken == loopToken do
            fireSubmitEvent()
            task.wait(SUBMIT_LOOP_INTERVAL)
        end
    end)
end

submitButton.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    -- Jika loop sedang aktif, tekanan berikutnya langsung mematikannya.
    -- Release dari tekanan ini tidak boleh dianggap sebagai submit tunggal.
    if submitLoopActive then
        suppressSubmitRelease = true
        submitPressed = false
        stopSubmitLoop()
        return
    end

    suppressSubmitRelease = false
    submitPressed = true
    submitPressToken = submitPressToken + 1
    local myToken = submitPressToken

    task.spawn(function()
        task.wait(SUBMIT_HOLD_THRESHOLD)

        if not submitPressed
            or submitPressToken ~= myToken
            or submitLoopActive then
            return
        end

        -- Setelah ditahan 1 detik, loop menjadi toggle permanen.
        -- Melepas tombol sesudah ini tidak menghentikannya.
        startSubmitLoop()
    end)
end)

submitButton.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if suppressSubmitRelease then
        suppressSubmitRelease = false
        return
    end

    local wasLoop = submitLoopActive
    submitPressed = false

    -- Jika hold belum mengaktifkan loop, ini adalah klik singkat.
    if not wasLoop then
        submitPressToken = submitPressToken + 1
        if fireSubmitEvent() then
            showTemporaryStatus("Submit dikirim", 1.5)
        end
    end
end)

-- Update teks
task.spawn(function()
    while screenGui.Parent do
        for i, offeringName in ipairs(OFFERING_NAMES) do
            local rawText = getOfferingText(offeringName)
            local fruitName = getFruitName(rawText)

            -- Ambil value seperti 0/1 atau 1/1 dari teks offering.
            -- Jika teks/value yang ditemukan masih mengandung kata "Offering",
            -- status dianggap belum memiliki target dan ditampilkan sebagai 0/0.
            local statusValue = "0/0"
            if rawText and not tostring(rawText):lower():find("offering", 1, true) then
                local current, total = tostring(rawText):match("(%d+)%s*/%s*(%d+)")
                if current and total then
                    statusValue = current .. "/" .. total
                end
            end

            offeringStatuses[i] = statusValue
            valueStatusLabels[i].Text = statusValue
            textLabels[i].Text = fruitName or rawText
        end

        task.wait(REFRESH_INTERVAL)
    end
end)

