local function minimizeGui()
    -- Trigger muncul di posisi kiri-atas window agar perpindahan terasa natural.
    triggerButton.Position = main.Position
    main.Visible = false
    triggerButton.Visible = true
end

local function restoreGui()
    -- Saat dibuka kembali, window mengikuti posisi trigger terakhir.
    main.Position = triggerButton.Position
    triggerButton.Visible = false
    main.Visible = true
end

minimizeButton.Activated:Connect(minimizeGui)

-- HANYA topbar yang menerima perintah drag untuk Main.
-- Tombol Minimize dan Submit dikecualikan dari area drag.
local dragging = false
local dragStart
local startPosition
local activeInput

local function isInsideGuiObject(guiObject, position)
    if not guiObject or not guiObject.Visible then
        return false
    end
    local p = guiObject.AbsolutePosition
    local s = guiObject.AbsoluteSize
    return position.X >= p.X and position.X <= p.X + s.X
        and position.Y >= p.Y and position.Y <= p.Y + s.Y
end

topbar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        if isInsideGuiObject(submitButton, input.Position)
            or isInsideGuiObject(minimizeButton, input.Position) then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = main.Position
        activeInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == activeInput
        or input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        activeInput = nil
    end
end)

-- Drag khusus trigger GaG. Jika hanya tap tanpa gerakan berarti restore GUI.
local triggerDragging = false
local triggerMoved = false
local triggerDragStart
local triggerStartPosition
local triggerActiveInput
local TRIGGER_DRAG_THRESHOLD = 6

triggerButton.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    triggerDragging = true
    triggerMoved = false
    triggerDragStart = input.Position
    triggerStartPosition = triggerButton.Position
    triggerActiveInput = input
end)

UserInputService.InputChanged:Connect(function(input)
    if triggerDragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - triggerDragStart
        if math.abs(delta.X) >= TRIGGER_DRAG_THRESHOLD or math.abs(delta.Y) >= TRIGGER_DRAG_THRESHOLD then
            triggerMoved = true
        end

        triggerButton.Position = UDim2.new(
            triggerStartPosition.X.Scale,
            triggerStartPosition.X.Offset + delta.X,
            triggerStartPosition.Y.Scale,
            triggerStartPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not triggerDragging then
        return
    end

    if input == triggerActiveInput
        or input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        local wasMoved = triggerMoved
        triggerDragging = false
        triggerActiveInput = nil

        if not wasMoved and triggerButton.Visible then
            restoreGui()
        end
    end
end)
