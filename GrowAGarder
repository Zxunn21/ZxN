-- Ambil posisi dunia dari ProximityPrompt, baik prompt berada di BasePart
-- maupun di Attachment yang berada di dalam part.
local function getPromptWorldPosition(prompt)
    local parent = prompt and prompt.Parent
    if not parent then
        return nil
    end

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    local ancestor = parent:FindFirstAncestorWhichIsA("BasePart")
    return ancestor and ancestor.Position or nil
end

-- Eksekusi prompt dengan mendekatkan karakter sementara ke prompt.
-- CFrame awal selalu dicoba dipulihkan setelah eksekusi selesai.
local function executePrompt(prompt)
    if not prompt or not prompt.Parent then
        return false, "Prompt sudah tidak tersedia"
    end

    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart")
    local promptPosition = getPromptWorldPosition(prompt)

    if not root then
        return false, "HumanoidRootPart tidak ditemukan"
    end
    if not promptPosition then
        return false, "Posisi ProximityPrompt tidak ditemukan"
    end

    local originalCFrame = root.CFrame
    local success = false
    local result = "Tidak ada metode eksekusi yang berhasil"

    local ok, err = pcall(function()
        -- Berdiri sedikit di atas/dekat prompt agar berada dalam activation distance.
        root.CFrame = CFrame.new(promptPosition + Vector3.new(0, 2.5, 0))
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.25)

        if type(fireproximityprompt) == "function" then
            local fired, fireErr = pcall(function()
                fireproximityprompt(prompt, math.max(prompt.HoldDuration, 0))
            end)
            if fired then
                success = true
                result = "Teleport + fireproximityprompt"
            else
                result = tostring(fireErr)
            end
        end

        if not success then
            local held, holdErr = pcall(function()
                prompt:InputHoldBegin()
                task.wait(math.max(prompt.HoldDuration, 0.05))
                prompt:InputHoldEnd()
            end)
            if held then
                success = true
                result = "Teleport + InputHoldBegin/End"
            else
                result = tostring(holdErr)
            end
        end

        -- Beri waktu singkat agar interaksi diproses sebelum kembali.
        task.wait(0.20)
    end)

    -- Restore tetap dilakukan walaupun eksekusi di atas error.
    if root and root.Parent then
        root.CFrame = originalCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if not ok then
        return false, tostring(err)
    end
    return success, result
end

local function startHarvestScan(index)
    local button = harvestButtons[index]
    if not button or not button.Parent then
        return
    end

    harvestScanning[index] = true
    harvestScanTokens[index] = harvestScanTokens[index] + 1
    local myToken = harvestScanTokens[index]

    button.Text = "Stop"
    button.BackgroundColor3 = Color3.fromRGB(180, 130, 45)

    task.spawn(function()
        while screenGui.Parent
            and harvestScanning[index]
            and harvestScanTokens[index] == myToken do

            -- Offering dibaca ulang SETIAP scan. Jadi bila offering berubah
            -- ketika scanner sedang berjalan, target ikut berubah otomatis.
            local offeringText = getOfferingText(OFFERING_NAMES[index])
            local fruitName = getFruitName(offeringText)

            if fruitName then
                local prompt = findFruitPrompt(fruitName)

                if prompt then
                    -- Prompt ditemukan. Hentikan scanner sebelum mencoba panen
                    -- agar tidak terjadi trigger berulang.
                    harvestScanning[index] = false

                    if button.Parent then
                        button.Text = "Panen..."
                        button.BackgroundColor3 = Color3.fromRGB(55, 125, 175)
                    end

                    local promptPath = prompt:GetFullName()
                    showTemporaryStatus("Proximity ditemukan: " .. promptPath, 3)

                    local ok, methodOrError = executePrompt(prompt)

                    if button.Parent then
                        if ok then
                            button.Text = "Dikirim"
                            button.BackgroundColor3 = Color3.fromRGB(55, 125, 175)
                            showTemporaryStatus("Prompt dieksekusi: " .. tostring(methodOrError), 3)
                        else
                            warn("Gagal mengaktifkan ProximityPrompt:", methodOrError)
                            button.Text = "Gagal"
                            button.BackgroundColor3 = Color3.fromRGB(160, 65, 65)
                            showTemporaryStatus("Prompt ditemukan, eksekusi gagal", 3)
                        end
                    end

                    task.wait(1.2)

                    -- Jangan menimpa tampilan bila pengguna sudah memulai scan
                    -- baru selama jeda status hasil.
                    if harvestScanTokens[index] == myToken then
                        setHarvestIdle(button)
                    end

                    return
                end
            end

            -- Tidak ditemukan? Jangan berhenti. Tetap scan seluruh Workspace
            -- sampai prompt muncul atau pengguna menekan tombol lagi.
            if button.Parent then
                button.Text = "Stop"
                button.BackgroundColor3 = Color3.fromRGB(180, 130, 45)
            end

            task.wait(SCAN_INTERVAL)
        end

        if harvestScanTokens[index] == myToken then
            setHarvestIdle(button)
        end
    end)
end

-- Tombol Panen mempunyai dua mode:
-- tap singkat = scanner manual seperti sebelumnya (berjalan sampai ditemukan / ditekan lagi)
-- tahan >= 1 detik = mode LOOP otomatis.
-- Dalam LOOP: hanya bekerja saat status 0/1, setiap percobaan scan maksimal 3 detik.
-- Jika belum ditemukan, tunggu 5 detik lalu cek status dan ulangi.
-- LOOP tetap aktif saat 1/1 atau 0/0 (idle/watch), dan otomatis panen lagi saat berubah menjadi 0/1.
local harvestLoopActive = {false, false, false}
local harvestPressed = {false, false, false}
local harvestPressTokens = {0, 0, 0}
local harvestLoopTokens = {0, 0, 0}
local suppressHarvestRelease = {false, false, false}
local HARVEST_HOLD_THRESHOLD = 1.0
local HARVEST_LOOP_SCAN_TIMEOUT = 3.0
local HARVEST_LOOP_RETRY_DELAY = 5.0

local function setHarvestLoopVisual(index)
    local button = harvestButtons[index]
    if button and button.Parent then
        button.Text = "Loop ON"
        button.BackgroundColor3 = Color3.fromRGB(54, 145, 88)
    end
end

local function stopHarvestLoop(index, message)
    harvestLoopActive[index] = false
    harvestLoopTokens[index] = harvestLoopTokens[index] + 1
    harvestPressed[index] = false

    if harvestScanning[index] then
        stopHarvestScan(index)
    else
        setHarvestIdle(harvestButtons[index])
    end

    if message then
        showTemporaryStatus(message, 1.8)
    end
end

-- Satu percobaan panen untuk mode loop. Fungsi ini hanya memindai sampai
-- timeout, sehingga satu siklus tidak akan menggantung jika model/prompt belum muncul.
local function runTimedHarvestAttempt(index, loopToken)
    local deadline = os.clock() + HARVEST_LOOP_SCAN_TIMEOUT
    local button = harvestButtons[index]

    while screenGui.Parent
        and harvestLoopActive[index]
        and harvestLoopTokens[index] == loopToken
        and os.clock() < deadline do

        -- Status dapat berubah sewaktu scanner berjalan.
        if offeringStatuses[index] ~= "0/1" then
            return "status_changed"
        end

        local offeringText = getOfferingText(OFFERING_NAMES[index])
        local fruitName = getFruitName(offeringText)

        if fruitName then
            local prompt = findFruitPrompt(fruitName)
            if prompt then
                if button and button.Parent then
                    button.Text = "Panen..."
                    button.BackgroundColor3 = Color3.fromRGB(55, 125, 175)
                end

                showTemporaryStatus("Proximity ditemukan: " .. prompt:GetFullName(), 3)
                local ok, methodOrError = executePrompt(prompt)

                if ok then
                    showTemporaryStatus("Prompt dieksekusi: " .. tostring(methodOrError), 3)
                    return "executed"
                else
                    warn("Gagal mengaktifkan ProximityPrompt:", methodOrError)
                    showTemporaryStatus("Prompt ditemukan, eksekusi gagal", 3)
                    -- Tetap lanjut sampai batas 3 detik; mungkin ada kesempatan berikutnya.
                end
            end
        end

        if button and button.Parent then
            button.Text = "Loop ON"
            button.BackgroundColor3 = Color3.fromRGB(54, 145, 88)
        end
        task.wait(SCAN_INTERVAL)
    end

    return "timeout"
end

local function startHarvestLoop(index)
    if harvestLoopActive[index] then
        return
    end

    -- Pastikan scanner manual lama tidak ikut berjalan bersamaan.
    if harvestScanning[index] then
        stopHarvestScan(index)
    end

    harvestLoopActive[index] = true
    harvestLoopTokens[index] = harvestLoopTokens[index] + 1
    local myLoopToken = harvestLoopTokens[index]
    setHarvestLoopVisual(index)
    showTemporaryStatus("Panen " .. index .. " loop aktif", 1.5)

    task.spawn(function()
        while screenGui.Parent
            and harvestLoopActive[index]
            and harvestLoopTokens[index] == myLoopToken do

            local status = offeringStatuses[index]

            -- WATCH MODE: loop tetap aktif pada 1/1 atau 0/0, tetapi idle.
            -- Panen hanya dijalankan ketika status berubah menjadi 0/1.
            if status == "1/1" or status == "0/0" then
                setHarvestLoopVisual(index)
                task.wait(0.25)
            elseif status == "0/1" then
                setHarvestLoopVisual(index)
                local result = runTimedHarvestAttempt(index, myLoopToken)

                if not harvestLoopActive[index] or harvestLoopTokens[index] ~= myLoopToken then
                    return
                end

                -- Setelah eksekusi beri kesempatan monitor memperbarui value.
                if result == "executed" then
                    task.wait(0.75)
                end

                status = offeringStatuses[index]
                if status == "1/1" or status == "0/0" then
                    -- Tetap dalam Loop ON. Tidak melakukan apa pun sampai 0/1 muncul lagi.
                    setHarvestLoopVisual(index)
                end

                -- Tidak ditemukan dalam 3 detik / status masih 0/1:
                -- berhenti mencari dan tunggu 5 detik sebelum siklus berikutnya.
                setHarvestLoopVisual(index)
                local waited = 0
                while waited < HARVEST_LOOP_RETRY_DELAY
                    and screenGui.Parent
                    and harvestLoopActive[index]
                    and harvestLoopTokens[index] == myLoopToken do

                    local currentStatus = offeringStatuses[index]
                    if currentStatus == "1/1" or currentStatus == "0/0" then
                        -- Keluar dari waktu tunggu dan kembali ke watch mode, bukan mematikan loop.
                        break
                    end

                    task.wait(0.25)
                    waited = waited + 0.25
                end
            else
                -- Status lain yang belum stabil: jangan spam scanner.
                task.wait(0.25)
            end
        end
    end)
end

for i, button in ipairs(harvestButtons) do
    button.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        -- Tekan ketika loop aktif = langsung matikan loop.
        if harvestLoopActive[i] then
            suppressHarvestRelease[i] = true
            stopHarvestLoop(i, "Panen " .. i .. " loop mati")
            return
        end

        -- Tekan ketika scanner manual aktif = hentikan scanner manual.
        if harvestScanning[i] then
            suppressHarvestRelease[i] = true
            stopHarvestScan(i)
            showTemporaryStatus("Pencarian panen " .. i .. " dihentikan", 1.5)
            return
        end

        suppressHarvestRelease[i] = false
        harvestPressed[i] = true
        harvestPressTokens[i] = harvestPressTokens[i] + 1
        local myPressToken = harvestPressTokens[i]

        task.spawn(function()
            task.wait(HARVEST_HOLD_THRESHOLD)
            if harvestPressed[i]
                and harvestPressTokens[i] == myPressToken
                and not harvestLoopActive[i]
                and not harvestScanning[i] then

                -- Hold 1 detik mengaktifkan toggle loop dan tetap hidup setelah dilepas.
                startHarvestLoop(i)
            end
        end)
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if suppressHarvestRelease[i] then
            suppressHarvestRelease[i] = false
            harvestPressed[i] = false
            return
        end

        local becameLoop = harvestLoopActive[i]
        harvestPressed[i] = false
        harvestPressTokens[i] = harvestPressTokens[i] + 1

        -- Jika belum mencapai hold 1 detik, jalankan scanner manual lama.
        if not becameLoop then
            startHarvestScan(i)
        end
    end)
end

-- Submit:
-- klik singkat saat idle = FireServer sekali
-- tahan >= 1 detik = MASUK mode loop permanen (tetap loop walaupun tombol dilepas)
-- saat mode loop aktif, tekan tombol sekali lagi = MATIKAN loop
local submitPressed = false
local submitPressToken = 0
local submitLoopActive = false
local suppressSubmitRelease = false
local SUBMIT_HOLD_THRESHOLD = 1.0
local SUBMIT_LOOP_INTERVAL = 3

local function fireSubmitEvent()
    local ok, err = pcall(function()
        local Event = ReplicatedStorage.GameEvents.Events.FairyEvent.SubmitFairyFountainAllPlants
        Event:FireServer()
    end)
    if not ok then
        warn("Submit gagal:", err)
        showTemporaryStatus("Submit gagal", 2)
    end
    return ok
end

