--==================================================
-- LOAD TREES
--==================================================

local function loadTrees()

	clearList()

	local folders = findTreeFolders()

	local models = {}

	for _, folder in ipairs(folders) do

		for _, obj in ipairs(folder:GetChildren()) do

			if obj:IsA("Model") then

				local height = getModelHeight(obj)

				table.insert(models, {
					model = obj,
					height = height
				})

			end

		end

	end

	table.sort(models, function(a, b)
		return a.height > b.height
	end)

	local amount = math.min(MAX_RESULTS, #models)

	for i = 1, amount do

		createRow(
			i,
			models[i].model,
			models[i].height
		)

	end

	if amount == 0 then

		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -10, 0, 50)
		empty.BackgroundTransparency = 1
		empty.Text = "Tidak ditemukan Model.\nCek FOLDER_NAMES."
		empty.TextColor3 = Color3.fromRGB(200, 200, 200)
		empty.TextSize = 14
		empty.Font = Enum.Font.Gotham
		empty.Parent = scroll

	end

end

