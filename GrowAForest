	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(90, 34)
	button.Position = UDim2.new(1, -100, 0.5, -17)
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 11
	button.Font = Enum.Font.GothamBold
	button.Parent = row

	makeCorner(button, 6)

	local function refresh()

		local biome = findBiome(name)

		if not biome then

			button.Text = "DELETED"
			button.BackgroundColor3 =
				Color3.fromRGB(90, 90, 90)

			deletedBiomes[name] = true

		else

			button.Text = "DELETE"
			button.BackgroundColor3 =
				Color3.fromRGB(170, 70, 70)

			deletedBiomes[name] = false

		end

	end

	button.MouseButton1Click:Connect(function()

		local biome = findBiome(name)

		if biome then

			biome:Destroy()

			deletedBiomes[name] = true

		end

		refresh()

		lastResultsKey = ""

		updateList()

	end)

	refresh()

	return row

end

for index, name in ipairs(FOLDER_NAMES) do
	createBiomeRow(name, index)
end

