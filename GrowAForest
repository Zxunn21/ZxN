local function findTreeFolders()

	local folders = {}

	for _, name in ipairs(FOLDER_NAMES) do

		local obj = workspace:FindFirstChild(name, true)

		if obj and obj:IsA("Folder") then
			table.insert(folders, obj)
		end

	end

	return folders
end

--==================================================
-- GET MODEL HEIGHT
--==================================================

local function getModelHeight(model)

	if not model or not model.Parent then
		return 0
	end

	local success, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)

	if success and size then
		return size.Y
	end

	return 0
end

--==================================================
-- LINE SYSTEM
--==================================================

local activeLines = {}

local function removeLine(model)

	local data = activeLines[model]

	if not data then
		return
	end

	if data.beam then
		data.beam:Destroy()
	end

	if data.playerAttachment then
		data.playerAttachment:Destroy()
	end

	if data.objectAttachment then
		data.objectAttachment:Destroy()
	end

	activeLines[model] = nil
end

local function createLine(model)

	if activeLines[model] then
		removeLine(model)
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local targetPart

	if model:IsA("BasePart") then
		targetPart = model
	else

		targetPart = model.PrimaryPart

		if not targetPart then
			targetPart = model:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
		end

	end

	if not targetPart then
		return false
	end

	local playerAttachment = Instance.new("Attachment")
	playerAttachment.Name = "GrowAForest_PlayerLine"
	playerAttachment.Parent = root

	local objectAttachment = Instance.new("Attachment")
	objectAttachment.Name = "GrowAForest_ObjectLine"
	objectAttachment.Parent = targetPart

	local beam = Instance.new("Beam")
	beam.Name = "GrowAForest_Line"
	beam.Attachment0 = playerAttachment
	beam.Attachment1 = objectAttachment
	beam.Width0 = 0.08
	beam.Width1 = 0.08
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Parent = root

	activeLines[model] = {
		beam = beam,
		playerAttachment = playerAttachment,
		objectAttachment = objectAttachment
	}

	return true
end

