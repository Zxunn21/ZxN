local function findTreeFolders()

	local folders = {}

	for _, name in ipairs(FOLDER_NAMES) do

		local obj = workspace:FindFirstChild(name, true)

		if obj and (obj:IsA("Folder") or obj:IsA("Model")) then
			table.insert(folders, obj)
		end

	end

	return folders
end

--==================================================
-- GET BASEPARTS
--==================================================

local function getBaseParts(container)

	local parts = {}

	if not container then
		return parts
	end

	if container:IsA("BasePart") then
		table.insert(parts, container)
	end

	for _, obj in ipairs(container:GetDescendants()) do

		if obj:IsA("BasePart") then
			table.insert(parts, obj)
		end

	end

	return parts
end

--==================================================
-- NEW HEIGHT METHOD
--==================================================

local function getModelHeight(model)

	if not model or not model.Parent then
		return -math.huge
	end

	local parts = getBaseParts(model)

	if #parts == 0 then
		return -math.huge
	end

	local highestY = -math.huge

	for _, part in ipairs(parts) do

		if part:IsDescendantOf(workspace) then

			local y = part.Position.Y

			if y > highestY then
				highestY = y
			end

		end

	end

	return highestY
end

--==================================================
-- TARGET PART FOR LINE
--==================================================

local function getTargetPart(model)

	if not model or not model.Parent then
		return nil
	end

	if model:IsA("BasePart") then
		return model
	end

	if model:IsA("Model") then

		if model.PrimaryPart
			and model.PrimaryPart:IsA("BasePart") then

			return model.PrimaryPart

		end

	end

	local parts = getBaseParts(model)

	if #parts == 0 then
		return nil
	end

	-- Cari part yang paling tinggi
	local highestPart = nil
	local highestY = -math.huge

	for _, part in ipairs(parts) do

		if part.Position.Y > highestY then

			highestY = part.Position.Y
			highestPart = part

		end

	end

	return highestPart

end

--==================================================
-- LINE SYSTEM
--==================================================

local activeLines = {}

local function removeLine(model)

	local data = activeLines[model]

	if not data then
		return
	end

	if data.beam then
		data.beam:Destroy()
	end

	if data.playerAttachment then
		data.playerAttachment:Destroy()
	end

	if data.objectAttachment then
		data.objectAttachment:Destroy()
	end

	activeLines[model] = nil

end

local function createLine(model)

	if activeLines[model] then

		removeLine(model)

		return false

	end

	if not model or not model.Parent then
		return false
	end

	local character = player.Character

	if not character then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local targetPart = getTargetPart(model)

	if not targetPart then
		return false
	end

	local playerAttachment = Instance.new("Attachment")
	playerAttachment.Name = "GrowAForest_PlayerLine"
	playerAttachment.Parent = root

	local objectAttachment = Instance.new("Attachment")
	objectAttachment.Name = "GrowAForest_ObjectLine"
	objectAttachment.Parent = targetPart

	local beam = Instance.new("Beam")
	beam.Name = "GrowAForest_Line"
	beam.Attachment0 = playerAttachment
	beam.Attachment1 = objectAttachment
	beam.Width0 = 0.08
	beam.Width1 = 0.08
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Parent = root

	activeLines[model] = {
		beam = beam,
		playerAttachment = playerAttachment,
		objectAttachment = objectAttachment,
		targetPart = targetPart
	}

	return true

end

