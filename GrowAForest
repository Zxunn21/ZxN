--==================================================
-- GET MODEL CANDIDATES
--==================================================

local function getModelCandidates(folder)

	local candidates = {}

	if folder:IsA("Model") then
		table.insert(candidates, folder)
	end

	for _, obj in ipairs(folder:GetDescendants()) do

		if obj:IsA("Model") then
			table.insert(candidates, obj)
		end

	end

	return candidates

end

--==================================================
-- FIND HIGHEST MODEL
--==================================================

local function getHighestModels()

	local folders = findTreeFolders()

	local results = {}

	for _, folder in ipairs(folders) do

		local highestModel = nil
		local highestHeight = -math.huge

		local candidates = getModelCandidates(folder)

		for _, model in ipairs(candidates) do

			if model.Parent then

				local height = getModelHeight(model)

				if height > highestHeight then

					highestHeight = height
					highestModel = model

				end

			end

		end

		-- Fallback jika folder hanya berisi Part
		if not highestModel then

			local parts = getBaseParts(folder)

			local highestPart = nil
			local highestPartHeight = -math.huge

			for _, part in ipairs(parts) do

				if part.Position.Y > highestPartHeight then
					highestPartHeight = part.Position.Y
					highestPart = part
				end

			end

			if highestPart then

				highestModel = highestPart
				highestHeight = highestPartHeight

			end

		end

		if highestModel then

			table.insert(results, {
				folder = folder,
				model = highestModel,
				height = math.max(0, highestHeight)
			})

		end

	end

	table.sort(results, function(a, b)

		return a.height > b.height

	end)

	return results

end

--==================================================
-- UPDATE LIST
--==================================================

local lastResultsKey = ""

local function updateList()

	local results = getHighestModels()

	local resultKey = ""

	for _, data in ipairs(results) do

		resultKey =
			resultKey
			.. data.folder:GetFullName()
			.. "|"
			.. data.model:GetFullName()
			.. "|"
			.. string.format("%.2f", data.height)
			.. ";"

	end

	if resultKey == lastResultsKey then
		return
	end

	lastResultsKey = resultKey

	for index = #results + 1, #rows do

		if rows[index] and rows[index].row then
			rows[index].row:Destroy()
		end

		rows[index] = nil

	end

	for index, data in ipairs(results) do

		local rowData = rows[index]

		if not rowData then
			rowData = createRow(index)
		end

		rowData.row.LayoutOrder = index

		rowData.folderLabel.Text =
			data.folder.Name

		rowData.nameLabel.Text =
			data.model.Name

		rowData.heightLabel.Text =
			string.format(
				"Height: %.2f studs",
				data.height
			)

		if rowData.model ~= data.model then

			if rowData.model
				and activeLines[rowData.model] then

				removeLine(rowData.model)

			end

			rowData.model = data.model

			rowData.lineButton.Text = "LINE"

			rowData.lineButton.BackgroundColor3 =
				Color3.fromRGB(70, 100, 170)

		end

	end

	for model, data in pairs(activeLines) do

		if not model
			or not model.Parent
			or not data.targetPart
			or not data.targetPart.Parent then

			removeLine(model)

		end

	end

end

