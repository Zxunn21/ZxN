local function disconnectTool(tool)
    local connections = toolConnections[tool]
    if connections then
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
        toolConnections[tool] = nil
    end
end

local function connectLightTool(tool)
    if not tool:IsA("Tool") or tool.Name ~= "Light" then
        return
    end

    if toolConnections[tool] then
        return
    end

    local connections = {}

    -- Equipped/Unequipped are retained as the primary signals.
    table.insert(connections, tool.Equipped:Connect(function()
        if mainFrame and mainFrame.Parent then
            mainFrame.Visible = true
        end
    end))

    table.insert(connections, tool.Unequipped:Connect(function()
        if mainFrame and mainFrame.Parent then
            mainFrame.Visible = false
        end
    end))

    table.insert(connections, tool.AncestryChanged:Connect(function()
        if not tool:IsDescendantOf(player) then
            if mainFrame and mainFrame.Parent then
                mainFrame.Visible = false
            end
            disconnectTool(tool)
        end
    end))

    toolConnections[tool] = connections

    if player.Character and tool.Parent == player.Character then
        mainFrame.Visible = true
    end
end

local function monitorToolContainer(container)
    if not container then
        return
    end

    container.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and child.Name == "Light" then
            connectLightTool(child)
        end
    end)

    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Tool") and child.Name == "Light" then
            connectLightTool(child)
        end
    end
end

local function ensureLightTool()
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then
        backpack = player:WaitForChild("Backpack")
    end

    local character = player.Character
    local existing = backpack:FindFirstChild("Light")

    if not existing and character then
        existing = character:FindFirstChild("Light")
    end

    if existing and existing:IsA("Tool") then
        lightTool = existing
        connectLightTool(existing)
        return existing
    end

    local tool = Instance.new("Tool")
    tool.Name = "Light"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.ToolTip = "Equip to open Lighting controls"
    tool.Parent = backpack

    lightTool = tool
    connectLightTool(tool)

    return tool
end

local wasLightEquipped = false

local backpack = player:WaitForChild("Backpack")
monitorToolContainer(backpack)

if player.Character then
    monitorToolContainer(player.Character)
end

local toolCharacterConnection = player.CharacterAdded:Connect(function(character)
    monitorToolContainer(character)
    wasLightEquipped = false
    mainFrame.Visible = false
    task.defer(ensureLightTool)
end)

ensureLightTool()

-- Fallback: some environments do not reliably fire Tool.Equipped.
-- Detect the Tool moving into/out of the Character and react only on state changes.
task.spawn(function()
    while screenGui.Parent do
        local character = player.Character
        local equipped = false

        if character then
            local tool = character:FindFirstChild("Light")
            equipped = tool ~= nil and tool:IsA("Tool")
        end

        if equipped ~= wasLightEquipped then
            wasLightEquipped = equipped

            if mainFrame and mainFrame.Parent then
                mainFrame.Visible = equipped
            end
        end

        task.wait(0.15)
    end
end)

screenGui.Destroying:Connect(function()
    if characterAddedConnection then
        characterAddedConnection:Disconnect()
        characterAddedConnection = nil
    end

    if toolCharacterConnection then
        toolCharacterConnection:Disconnect()
        toolCharacterConnection = nil
    end

    for tool in pairs(toolConnections) do
        disconnectTool(tool)
    end
end)
