toggleButton.MouseButton1Click:Connect(function()
	isTorchOn = not isTorchOn

	if isTorchOn then
		toggleButton.Text = "Orb: ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		createTorch()
	else
		toggleButton.Text = "Orb: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		cleanupTorch()
	end
end)

local characterAddedConnection = player.CharacterAdded:Connect(function(newCharacter)
	local head = newCharacter:WaitForChild("Head", 10)

	if isTorchOn then
		isTorchOn = false
		cleanupTorch()

		if toggleButton then
			toggleButton.Text = "Orb: OFF"
			toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		end
	end
end)

screenGui.Destroying:Connect(function()
	if characterAddedConnection then
		characterAddedConnection:Disconnect()
		characterAddedConnection = nil
	end
end)

local existingTorch = findExistingTorch()
if existingTorch then
	isTorchOn = true
	adoptExistingTorch(existingTorch)
	toggleButton.Text = "Orb: ON"
	toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
end
