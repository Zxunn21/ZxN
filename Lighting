local Players = game:GetService("Players")

local player = Players.LocalPlayer

local isTorchOn = false
local torchPart = nil
local torchLight = nil

local lightRange = 60
local lightBrightness = 2
local orbSize = 1

local LIGHT_COLOR = Color3.fromRGB(255, 255, 255)
local ORB_HEIGHT = 3

local toggleButton = nil

local function cleanupTorch()
	if torchPart then
		torchPart:Destroy()
		torchPart = nil
		torchLight = nil
	end

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") and string.match(descendant.Name, "^ZxN") then
			descendant:Destroy()
		end
	end
end

local function findExistingTorch()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") and (descendant.Name == "ZxN Orb" or descendant.Name == "ZxN Burn") then
			return descendant
		end
	end
	return nil
end

local function adoptExistingTorch(part)
	torchPart = part
	torchLight = part:FindFirstChildOfClass("PointLight")

	if not torchLight then
		local oldLight = part:FindFirstChildOfClass("SpotLight")
		if oldLight then oldLight:Destroy() end
		torchLight = Instance.new("PointLight")
		torchLight.Shadows = true
		torchLight.Parent = part
	end

	local oldFire = part:FindFirstChildOfClass("Fire")
	if oldFire then oldFire:Destroy() end

	local char = part.Parent
	if char then
		local oldShade = char:FindFirstChild("ZxN Shade")
		if oldShade then oldShade:Destroy() end
		local oldShade2 = char:FindFirstChild("ZxN Burn Shade")
		if oldShade2 then oldShade2:Destroy() end
	end

	torchPart.Shape = Enum.PartType.Ball
	torchPart.Material = Enum.Material.Neon
	torchPart.Color = LIGHT_COLOR
	torchPart.Transparency = 1
	torchPart.Size = Vector3.new(orbSize, orbSize, orbSize)

	if torchLight then
		torchLight.Color = LIGHT_COLOR
		torchLight.Range = lightRange
		torchLight.Brightness = lightBrightness
		torchLight.Shadows = true
	end
end

local function createTorch()
	local existing = findExistingTorch()
	if existing then
		adoptExistingTorch(existing)
		return
	end

	local char = player.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end

	torchPart = Instance.new("Part")
	torchPart.Name = "ZxN Orb"
	torchPart.Shape = Enum.PartType.Ball
	torchPart.Size = Vector3.new(orbSize, orbSize, orbSize)
	torchPart.Color = LIGHT_COLOR
	torchPart.Material = Enum.Material.Neon
	torchPart.Transparency = 1
	torchPart.CanCollide = false
	torchPart.Massless = true
	torchPart.Anchored = false

	torchLight = Instance.new("PointLight")
	torchLight.Color = LIGHT_COLOR
	torchLight.Range = lightRange
	torchLight.Brightness = lightBrightness
	torchLight.Shadows = true
	torchLight.Parent = torchPart

	torchPart.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + ORB_HEIGHT, 0)
	torchPart.Parent = char

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = torchPart
	weld.Parent = torchPart
end

