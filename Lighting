local function applyLightSettings()
    if torchLight then
        torchLight.Range = lightRange
        torchLight.Brightness = lightBrightness
    end
end

local function setRange(value)
    local n = tonumber(value)
    if n then
        lightRange = math.clamp(n, 1, 60)
        rangeBox.Text = tostring(lightRange)
        applyLightSettings()
    end
end

local function setBrightness(value)
    local n = tonumber(value)
    if n then
        lightBrightness = math.clamp(n, 0, 10)
        brightBox.Text = tostring(lightBrightness)
        applyLightSettings()
    end
end

local function setOrbSize(value)
    local n = tonumber(value)
    if n then
        orbSize = math.clamp(n, 0.5, 10)
        orbBox.Text = tostring(orbSize)
        if torchPart then
            torchPart.Size = Vector3.new(orbSize, orbSize, orbSize)
        end
    end
end

