-- =================================================================
-- 2. DRAGGABLE LOGIC (Top Bar)
-- =================================================================

local dragging = false
local dragInput, dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

topBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

-- =================================================================
-- 3. FITUR LOGIC CAMERA
-- =================================================================

local isFPP = false
local isTPP = false
local isMaxDist = false
local isNoClip = false

local function updateButtonState(button, state, text)
	if state then
		button.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.Text = text .. " [ON]"
	else
		button.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
		button.TextColor3 = Color3.fromRGB(200, 200, 200)
		button.Text = text .. " [OFF]"
	end
end

-- Toggle FPP
btnFPP.MouseButton1Click:Connect(function()
	isFPP = not isFPP
	if isFPP and isTPP then
		isTPP = false
		updateButtonState(btnTPP, false, "TPP Mode")
	end
	updateButtonState(btnFPP, isFPP, "FPP Mode")
end)

-- Toggle TPP
btnTPP.MouseButton1Click:Connect(function()
	isTPP = not isTPP
	if isTPP and isFPP then
		isFPP = false
		updateButtonState(btnFPP, false, "FPP Mode")
	end
	updateButtonState(btnTPP, isTPP, "TPP Mode")
end)

-- Toggle Max Distance
btnMaxDist.MouseButton1Click:Connect(function()
	isMaxDist = not isMaxDist
	updateButtonState(btnMaxDist, isMaxDist, "Max Dist")
end)

-- Toggle No Clip Camera
btnNoClip.MouseButton1Click:Connect(function()
	isNoClip = not isNoClip
	updateButtonState(btnNoClip, isNoClip, "No Clip Camera")
end)

-- Loop Utama Kamera
RunService.RenderStepped:Connect(function()
	-- 1. FPP Logic
	if isFPP then
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end

	-- 2. TPP Logic
	if isTPP then
		player.CameraMode = Enum.CameraMode.Classic
		if player.CameraMinZoomDistance < 10 then
			player.CameraMinZoomDistance = 10
		end
	end

	-- Reset jika keduanya mati
	if not isFPP and not isTPP and not isMaxDist then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 128
	end

	-- 3. Max Distance Logic
	if isMaxDist then
		local dist = tonumber(inputMaxDist.Text) or 5000
		player.CameraMaxZoomDistance = dist
	end

	-- 4. No Clip Camera Logic
	if isNoClip then
		player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
	else
		player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
	end
end)
