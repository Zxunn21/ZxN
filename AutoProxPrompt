-- Logika 1: Tombol Close (X) menutup panel
closeBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)

-- Logika 3: Topbar Draggable (geser panel dengan drag di header)
local dragging = false
local dragStart = nil
local startPos = nil

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

-- Helper: Ambil daftar nama prompt dari input teks (dipisah koma, CASE-INSENSITIVE)
local function getPromptNames()
	local names = {}
	for name in string.gmatch(promptInput.Text, "[^,]+") do
		name = string.gsub(name, "^%s+", "")
		name = string.gsub(name, "%s+$", "")
		if name ~= "" then
			table.insert(names, string.lower(name)) -- Simpan dalam huruf kecil
		end
	end
	return names
end

