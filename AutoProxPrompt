end)

-- Logika 5: Loop Aktivasi ProximityPrompt dengan Teleport
-- Pemain diteleport ke 1 prompt terdekat, eksekusi, lalu kembali ke posisi semula
local nameIndex = 1

local function executeTeleport()
	local names = getPromptNames()
	if #names == 0 then return end

	local currentName = names[nameIndex]
	nameIndex += 1
	if nameIndex > #names then
		nameIndex = 1
	end

	statusLabel.Text = "Status: ON | Target: " .. currentName

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local originalCFrame = hrp.CFrame

	-- Cari prompt terdekat dengan nama yang cocok
	local closestPrompt = nil
	local closestDist = math.huge

	for _, prompt in ipairs(workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") and string.lower(prompt.Name) == currentName then
			local targetPart = prompt:FindFirstAncestorWhichIsA("BasePart")
			if targetPart then
				local dist = (targetPart.Position - hrp.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closestPrompt = prompt
				end
			end
		end
	end

	if closestPrompt then
		closestPrompt.Enabled = true

		local targetPart = closestPrompt:FindFirstAncestorWhichIsA("BasePart")
		if targetPart then
			-- Teleport ke dekat prompt terdekat
			character:PivotTo(targetPart.CFrame * CFrame.new(0, 0, 3))
			task.wait(0.2)

			-- Eksekusi prompt
			if typeof(fireproximityprompt) == "function" then
				fireproximityprompt(closestPrompt, 0, true)
			else
				closestPrompt:InputHoldBegin()
				closestPrompt:InputHoldEnd()
			end

			task.wait(0.1)

			-- Kembali ke posisi semula
			character:PivotTo(originalCFrame)
		end
	end
end

task.spawn(function()
	while true do
		if autoActive then
			executeTeleport()
			local interval = tonumber(delayInput.Text) or 5
			task.wait(interval)
		else
			task.wait(0.5)
		end
	end
end)
