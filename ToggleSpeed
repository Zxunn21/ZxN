-- BOOST VELOCITY (inti fitur):
-- Pemain bergerak secepat `speed` (misal 300) TANPA mengubah WalkSpeed.
-- Server tetap melihat humanoid.WalkSpeed = originalSpeed (misal 200).
-- Caranya: setiap Heartbeat, SET velocity horizontal HumanoidRootPart
-- menjadi MoveDirection * speed. Komponen Y (gravitasi/lompatan) dibiarkan.
-- CATATAN: JANGAN pakai `+=` — di udara velocity tidak direset Humanoid,
-- jadi boost akan menumpuk tiap frame dan pemain terlempar liar
-- sampai menyentuh zona Air (Root.AreaTeleport.Air) lalu diteleport
-- kembali ke checkpoint/awal oleh MasterSSS (setupWaterTeleport).
local boostConn = nil

local function startBoost()
	if boostConn then
		boostConn:Disconnect()
		boostConn = nil
	end

	boostConn = RunService.Heartbeat:Connect(function()
		if not speedEnabled or originalSpeed == nil then
			return
		end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")

		if humanoid and hrp and humanoid.Health > 0 and speed > originalSpeed then
			local md = humanoid.MoveDirection
			if md.Magnitude > 0 then
				local vel = hrp.AssemblyLinearVelocity
				-- SET (bukan +=): kecepatan horizontal tepat `speed`, Y tetap alami.
				hrp.AssemblyLinearVelocity = Vector3.new(md.X * speed, vel.Y, md.Z * speed)
			end
		end
	end)
end

local function stopBoost()
	if boostConn then
			boostConn:Disconnect()
			boostConn = nil
	end
end

-- Monitor: auto-off saat game menurunkan WalkSpeed di bawah speed asli saat toggle aktif
-- (karena WalkSpeed tidak pernah kita ubah, yang terpantau hanya perubahan dari game/server)
task.spawn(function()
	while true do
		task.wait(0.1)
		if speedEnabled and originalSpeed ~= nil then
			local humanoid = getHumanoid()
			if humanoid and humanoid.WalkSpeed < originalSpeed then
				autoDisableSpeed()
			end
		end
	end
end)

startBoost()

updateSpeedButton()
