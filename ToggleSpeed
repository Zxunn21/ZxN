	flipToken += 1
	if flipActive then
		flipActive = false
		updateFlipButton()
	end
end

flipButton.MouseButton1Click:Connect(function()
	if flipActive then
		-- Matikan flip dan pastikan speed off
		stopFlip()
		disableSpeed()
	else
		-- Aktifkan flip: ON/OFF bergantian tiap 0.2 detik
		flipToken += 1
		flipActive = true
		updateFlipButton()

		local token = flipToken
		task.spawn(function()
			while flipActive and token == flipToken do
				if speedEnabled then
					disableSpeed()
				else
					enableSpeed()
				end
				task.wait(0.2)
			end
			-- Saat loop berhenti karena token berubah, pastikan state aman
			if token ~= flipToken and speedEnabled and not flipActive then
				-- state ditangani oleh pemanggil stopFlip()
			end
			end)
	end
end)

