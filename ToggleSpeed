-- Functions
local function showSpeedBubble()
	speedInput.Text = ""
	speedInput.Visible = false
	speedBubbleText.Text = "Hold to Change"
	speedBubbleText.Size = UDim2.new(1, -12, 1, -8)
	speedBubbleText.Position = UDim2.fromOffset(6, 4)
	speedBubble.Visible = true
	speedBubble.ZIndex = 1100
end

local function openSpeedInput()
	speedBubbleText.Text = "Speed"
	speedBubbleText.Size = UDim2.new(1, -12, 0, 22)
	speedBubbleText.Position = UDim2.fromOffset(6, 4)
	speedInput.Visible = true
	speedInput:CaptureFocus()
end

local function hideSpeedBubble()
	speedBubble.Visible = false
	if speedInput:IsFocused() then
		speedInput:ReleaseFocus()
	end
end

local speedHoldTime = 1
local speedHolding = false
local speedHoldToken = 0

local function beginSpeedHold()
	if speedHolding then
		return
	end

	speedHolding = true
	showSpeedBubble()
	speedHoldToken += 1
	local token = speedHoldToken
	local startTime = os.clock()

	task.spawn(function()
		while speedHolding and token == speedHoldToken do
			if os.clock() - startTime >= speedHoldTime then
				speedHolding = false
				openSpeedInput()
				return
			end
			task.wait(0.03)
		end
	end)
end

local function cancelSpeedHold()
	speedHolding = false
	speedHoldToken += 0.3
	hideSpeedBubble()
end

local function getHumanoid()
	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function readSpeed()
	return speed
end

local function updateSpeedButton()
	if speedEnabled then
		-- ON
		speedToggle.BackgroundColor3 = Color3.fromRGB(35, 200, 65)
		speedToggle.Text = "ON"
		speedToggle.TextColor3 = Color3.fromRGB(0, 0, 0)
		speedToggle.TextXAlignment = Enum.TextXAlignment.Left

		speedPadding.PaddingLeft = UDim.new(0, 15)
		speedPadding.PaddingRight = UDim.new(0, 0)

		speedKnob.Position = UDim2.new(
			1, -36,
			0.5, -16
		)
	else
		-- OFF
		speedToggle.BackgroundColor3 = Color3.fromRGB(230, 50, 50)
		speedToggle.Text = "OFF"
		speedToggle.TextColor3 = Color3.fromRGB(0, 0, 0)
		speedToggle.TextXAlignment = Enum.TextXAlignment.Right

		speedPadding.PaddingLeft = UDim.new(0, 0)
		speedPadding.PaddingRight = UDim.new(0, 15)

		speedKnob.Position = UDim2.new(
			0, 4,
			0.5, -16
		)
	end
end

local function enableSpeed()
	local humanoid = getHumanoid()

	if not humanoid then
		return
	end

	-- Simpan speed asli tepat saat ON ditekan
	originalSpeed = humanoid.WalkSpeed

	readSpeed()

	humanoid.WalkSpeed = speed
	speedEnabled = true

	updateSpeedButton()
end

local function disableSpeed()
	local humanoid = getHumanoid()

	if not humanoid then
		return
	end

	if originalSpeed ~= nil then
		humanoid.WalkSpeed = originalSpeed
	end

	speedEnabled = false
	originalSpeed = nil

	updateSpeedButton()
end

-- Auto-off: jika game menurunkan speed di bawah target, toggle off tanpa mengubah speed
local function autoDisableSpeed()
	speedEnabled = false
	originalSpeed = nil
	updateSpeedButton()
end

-- Speed toggle: tap = ON/OFF, hold 1 second = change speed
speedToggle.InputBegan:Connect(function(inputObject)
	if inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch then
		beginSpeedHold()
	end
end)

speedToggle.InputEnded:Connect(function(inputObject)
	if inputObject.UserInputType == Enum.UserInputType.MouseButton1
		or inputObject.UserInputType == Enum.UserInputType.Touch then
		if speedHolding then
			cancelSpeedHold()

			if speedEnabled then
				disableSpeed()
			else
				enableSpeed()
			end
		end
	end
end)

speedInput.FocusLost:Connect(function()
	local number = tonumber(speedInput.Text)

	if number and number >= 0 then
		speed = number
		speedInput.Text = ""

		if speedEnabled then
			local humanoid = getHumanoid()
			if humanoid then
				humanoid.WalkSpeed = speed
			end
		end
	else
		speedInput.Text = ""
	end

	hideSpeedBubble()
end)

-- Character respawn
player.CharacterAdded:Connect(function(character)
	local humanoid = character:WaitForChild("Humanoid")

	originalSpeed = humanoid.WalkSpeed
	speedEnabled = false

	updateSpeedButton()
end)

-- Monitor: auto-off saat WalkSpeed turun di bawah target saat toggle aktif
task.spawn(function()
	while true do
		task.wait(0.1)
		if speedEnabled then
			local humanoid = getHumanoid()
			if humanoid and humanoid.WalkSpeed < speed then
				autoDisableSpeed()
			end
		end
	end
end)

updateSpeedButton()
