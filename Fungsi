local function saveNotesNow()
    if not gui or not gui.Parent or type(writefile) ~= "function" then
        return false
    end

    local recordsById = {}
    for _, record in ipairs(noteRows) do
        recordsById[record.id] = record
    end

    local function belongsToUniversal(record)
        if record.isUniversalRoot or record.id == UNIVERSAL_ROOT_ID then
            return true
        end
        local parentId = tostring(record.parentId or "")
        local visited = {}
        while parentId ~= "" and not visited[parentId] do
            if parentId == UNIVERSAL_ROOT_ID then
                return true
            end
            visited[parentId] = true
            local parent = recordsById[parentId]
            if not parent then
                return false
            end
            if parent.isUniversalRoot then
                return true
            end
            parentId = tostring(parent.parentId or "")
        end
        return false
    end

    local localNotes = {}
    local universalNotes = {}
    for _, record in ipairs(noteRows) do
        if record.row and record.row.Parent then
            local savedRecord = {
                id = record.id,
                title = record.textBoxes[1].Text,
                functionText = record.textBoxes[2].Text,
                notes = record.textBoxes[3].Text,
                loopDelay = tonumber(record.loopDelay),
                loopRunning = record.itemType ~= "folder" and record.loopRunning == true or false,
                helperReference = record.itemType ~= "folder" and tostring(record.helperReference or "") or "",
                helperValues = record.itemType ~= "folder" and tostring(record.helperValues or "") or "",
                helperEnabled = record.itemType ~= "folder" and record.helperEnabled == true or false,
                itemType = record.itemType or "note",
                parentId = tostring(record.parentId or ""),
                order = tonumber(record.order) or 1,
                isUniversalRoot = record.isUniversalRoot == true,
            }
            if belongsToUniversal(record) then
                table.insert(universalNotes, savedRecord)
            else
                table.insert(localNotes, savedRecord)
            end
        end
    end

    table.sort(localNotes, function(a, b)
        if a.parentId == b.parentId then
            return (a.order or 1) < (b.order or 1)
        end
        return a.parentId < b.parentId
    end)
    table.sort(universalNotes, function(a, b)
        local aIsRoot = a.id == UNIVERSAL_ROOT_ID
        local bIsRoot = b.id == UNIVERSAL_ROOT_ID
        if aIsRoot or bIsRoot then
            return aIsRoot and not bIsRoot
        elseif a.parentId == b.parentId then
            return (a.order or 1) < (b.order or 1)
        end
        return a.parentId < b.parentId
    end)

    local localPayload = {
        schemaVersion = 2,
        universeId = tonumber(universeId) or universeId,
        notes = localNotes,
    }
    local universalPayload = {
        schemaVersion = 2,
        universeId = "universal",
        scope = "universal",
        notes = universalNotes,
    }

    local localEncodeOk, localJson = pcall(function()
        return HttpService:JSONEncode(localPayload)
    end)
    local universalEncodeOk, universalJson = pcall(function()
        return HttpService:JSONEncode(universalPayload)
    end)
    if not localEncodeOk or not universalEncodeOk then
        return false
    end

    local localWriteOk = pcall(writefile, storageFile, localJson)
    local universalWriteOk = pcall(writefile, universalStorageFile, universalJson)
    return localWriteOk and universalWriteOk
end

scheduleSave = function()
    saveVersion += 1
    local thisVersion = saveVersion

    task.delay(0.3, function()
        if thisVersion ~= saveVersion then
            return
        end
        saveNotesNow()
    end)
end

local function readClipboardText()
    local names = {
        "getclipboard",
        "get_clipboard",
        "getClipboard",
        "getclipboardtext",
        "getClipboardText",
        "getclipboardcontent",
        "getClipboardContent",
        "readclipboard",
        "read_clipboard",
        "readClipboard",
        "get_clipboard_text",
        "readClipboardText",
    }

    local environments = {}
    local seen = {}

    local function addEnvironment(env)
        if type(env) == "table" and not seen[env] then
            seen[env] = true
            table.insert(environments, env)
        end
    end

    addEnvironment(_G)
    if type(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok then
            addEnvironment(env)
        end
    end
    if type(getfenv) == "function" then
        local ok, env = pcall(getfenv, 0)
        if ok then
            addEnvironment(env)
        end
        ok, env = pcall(getfenv, 1)
        if ok then
            addEnvironment(env)
        end
    end
    if type(shared) == "table" then
        addEnvironment(shared)
    end

    for _, env in ipairs(environments) do
        for _, name in ipairs(names) do
            local getter
            local lookupOk, value = pcall(function()
                return env[name]
            end)
            if lookupOk then
                getter = value
            end

            if type(getter) == "function" then
                local ok, result = pcall(getter)
                if ok and type(result) == "string" then
                    return result, name
                end
            end
        end

        for _, objectName in ipairs({"clipboard", "Clipboard"}) do
            local object = env[objectName]
            if type(object) == "table" then
                for _, methodName in ipairs({"get", "Get", "read", "Read", "getText", "GetText", "readText", "ReadText"}) do
                    local method = object[methodName]
                    if type(method) == "function" then
                        local ok, result = pcall(method)
                        if not ok or type(result) ~= "string" then
                            ok, result = pcall(method, object)
                        end
                        if ok and type(result) == "string" then
                            return result, objectName .. "." .. methodName
                        end
                    end
                end
            end
        end
    end

    return nil, nil
end

