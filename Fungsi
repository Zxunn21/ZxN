local launcherPressing = false
local launcherDragging = false
local launcherLongPressFired = false
local launcherDragStart = Vector2.new(0, 0)
local launcherStartPosition = UDim2.new(0, 0, 0, 0)
local longPressThread = nil

launcher.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    launcherPressing = true
    launcherDragging = false
    launcherLongPressFired = false
    launcherDragStart = input.Position
    launcherStartPosition = launcher.Position
    hideBubble()

    if longPressThread then
        task.cancel(longPressThread)
        longPressThread = nil
    end

    longPressThread = task.delay(0.5, function()
        if launcherPressing and not launcherDragging then
            launcherLongPressFired = true
            showBubble()
        end
    end)
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if launcherPressing then
        local delta = input.Position - launcherDragStart

        if delta.Magnitude > 5 then
            launcherDragging = true

            if longPressThread then
                task.cancel(longPressThread)
                longPressThread = nil
            end
        end

        if launcherDragging then
            launcher.Position = UDim2.new(
                launcherStartPosition.X.Scale,
                launcherStartPosition.X.Offset + delta.X,
                launcherStartPosition.Y.Scale,
                launcherStartPosition.Y.Offset + delta.Y
            )
        end

        return
    end

    if dragging then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

