local function measureTextHeight(textBox)
    local usableWidth = math.max(20, textBox.AbsoluteSize.X - 12)
    local text = textBox.Text

    if text == "" then
        return textBox.TextSize + 2
    end

    local totalHeight = 0
    for line in (text .. "\n"):gmatch("(.-)\n") do
        local sample = line == "" and " " or line
        local measured = TextService:GetTextSize(
            sample,
            textBox.TextSize,
            textBox.Font,
            Vector2.new(usableWidth, 10000)
        )
        totalHeight += math.max(measured.Y, textBox.TextSize + 2)
    end

    return totalHeight
end

