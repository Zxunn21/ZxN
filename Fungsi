    end

    if longPressThread then
        task.cancel(longPressThread)
        longPressThread = nil
    end

    if not launcherDragging and not launcherLongPressFired then
        main.Position = launcher.Position
        main.Size = UDim2.new(0.6, 0, 0.8, 0)
        header.Visible = true
        body.Visible = true
        copyOverlay.Visible = false
        addPopup.Visible = false
