local function isDescendantFolder(candidateId, ancestorId)
    local cursor = findRecordById(candidateId)
    local visited = {}
    while cursor and cursor.parentId and cursor.parentId ~= "" and not visited[cursor.id] do
        if cursor.parentId == ancestorId then
            return true
        end
        visited[cursor.id] = true
        cursor = findRecordById(cursor.parentId)
    end
    return false
end

