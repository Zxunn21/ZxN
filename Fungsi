local function collectRecordSubtree(rootRecord)
    local orderedRecords = {rootRecord}

    local function appendChildren(parentId)
        local children = {}
        for _, candidate in ipairs(noteRows) do
            if candidate.id ~= UNIVERSAL_ROOT_ID
                and tostring(candidate.parentId or "") == tostring(parentId or "") then
                table.insert(children, candidate)
            end
        end

        table.sort(children, function(a, b)
            local orderA = tonumber(a.order) or 0
            local orderB = tonumber(b.order) or 0
            if orderA == orderB then
                return tostring(a.id) < tostring(b.id)
            end
            return orderA < orderB
        end)

        for _, child in ipairs(children) do
            table.insert(orderedRecords, child)
            if child.itemType == "folder" then
                appendChildren(child.id)
            end
        end
    end

    if rootRecord.itemType == "folder" then
        appendChildren(rootRecord.id)
    end

    return orderedRecords
end

local function duplicateRecordTree(sourceRoot)
    if not sourceRoot or sourceRoot.isUniversalRoot then
        warn("[Notes] Folder Universal utama tidak dapat diduplikasi.")
        return false
    end

    local sourceRecords = collectRecordSubtree(sourceRoot)
    local idMap = {}
    for _, source in ipairs(sourceRecords) do
        idMap[source.id] = generateRecordId()
    end

    local rootParentId = tostring(sourceRoot.parentId or "")
    local rootOrder = getNextOrder(rootParentId)

    for index, source in ipairs(sourceRecords) do
        local isRootCopy = source == sourceRoot
        local newParentId
        local newOrder

        if isRootCopy then
            newParentId = rootParentId
            newOrder = rootOrder
        else
            newParentId = idMap[tostring(source.parentId or "")] or rootParentId
            newOrder = tonumber(source.order) or 1
        end

        local originalTitle = source.textBoxes[1] and source.textBoxes[1].Text or ""
        local newTitle = originalTitle
        if isRootCopy then
            if newTitle:match("%S") then
                newTitle = newTitle .. " (Copy)"
            else
                newTitle = source.itemType == "folder" and "Folder (Copy)" or "Note (Copy)"
            end
        end

        local functionText = source.itemType == "folder" and ""
            or (source.textBoxes[2] and source.textBoxes[2].Text or "")
        local notesText = source.itemType == "folder" and ""
            or (source.textBoxes[3] and source.textBoxes[3].Text or "")

        createRow({
            id = idMap[source.id],
            itemType = source.itemType,
            parentId = newParentId,
            order = newOrder,
            title = newTitle,
            functionText = functionText,
            notes = notesText,
            loopDelay = source.itemType == "folder" and nil or source.loopDelay,
            loopRunning = false,
            helperReference = source.helperReference or "",
            helperValues = source.helperValues or "",
            helperEnabled = source.helperEnabled == true,
            isExpanded = source.isExpanded == true,
            isUniversalRoot = false,
        })
    end

    refreshVisibleRows()
    scheduleSave()
    return true
end

