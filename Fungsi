        x = pos.X + size.X + 6
        y = pos.Y
        if x + helperPanel.AbsoluteSize.X > viewport.X - 4 then
            x = pos.X - helperPanel.AbsoluteSize.X - 6
        end
    end
    x = math.clamp(x, 4, math.max(4, viewport.X - helperPanel.AbsoluteSize.X - 4))
    y = math.clamp(y, 4, math.max(4, viewport.Y - helperPanel.AbsoluteSize.Y - 4))
    helperPanel.Position = UDim2.fromOffset(x, y)
end

optionsHelperButton.Activated:Connect(function()
    local record = selectedOptionsRecord
    if not record or record.itemType == "folder" then
        return
    end
    helperTargetRecord = record
    helperReferenceInput.Text = record.helperReference or ""
    helperValuesInput.Text = record.helperValues or ""
    helperUseButton.Text = record.helperRunning and "Stop" or "Use"
    helperPanel.Visible = true
    positionHelperPanel()
end)

local function persistHelperInputs(record)
    if not record then return end
    record.helperReference = helperReferenceInput.Text
    record.helperValues = helperValuesInput.Text
    scheduleSave()
end

helperReferenceInput.FocusLost:Connect(function()
    persistHelperInputs(helperTargetRecord)
end)
helperValuesInput.FocusLost:Connect(function()
    persistHelperInputs(helperTargetRecord)
end)

helperUseButton.Activated:Connect(function()
    local record = helperTargetRecord
    if not record or record.itemType == "folder" then
        return
    end
    if record.helperRunning then
        record.helperRunning = false
        record.helperGeneration = (record.helperGeneration or 0) + 1
        helperUseButton.Text = "Use"
        helperPanel.Visible = false
        helperReferenceInput:ReleaseFocus()
        helperValuesInput:ReleaseFocus()
        return
    end
    persistHelperInputs(record)
    local reference = tostring(record.helperReference or "")
    local values = splitHelperValues(record.helperValues)
    if reference == "" then
        warn("[Notes] Isi teks referensi Helper terlebih dahulu.")
        return
    end
    if #values == 0 then
        warn("[Notes] Isi minimal satu nilai Helper.")
        return
    end
    if not record.textBoxes[2].Text or record.textBoxes[2].Text:match("^%s*$") then
        warn("[Notes] Kolom Fungsi kosong.")
        return
    end
    record.helperEnabled = true
    record.helperRunning = true
    record.helperGeneration = (record.helperGeneration or 0) + 1
    local generation = record.helperGeneration
    helperUseButton.Text = "Stop"
    scheduleSave()
    helperPanel.Visible = false
    helperReferenceInput:ReleaseFocus()
    helperValuesInput:ReleaseFocus()
    task.spawn(function()
        local source = record.textBoxes[2].Text or ""
        local escapedReference = reference:gsub("([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1")
        for _, value in ipairs(values) do
            if not record.helperRunning or record.helperGeneration ~= generation then
                break
            end
            local replacedSource = source:gsub(escapedReference, function() return value end)
            local ok = compileAndRun(replacedSource, nil, 0)
            if not ok then
                break
            end
        end
        if record.helperGeneration == generation then
            record.helperRunning = false
            if helperTargetRecord == record and helperPanel.Visible then
                helperUseButton.Text = "Use"
            end
        end
    end)
end)

helperCloseButton.Activated:Connect(function()
    helperPanel.Visible = false
    helperReferenceInput:ReleaseFocus()
    helperValuesInput:ReleaseFocus()
    helperTargetRecord = nil
end)

optionsActionButton.Activated:Connect(function()
    local record = selectedOptionsRecord
    if not record or not record.row or not record.row.Parent then
        hideOptionsPopup()
        return
    end

    if record.itemType == "folder" then
        hideOptionsPopup()
        if openDirectory then
            openDirectory(record)
        end
        return
    end

    record.isExpanded = not record.isExpanded
    if record.updateRowHeight then
        record.updateRowHeight()
    end
    optionsActionButton.Text = record.isExpanded and "Minimize" or "Expand"
end)

splitHelperValues = function(raw)
    local values = {}
    raw = tostring(raw or "")
    for line in (raw .. "\n"):gmatch("(.-)\n") do
        for part in (line .. ","):gmatch("(.-),") do
            local value = part:gsub("^%s+", ""):gsub("%s+$", "")
            if value ~= "" then
                table.insert(values, value)
            end
        end
    end
    return values
end

compileAndRun = function(source, record, generation)
    if record and record.helperGeneration ~= generation then
        return false
    end
    if type(loadstring) ~= "function" then
        warn("[Notes] Executor ini tidak menyediakan loadstring.")
        return false
    end
    local compiled, compileError
    local okCompile, callError = pcall(function()
        compiled, compileError = loadstring(source)
    end)
    if not okCompile then
        warn("[Notes] Gagal memproses script: " .. tostring(callError))
        return false
    end
    if type(compiled) ~= "function" then
        warn("[Notes] Syntax error: " .. tostring(compileError or "Script tidak dapat dikompilasi."))
        return false
    end
    local okRun, runError = pcall(compiled)
    if not okRun then
        warn("[Notes] Runtime error: " .. tostring(runError))
        return false
    end
    return true
end

local function runFunctionText(record, waitForCompletion)
    if record and record.itemType == "folder" then
        warn("[Notes] Folder tidak dapat dijalankan sebagai script.")
        return false
    end
    if not record or not record.textBoxes or not record.textBoxes[2] then
        warn("[Notes] Baris note tidak ditemukan.")
        return false
    end

    local source = record.textBoxes[2].Text or ""
    if source:match("^%s*$") then
        warn("[Notes] Kolom Fungsi kosong.")
        return false
    end

    local function executeBatch()
        local reference = tostring(record.helperReference or "")
        local values = record.helperEnabled and splitHelperValues(record.helperValues) or {}
        if reference ~= "" and #values > 0 then
            local generation = record.helperGeneration or 0
            for _, value in ipairs(values) do
                if record.helperGeneration ~= generation then
                    return false
                end
                local escapedReference = reference:gsub("([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1")
                local replacedSource = source:gsub(escapedReference, function()
                    return value
                end)
                local ok = compileAndRun(replacedSource, record, generation)
                if not ok then
                    return false
                end
            end
            return true
        end
        return compileAndRun(source, nil, 0)
    end

    if waitForCompletion then
        return executeBatch()
    end
    task.spawn(function()
        executeBatch()
    end)
    return true
end

