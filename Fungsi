        task.defer(updateAllRows)
    end

    launcherPressing = false
    launcherDragging = false
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if not bubbleFrame or not bubbleFrame.Visible or launcherPressing then
        return
    end

    local pointer = input.Position
    local bubblePosition = bubbleFrame.AbsolutePosition
    local bubbleSize = bubbleFrame.AbsoluteSize
    local insideBubble =
        pointer.X >= bubblePosition.X
        and pointer.X <= bubblePosition.X + bubbleSize.X
        and pointer.Y >= bubblePosition.Y
        and pointer.Y <= bubblePosition.Y + bubbleSize.Y

    if not insideBubble then
        hideBubble()
    end
end)

