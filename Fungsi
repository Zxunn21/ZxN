local function positionOptionsPopup()
    if not selectedOptionsButton or not selectedOptionsButton.Parent then
        return
    end

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local popupWidth = optionsPopup.Size.X.Offset
    local popupHeight = optionsPopup.Size.Y.Offset
    local buttonPosition = selectedOptionsButton.AbsolutePosition
    local buttonSize = selectedOptionsButton.AbsoluteSize

    local x = buttonPosition.X + buttonSize.X + 4
    local y = buttonPosition.Y

    if x + popupWidth > viewport.X - 4 then
        x = buttonPosition.X - popupWidth - 4
    end

    x = math.clamp(x, 4, math.max(4, viewport.X - popupWidth - 4))
    y = math.clamp(y, 4, math.max(4, viewport.Y - popupHeight - 4))
    optionsPopup.Position = UDim2.fromOffset(x, y)
end

local function positionLoopDelayBubble()
    if not optionsPopup.Visible then
        return
    end

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local popupPosition = optionsPopup.AbsolutePosition
    local popupSize = optionsPopup.AbsoluteSize
    local bubbleWidth = loopDelayBubble.AbsoluteSize.X
    local bubbleHeight = loopDelayBubble.AbsoluteSize.Y

    local x = popupPosition.X + popupSize.X + 5
    local y = popupPosition.Y + 34

    if x + bubbleWidth > viewport.X - 4 then
        x = popupPosition.X - bubbleWidth - 5
    end

    x = math.clamp(x, 4, math.max(4, viewport.X - bubbleWidth - 4))
    y = math.clamp(y, 4, math.max(4, viewport.Y - bubbleHeight - 4))
    loopDelayBubble.Position = UDim2.fromOffset(x, y)
end

