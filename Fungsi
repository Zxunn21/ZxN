local function finishRenameFolder(saveChanges)
    if saveChanges and renamingRecord and renamingRecord.itemType == "folder" then
        local newName = renameInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if newName ~= "" then
            renamingRecord.textBoxes[1].Text = newName
            scheduleSave()
        else
            warn("[Notes] Nama folder tidak boleh kosong.")
        end
    end
    renameInput:ReleaseFocus()
    renamePanel.Visible = false
    renamingRecord = nil
end

