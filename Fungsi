local function loadNotesFromJson(fileName, expectedUniverseId)
    if type(readfile) ~= "function" then
        return {}
    end

    if type(isfile) == "function" then
        local existsOk, exists = pcall(isfile, fileName)
        if not existsOk or not exists then
            return {}
        end
    end

    local readOk, rawJson = pcall(readfile, fileName)
    if not readOk or type(rawJson) ~= "string" or rawJson == "" then
        return {}
    end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(rawJson)
    end)

    if not decodeOk or type(data) ~= "table" then
        return {}
    end

    if tostring(data.universeId or "") ~= tostring(expectedUniverseId) then
        return {}
    end

    local result = {}
    if type(data.notes) == "table" then
        for index, item in ipairs(data.notes) do
            if type(item) == "table" then
                local itemId = tostring(item.id or "")
                table.insert(result, {
                    id = itemId,
                    title = tostring(item.title or ""),
                    functionText = tostring(item.functionText or ""),
                    notes = tostring(item.notes or ""),
                    loopDelay = tonumber(item.loopDelay),
                    loopRunning = item.loopRunning == true,
                    helperReference = tostring(item.helperReference or ""),
                    helperValues = tostring(item.helperValues or ""),
                    helperEnabled = item.helperEnabled == true,
                    itemType = item.itemType == "folder" and "folder" or "note",
                    parentId = tostring(item.parentId or ""),
                    order = tonumber(item.order) or index,
                    isUniversalRoot = item.isUniversalRoot == true or itemId == UNIVERSAL_ROOT_ID,
                })
            end
        end
    end

    return result
end

