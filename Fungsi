    destinationId = tostring(destinationId or "")
    if not record or record.isUniversalRoot then
        return false
    end
    if destinationId == "" then
        return true
    end
    local destination = findRecordById(destinationId)
    if not destination or destination.itemType ~= "folder" then
        return false
    end
    if record.itemType == "folder" then
        if destinationId == record.id or isDescendantFolder(destinationId, record.id) then
            return false
        end
    end
    return true
end

local function moveRecordTo(record, destinationId)
    if not record or not canMoveRecordTo(record, destinationId) then
        warn("[Notes] Folder tidak dapat dipindahkan ke direktori tersebut.")
        return false
    end
    destinationId = tostring(destinationId or "")
    if tostring(record.parentId or "") == destinationId then
        return true
    end
    local destinationOrder = getNextOrder(destinationId)
    record.parentId = destinationId
    record.order = destinationOrder
    if record.row then
        record.row.LayoutOrder = record.order
    end
    refreshVisibleRows()
    scheduleSave()
    return true
end

