        hideOptionsPopup()
        return
    end
    if record.isUniversalRoot then
        warn("[Notes] Folder Universal tidak dapat dihapus.")
        hideOptionsPopup()
        return
    end

    local deleteIds = {[record.id] = true}
    local changed = true
    while changed do
        changed = false
        for _, item in ipairs(noteRows) do
            if item.parentId and deleteIds[item.parentId] and not deleteIds[item.id] then
                deleteIds[item.id] = true
                changed = true
            end
        end
    end

    for index = #noteRows, 1, -1 do
        local item = noteRows[index]
        if deleteIds[item.id] then
            if item.loopRunning then
                stopLoop(item)
            end
            item.helperRunning = false
            item.helperGeneration = (item.helperGeneration or 0) + 1
            rowUpdaters[item.row] = nil
            if item.row then
                item.row:Destroy()
            end
            table.remove(noteRows, index)
        end
    end

    for _, folderRecord in ipairs(directoryStack) do
        if deleteIds[folderRecord.id] then
            currentDirectoryId = ""
            table.clear(directoryStack)
            break
        end
    end

    hideOptionsPopup()
    refreshVisibleRows()
    scheduleSave()
end)

