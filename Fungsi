local cleanedContainers = {}
local function clearOldNotesGui(container)
    if not container then
        return
    end
    pcall(function()
        if cleanedContainers[container] then
            return
        end
        cleanedContainers[container] = true
        local oldGuis = {}
        for _, existingGui in ipairs(container:GetDescendants()) do
            if existingGui.Name == "NotesGui" and existingGui:IsA("ScreenGui") then
                table.insert(oldGuis, existingGui)
            end
        end
        for _, existingGui in ipairs(container:GetChildren()) do
            if existingGui.Name == "NotesGui" and existingGui:IsA("ScreenGui") then
                table.insert(oldGuis, existingGui)
            end
        end
        for _, existingGui in ipairs(oldGuis) do
            pcall(function()
                existingGui:Destroy()
            end)
        end
    end)
end

