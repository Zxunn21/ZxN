local function reorderRecord(record, direction)
    if not record or record.isUniversalRoot then
        return
    end
    local siblings = {}
    for _, item in ipairs(noteRows) do
        if tostring(item.parentId or "") == tostring(record.parentId or "") and not item.isUniversalRoot then
            table.insert(siblings, item)
        end
    end
    table.sort(siblings, function(a, b)
        local orderA = tonumber(a.order) or 0
        local orderB = tonumber(b.order) or 0
        if orderA == orderB then
            return a.id < b.id
        end
        return orderA < orderB
    end)

    local currentIndex
    for index, item in ipairs(siblings) do
        if item == record then
            currentIndex = index
            break
        end
    end
    if not currentIndex then
        return
    end
    local targetIndex = currentIndex + direction
    if targetIndex < 1 or targetIndex > #siblings then
        return
    end

    siblings[currentIndex], siblings[targetIndex] = siblings[targetIndex], siblings[currentIndex]
    for index, item in ipairs(siblings) do
        item.order = index
        if item.row then
            item.row.LayoutOrder = index
        end
    end
    scheduleSave()
end

