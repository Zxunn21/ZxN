local function startLoop(record, delayOverride)
    if record and record.itemType == "folder" then
        warn("[Notes] Folder tidak dapat menjalankan Loop.")
        return
    end
    if not record or not record.row or not record.row.Parent then
        warn("[Notes] Baris note tidak ditemukan.")
        return
    end

    local delaySeconds = tonumber(delayOverride)
        or tonumber(optionsLoopDelayInput.Text)
        or tonumber(record.loopDelay)

    if not delaySeconds or delaySeconds <= 0 then
        warn("[Notes] Masukkan delay angka lebih besar dari 0 detik.")
        return
    end

    delaySeconds = math.clamp(delaySeconds, 0.1, 3600)
    record.loopDelay = delaySeconds
    record.loopRunning = true
    record.loopGeneration = (record.loopGeneration or 0) + 1
    local thisGeneration = record.loopGeneration
    updateRunButtonText(record)
    saveNotesNow()

    task.spawn(function()
        while record.loopRunning
            and record.loopGeneration == thisGeneration
            and record.row
            and record.row.Parent do
            local runOk = runFunctionText(record, true)
            if not runOk then
                record.loopRunning = false
                saveNotesNow()
                break
            end

            if not record.loopRunning or record.loopGeneration ~= thisGeneration then
                break
            end

            task.wait(tonumber(record.loopDelay) or delaySeconds)
        end

        if record.loopGeneration == thisGeneration then
            record.loopRunning = false
            updateRunButtonText(record)
            if record.row and record.row.Parent then
                saveNotesNow()
            end
        end
    end)
end

