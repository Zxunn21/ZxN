-- Helper: create a row with label, value, and copy button
local function createRow(order, labelText, valueText)
	local row = Instance.new("Frame")
	row.Name = labelText .. "Row"
	row.Size = UDim2.new(1, 0, 0, 50)
	row.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.Parent = scrollFrame

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 6)
	rowCorner.Parent = row

	-- Label (left column)
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(0, 100, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(200, 200, 210)
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 16
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	-- Value (center column)
	local value = Instance.new("TextLabel")
	value.Name = "Value"
	value.Size = UDim2.new(1, -200, 1, 0)
	value.Position = UDim2.new(0, 110, 0, 0)
	value.BackgroundTransparency = 1
	value.Text = valueText
	value.TextColor3 = Color3.fromRGB(255, 255, 255)
	value.Font = Enum.Font.SourceSans
	value.TextSize = 15
	value.TextXAlignment = Enum.TextXAlignment.Center
	value.Parent = row

	-- Copy button (right column)
	local copyBtn = Instance.new("TextButton")
	copyBtn.Name = "CopyButton"
	copyBtn.Size = UDim2.new(0, 70, 0, 30)
	copyBtn.Position = UDim2.new(1, -80, 0.5, -15)
	copyBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 200)
	copyBtn.Text = "Copy"
	copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	copyBtn.Font = Enum.Font.SourceSansBold
	copyBtn.TextSize = 14
	copyBtn.AutoButtonColor = true
	copyBtn.BorderSizePixel = 0
	copyBtn.Parent = row

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = copyBtn

	-- Copy logic
	copyBtn.MouseButton1Click:Connect(function()
		if setclipboard then
			setclipboard(value.Text)
			copyBtn.Text = "Copied!"
			task.wait(1)
			copyBtn.Text = "Copy"
		end
	end)

	return row, value
end

