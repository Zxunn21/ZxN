-- ============================================================
-- SINGLE PLAYER LINE (BEAM)
-- ============================================================

local function clearSingleLines()
	for _, beam in ipairs(singleBeams) do
		if beam and beam.Parent then
			beam:Destroy()
		end
	end
	table.clear(singleBeams)

	for _, data in ipairs(singleTargetParts) do
		if data.part and data.part.Parent then
			data.part:Destroy()
		end
	end
	table.clear(singleTargetParts)
end

local function createSingleLines(targetName)
	clearSingleLines()

	if not singleLineEnabled then return end

	local rootPart = getPlayerESPRoot(player)
	if not rootPart then return end

	local targets = findPlayersByName(targetName)

	for _, other in ipairs(targets) do
		local targetRoot = getPlayerESPRoot(other)

		if targetRoot then
			local targetPart = Instance.new("Part")
			targetPart.Name = "SingleLineTarget"
			targetPart.Anchored = true
			targetPart.CanCollide = false
			targetPart.CanTouch = false
			targetPart.CanQuery = false
			targetPart.CastShadow = false
			targetPart.Transparency = 1
			targetPart.Size = Vector3.new(0.1, 0.1, 0.1)
			targetPart.Position = targetRoot.Position
			targetPart.Parent = workspace

			local startAttachment = Instance.new("Attachment")
			startAttachment.Name = "SingleLineStart"
			startAttachment.Parent = rootPart

			local endAttachment = Instance.new("Attachment")
			endAttachment.Name = "SingleLineEnd"
			endAttachment.Parent = targetPart

			local beam = Instance.new("Beam")
			beam.Name = "SingleLineBeam"
			beam.Attachment0 = startAttachment
			beam.Attachment1 = endAttachment
			beam.Width0 = 0.35
			beam.Width1 = 0.35
			beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
			beam.Transparency = NumberSequence.new(0)
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.Segments = 1
			beam.Parent = targetPart

			table.insert(singleBeams, beam)
			table.insert(singleTargetParts, {
				part = targetPart,
				player = other
			})
		end
	end
end

local function updateSingleLineButton()
	if singleLineEnabled then
		singleLineButton.Text = "ON"
		singleLineButton.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		singleLineButton.Text = "Line"
		singleLineButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

singleLineButton.Activated:Connect(function()
	singleLineEnabled = not singleLineEnabled
	updateSingleLineButton()

	if singleLineEnabled then
		local name = singleESPInput.Text:match("^%s*(.-)%s*$")
		if name ~= "" then
			createSingleLines(name)
		end
	else
		clearSingleLines()
	end
end)

player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.2)

	if singleESPEnabled and currentSingleTargetName then
		applySingleESP()
	end
	if singleLineEnabled and currentSingleTargetName then
		createSingleLines(currentSingleTargetName)
	end
end)

-- Update loop
task.spawn(function()
	while true do
		task.wait(0.05)

		-- Update All Players ESP
		updatePlayerESP()

		-- Update Single ESP distances
		if singleESPEnabled then
			local myRoot = getPlayerESPRoot(player)
			if myRoot then
				for _, other in ipairs(Players:GetPlayers()) do
					if other ~= player then
						local root = getPlayerESPRoot(other)
						local data = singleESPData[other]
						if root and data then
							data.Billboard.Adornee = root
							data.Billboard.Enabled = true
							data.Highlight.Adornee = other.Character
							data.Highlight.Enabled = true
							data.NameLabel.Text = other.DisplayName
							data.UsernameLabel.Text = "@" .. other.Name
							local distance = (myRoot.Position - root.Position).Magnitude
							data.DistanceLabel.Text = string.format("%d stud", math.floor(distance + 0.5))
						elseif not root and data then
							data.Billboard.Enabled = false
							data.Highlight.Enabled = false
						end
					end
				end
			end
		end

		-- Update Single Lines
		if singleLineEnabled and currentSingleTargetName then
			local needsRefresh = false

			for _, data in ipairs(singleTargetParts) do
				local other = data.player
				local targetRoot = getPlayerESPRoot(other)

				if not targetRoot or not data.part or not data.part.Parent then
					needsRefresh = true
					break
				end

				data.part.Position = targetRoot.Position
			end

			if needsRefresh then
				createSingleLines(currentSingleTargetName)
			elseif #singleTargetParts == 0 then
				createSingleLines(currentSingleTargetName)
			end
		end
	end
end)

