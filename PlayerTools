local camera = workspace.CurrentCamera

local function updateViewPlayerTarget()
	local name = viewPlayerInput.Text:match("^%s*(.-)%s*$")
	if name == "" then
		viewPlayerTarget = nil
		return
	end
	local targets = findPlayersByName(name)
	viewPlayerTarget = (#targets > 0) and targets[1] or nil
end

local function setViewPlayer(state)
	viewPlayerEnabled = state
	viewPlayerButton.Text = state and "ON" or "OFF"
	viewPlayerButton.BackgroundColor3 = state
		and Color3.fromRGB(40, 150, 70)
		or Color3.fromRGB(180, 50, 50)

	if state then
		originalCameraSubject = camera.CameraSubject
		originalCameraType = camera.CameraType
		updateViewPlayerTarget()
	else
		if originalCameraSubject then
			camera.CameraSubject = originalCameraSubject
		end
		if originalCameraType then
			camera.CameraType = originalCameraType
		end
		viewPlayerTarget = nil
		originalCameraSubject = nil
		originalCameraType = nil
	end
end

viewPlayerButton.Activated:Connect(function()
	setViewPlayer(not viewPlayerEnabled)
end)

viewPlayerInput.FocusLost:Connect(function()
	if viewPlayerEnabled then
		updateViewPlayerTarget()
	end
end)

viewPlayerInput:GetPropertyChangedSignal("Text"):Connect(function()
	if viewPlayerEnabled then
		updateViewPlayerTarget()
	end
end)

local function removeSingleESP(other)
	local data = singleESPData[other]
	if not data then return end

	if data.Billboard then
		data.Billboard:Destroy()
	end
	if data.Highlight then
		data.Highlight:Destroy()
	end

	singleESPData[other] = nil
end

local function createSingleESP(other)
	if other == player or not singleESPEnabled then return end
	local root = getPlayerESPRoot(other)
	if not root then return end

	local data = singleESPData[other]
	if data and data.Billboard and data.Billboard.Parent and data.Highlight and data.Highlight.Parent then
		data.Billboard.Adornee = root
		data.Billboard.Enabled = true
		data.Highlight.Adornee = other.Character
		data.Highlight.Enabled = true
		return
	end

	removeSingleESP(other)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PlayerTools_SingleESP"
	billboard.Size = UDim2.fromOffset(260, 62)
	billboard.StudsOffset = Vector3.new(0, 3.6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = math.huge
	billboard.Adornee = root
	billboard.Enabled = true
	billboard.Parent = playerGui

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0, 22)
	nameLabel.Position = UDim2.fromOffset(0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = tostring(other.DisplayName or other.Name)
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0
	nameLabel.TextSize = 17
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Visible = showName
	nameLabel.Parent = billboard

	local usernameLabel = Instance.new("TextLabel")
	usernameLabel.Size = UDim2.new(1, 0, 0, 18)
	usernameLabel.Position = UDim2.fromOffset(0, 20)
	usernameLabel.BackgroundTransparency = 1
	usernameLabel.Text = "@" .. tostring(other.Name)
	usernameLabel.TextColor3 = Color3.fromRGB(225, 225, 225)
	usernameLabel.TextStrokeTransparency = 0
	usernameLabel.TextSize = 12
	usernameLabel.Font = Enum.Font.Gotham
	usernameLabel.TextXAlignment = Enum.TextXAlignment.Center
	usernameLabel.Visible = showUsername
	usernameLabel.Parent = billboard

	local distanceLabel = Instance.new("TextLabel")
	distanceLabel.Size = UDim2.new(1, 0, 0, 18)
	distanceLabel.Position = UDim2.fromOffset(0, 37)
	distanceLabel.BackgroundTransparency = 1
	distanceLabel.Text = "0 stud"
	distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	distanceLabel.TextStrokeTransparency = 0
	distanceLabel.TextSize = 12
	distanceLabel.Font = Enum.Font.Gotham
	distanceLabel.TextXAlignment = Enum.TextXAlignment.Center
	distanceLabel.Visible = showDistance
	distanceLabel.Parent = billboard

	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerTools_SingleHighlight"
	highlight.Adornee = other.Character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(80, 170, 255)
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Enabled = true
	highlight.Parent = gui

	singleESPData[other] = {
		Billboard = billboard,
		Highlight = highlight,
		NameLabel = nameLabel,
		UsernameLabel = usernameLabel,
		DistanceLabel = distanceLabel,
	}
end

local function clearSingleESP()
	for other in pairs(singleESPData) do
		removeSingleESP(other)
	end
end

local function applySingleESP()
	if not singleESPEnabled then return end

	local name = singleESPInput.Text:match("^%s*(.-)%s*$")
	if name == "" then return end

	currentSingleTargetName = name

	local targets = findPlayersByName(name)
	local targetSet = {}
	for _, other in ipairs(targets) do
		targetSet[other] = true
	end

	for other in pairs(singleESPData) do
		if not targetSet[other] then
			removeSingleESP(other)
		end
	end

	for _, other in ipairs(targets) do
		createSingleESP(other)
	end
end

local function setSingleESP(state)
	singleESPEnabled = state
	singleESPButton.Text = state and "ON" or "ESP"
	singleESPButton.BackgroundColor3 = state
		and Color3.fromRGB(40, 150, 70)
		or Color3.fromRGB(180, 50, 50)

	if not state then
		clearSingleESP()
		return
	end

	applySingleESP()
end

singleESPButton.Activated:Connect(function()
	setSingleESP(not singleESPEnabled)
end)

singleESPInput.FocusLost:Connect(function()
	if singleESPEnabled then
		applySingleESP()
	end
end)

singleESPInput:GetPropertyChangedSignal("Text"):Connect(function()
	if singleESPEnabled then
		applySingleESP()
	end
end)

Players.PlayerRemoving:Connect(function(other)
	removeSingleESP(other)
	removePlayerHighlight(other)
	if viewPlayerTarget == other then
		viewPlayerTarget = nil
		if viewPlayerEnabled then
			updateViewPlayerTarget()
		end
	end
	if singleLineEnabled and currentSingleTargetName then
		createSingleLines(currentSingleTargetName)
	end
end)

Players.PlayerAdded:Connect(function(other)
	if singleESPEnabled and currentSingleTargetName then
		other.CharacterAdded:Connect(function()
			task.wait(0.2)
			if singleESPEnabled and currentSingleTargetName then
				applySingleESP()
			end
		end)
	end

	other.CharacterAdded:Connect(function()
		task.wait(0.2)
		if highlightPlayerEnabled then
			createPlayerHighlight(other)
		end
	end)
end)

removePlayerHighlight = function(other)
	local highlight = highlightPlayerData[other]
	if highlight then
		highlight:Destroy()
	end
	highlightPlayerData[other] = nil
end

createPlayerHighlight = function(other)
	if other == player or not highlightPlayerEnabled then return end
	local character = other.Character
	if not character then return end

	local highlight = highlightPlayerData[other]
	if highlight and highlight.Parent then
		highlight.Adornee = character
		highlight.Enabled = true
		return
	end

	if highlight then
		removePlayerHighlight(other)
	end

	highlight = Instance.new("Highlight")
	highlight.Name = "PlayerTools_PlayerHighlight"
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(80, 170, 255)
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Enabled = true
	highlight.Parent = gui

	highlightPlayerData[other] = highlight
end

local function clearAllPlayerHighlights()
	for other in pairs(highlightPlayerData) do
		removePlayerHighlight(other)
	end
end

local function setHighlightPlayer(state)
	highlightPlayerEnabled = state
	highlightPlayerButton.Text = state and "ON" or "OFF"
	highlightPlayerButton.BackgroundColor3 = state
		and Color3.fromRGB(40, 150, 70)
		or Color3.fromRGB(180, 50, 50)

	if not state then
		clearAllPlayerHighlights()
		return
	end

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			createPlayerHighlight(other)
		end
	end
end

highlightPlayerButton.Activated:Connect(function()
	setHighlightPlayer(not highlightPlayerEnabled)
end)

function refreshESPTypeVisibility()
	for _, data in pairs(playerESPData) do
		if data then
			data.NameLabel.Visible = showName
			data.UsernameLabel.Visible = showUsername
			data.DistanceLabel.Visible = showDistance
		end
	end
	for _, data in pairs(singleESPData) do
		if data then
			data.NameLabel.Visible = showName
			data.UsernameLabel.Visible = showUsername
			data.DistanceLabel.Visible = showDistance
		end
	end
end

local function clearSingleLines()
	for _, beam in ipairs(singleBeams) do
		if beam and beam.Parent then
			beam:Destroy()
		end
	end
	table.clear(singleBeams)

	for _, data in ipairs(singleTargetParts) do
		if data.part and data.part.Parent then
			data.part:Destroy()
		end
	end
	table.clear(singleTargetParts)
end

createSingleLines = function(targetName)
	clearSingleLines()

	if not singleLineEnabled then return end

	local rootPart = getPlayerESPRoot(player)
	if not rootPart then return end

	local targets = findPlayersByName(targetName)

	for _, other in ipairs(targets) do
		local targetRoot = getPlayerESPRoot(other)

		if targetRoot then
			local targetPart = Instance.new("Part")
			targetPart.Name = "SingleLineTarget"
			targetPart.Anchored = true
			targetPart.CanCollide = false
			targetPart.CanTouch = false
			targetPart.CanQuery = false
			targetPart.CastShadow = false
			targetPart.Transparency = 1
			targetPart.Size = Vector3.new(0.1, 0.1, 0.1)
			targetPart.Position = targetRoot.Position
			targetPart.Parent = workspace

			local startAttachment = Instance.new("Attachment")
			startAttachment.Name = "SingleLineStart"
			startAttachment.Parent = rootPart

			local endAttachment = Instance.new("Attachment")
			endAttachment.Name = "SingleLineEnd"
			endAttachment.Parent = targetPart

			local beam = Instance.new("Beam")
			beam.Name = "SingleLineBeam"
			beam.Attachment0 = startAttachment
			beam.Attachment1 = endAttachment
			beam.Width0 = 0.35
			beam.Width1 = 0.35
			beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
			beam.Transparency = NumberSequence.new(0)
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.Segments = 1
			beam.Parent = targetPart

			table.insert(singleBeams, beam)
			table.insert(singleTargetParts, {
				part = targetPart,
				player = other
			})
		end
	end
end

local function updateSingleLineButton()
	if singleLineEnabled then
		singleLineButton.Text = "ON"
		singleLineButton.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
	else
		singleLineButton.Text = "Line"
		singleLineButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end

singleLineButton.Activated:Connect(function()
	singleLineEnabled = not singleLineEnabled
	updateSingleLineButton()

	if singleLineEnabled then
		local name = singleESPInput.Text:match("^%s*(.-)%s*$")
		if name ~= "" then
			createSingleLines(name)
		end
	else
		clearSingleLines()
	end
end)

player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.2)

	if singleESPEnabled and currentSingleTargetName then
		applySingleESP()
	end
	if singleLineEnabled and currentSingleTargetName then
		createSingleLines(currentSingleTargetName)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.05)

		updatePlayerESP()

		if highlightPlayerEnabled then
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					local character = other.Character
					local highlight = highlightPlayerData[other]
					if character and highlight then
						highlight.Adornee = character
						highlight.Enabled = true
					elseif not character and highlight then
						highlight.Enabled = false
					elseif character and not highlight then
						createPlayerHighlight(other)
					end
				end
			end
		end

		if hideNameTagEnabled then
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					applyHideNameTag(other)
				end
			end
		end

		if singleESPEnabled then
			local myRoot = getPlayerESPRoot(player)
			if myRoot then
				for _, other in ipairs(Players:GetPlayers()) do
					if other ~= player then
						local root = getPlayerESPRoot(other)
						local data = singleESPData[other]
						if root and data then
							data.Billboard.Adornee = root
							data.Billboard.Enabled = true
							data.Highlight.Adornee = other.Character
							data.Highlight.Enabled = true
							data.NameLabel.Text = other.DisplayName
							data.UsernameLabel.Text = "@" .. other.Name
							local distance = (myRoot.Position - root.Position).Magnitude
							data.DistanceLabel.Text = string.format("%d stud", math.floor(distance + 0.5))
						elseif not root and data then
							data.Billboard.Enabled = false
							data.Highlight.Enabled = false
						end
					end
				end
			end
		end

		if singleLineEnabled and currentSingleTargetName then
			local needsRefresh = false

			for _, data in ipairs(singleTargetParts) do
				local other = data.player
				local targetRoot = getPlayerESPRoot(other)

				if not targetRoot or not data.part or not data.part.Parent then
					needsRefresh = true
					break
				end

				data.part.Position = targetRoot.Position
			end

			if needsRefresh then
				createSingleLines(currentSingleTargetName)
			elseif #singleTargetParts == 0 then
				createSingleLines(currentSingleTargetName)
			end
		end

		if viewPlayerEnabled and viewPlayerTarget then
			local targetChar = viewPlayerTarget.Character
			local targetHumanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
			if targetHumanoid then
				camera.CameraSubject = targetHumanoid
				camera.CameraType = Enum.CameraType.Custom
			else
				updateViewPlayerTarget()
			end
		elseif viewPlayerEnabled and not viewPlayerTarget then
			updateViewPlayerTarget()
		end
	end
end)

updateSingleLineButton()

local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Name = "ContentScroll"
scrollFrame.Size = UDim2.new(1, 0, 1, -36)
scrollFrame.Position = UDim2.fromOffset(0, 36)
scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 5
scrollFrame.ScrollBarImageTransparency = 0.15
scrollFrame.ScrollingDirection = Enum.ScrollingDirection.Y
scrollFrame.CanvasSize = UDim2.new(1, 0, 0, 0)
scrollFrame.ZIndex = 501
scrollFrame.Parent = mainFrame

local function updateCanvasHeight()
	local contentHeight = 0
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("GuiObject") then
			local bottom = child.Position.Y.Offset + child.Size.Y.Offset
			if bottom > contentHeight then
				contentHeight = bottom
			end
		end
	end
	scrollFrame.CanvasSize = UDim2.new(1, 0, 0, contentHeight + 10)
end

for _, child in ipairs(mainFrame:GetChildren()) do
	if child ~= topBar
		and child ~= scrollFrame
		and not child:IsA("UICorner")
		and not child:IsA("UIStroke") then
		child.Parent = scrollFrame
		-- Pastikan semua kontrol berada di atas ScrollingFrame agar tombol tetap menerima input.
		if child:IsA("GuiButton") or child:IsA("TextBox") or child:IsA("TextLabel") then
			child.ZIndex = 510
		end
	end
end

updateCanvasHeight()
scrollFrame.ChildAdded:Connect(updateCanvasHeight)
