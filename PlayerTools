local function applyHideNameTag(other)
	if other == player then return end
	local character = other and other.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if hideNameTagEnabled then
			-- Simpan nilai asli hanya sekali sebelum mengubah
			if not originalNameTagData[other] then
				originalNameTagData[other] = {
					DisplayDistanceType = humanoid.DisplayDistanceType,
					HealthDisplayType = humanoid.HealthDisplayType,
				}
			end
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		else
			-- Kembalikan ke nilai asli yang tersimpan
			local saved = originalNameTagData[other]
			if saved then
				humanoid.DisplayDistanceType = saved.DisplayDistanceType
				humanoid.HealthDisplayType = saved.HealthDisplayType
			else
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
				humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
			end
		end
	end

	local head = character:FindFirstChild("Head")
	if head then
		for _, child in ipairs(head:GetChildren()) do
			if child:IsA("BillboardGui") then
				if hideNameTagEnabled then
					-- Simpan nilai Enabled asli hanya sekali sebelum menonaktifkan
					if not originalNameTagData[other] then
						originalNameTagData[other] = {}
					end
					if originalNameTagData[other][child] == nil then
						originalNameTagData[other][child] = child.Enabled
					end
					child.Enabled = false
				else
					-- Kembalikan ke nilai Enabled asli
					local saved = originalNameTagData[other]
					if saved and saved[child] ~= nil then
						child.Enabled = saved[child]
					else
						child.Enabled = true
					end
				end
			end
		end
	end
end

local function setHideNameTag(state)
	hideNameTagEnabled = state
	hideNameTagButton.Text = state and "ON" or "OFF"
	hideNameTagButton.BackgroundColor3 = state
		and Color3.fromRGB(40, 150, 70)
		or Color3.fromRGB(180, 50, 50)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			applyHideNameTag(other)
		end
	end

	-- Bersihkan data tersimpan saat dimatikan
	if not state then
		originalNameTagData = {}
	end
end

