local function setPlayerESP(state)
	playerESPEnabled = state
	espAllButton.Text = state and "ON" or "OFF"
	espAllButton.BackgroundColor3 = state
		and Color3.fromRGB(40, 150, 70)
		or Color3.fromRGB(180, 50, 50)

	if not state then
		clearPlayerESP()
		return
	end

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			createPlayerESP(other)
		end
	end
end

