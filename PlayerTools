	button.ZIndex = 512
	button.Parent = espTypeButtonsFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = button

	local function updateButton()
		if getEnabled() then
			button.Text = buttonText .. ""
			button.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
		else
			button.Text = "OFF"
			button.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		end
	end

	button.Activated:Connect(function()
		setEnabled(not getEnabled())
		updateButton()
		if refreshESPTypeVisibility then
			refreshESPTypeVisibility()
		end
	end)

	updateButton()
end

