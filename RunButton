local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local RUN_MULTIPLIER = 1.5

-- Menyimpan kecepatan karakter saat tombol mulai ditekan
local savedWalkSpeed = nil

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "RunButtonGui"
gui.ResetOnSpawn = false
gui.Parent = playerGui

-- Tombol
local button = Instance.new("TextButton")
button.Name = "RunButton"
button.Size = UDim2.new(0, 60, 0, 60)
button.Position = UDim2.new(0.92, 0, 0.5, 0)
button.AnchorPoint = Vector2.new(0.5, 0.5)
button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
button.BackgroundTransparency = 0.15
button.Text = "🏃🏻‍♂️"
button.TextSize = 30
button.Font = Enum.Font.SourceSansBold
button.TextColor3 = Color3.new(1, 1, 1)
button.AutoButtonColor = false
button.Parent = gui

-- Membuat lingkaran
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = button

-- Garis lingkaran
local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.2
stroke.Parent = button

-- Aktifkan mode lari: simpan kecepatan saat ini, lalu kalikan
local function startRun()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	-- Simpan kecepatan saat ini sebelum diubah
	savedWalkSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = savedWalkSpeed * RUN_MULTIPLIER
	button.BackgroundColor3 = Color3.fromRGB(60, 170, 80)
end

-- Kembalikan kecepatan ke nilai yang tersimpan
local function stopRun()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	if savedWalkSpeed then
		humanoid.WalkSpeed = savedWalkSpeed
		savedWalkSpeed = nil
	end
	button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
end

-- Saat tombol ditekan: simpan & kalkulasi kecepatan
button.MouseButton1Down:Connect(startRun)

-- Saat tombol dilepas
button.MouseButton1Up:Connect(stopRun)

-- Jika jari/mouse keluar tombol lalu dilepas
button.MouseLeave:Connect(stopRun)

-- Reset speed saat karakter respawn
player.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid").WalkSpeed = 16
	savedWalkSpeed = nil
end)
