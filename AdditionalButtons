-- Update highlight position to match selected object (called every frame via RenderStepped)
local function updateHighlight()
	if selectedObject and selectedObject.Parent then
		local pos = selectedObject.AbsolutePosition
		local size = selectedObject.AbsoluteSize
		highlight.Position = UDim2.fromOffset(pos.X, pos.Y)
		highlight.Size = UDim2.fromOffset(size.X, size.Y)
		highlight.Visible = true
	else
		highlight.Visible = false
	end
end

-- Highlight tracking via RenderStepped for accurate real-time position
local highlightConnection
local function startHighlightTracking()
	if highlightConnection then return end
	highlightConnection = RunService.RenderStepped:Connect(function()
		if selectedObject then
			if not selectedObject.Parent then
				selectedObject = nil
				if dragMode then
					setDragMode(false)
				end
			end
		end
		updateHighlight()
	end)
end

-- Check if object matches current selectType
local function matchesSelectType(obj)
	if selectType == "button" then
		return obj:IsA("GuiButton")
	elseif selectType == "frame" then
		return obj:IsA("GuiObject") and not obj:IsA("GuiButton")
	end
	return false
end

-- Get screen position from input
local function getTapPosition(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		local mouseLoc = UserInputService:GetMouseLocation()
		return Vector2.new(mouseLoc.X, mouseLoc.Y)
	end
	return nil
end

-- Selection logic
local selectInputConnection = nil

local function setSelectMode(enabled)
	selectMode = enabled
	adjSelectButton.Text = enabled and "Selecting..." or "Select"
	adjSelectButton.BackgroundColor3 = enabled
		and Color3.fromRGB(50, 150, 85)
		or Color3.fromRGB(70, 70, 70)

	-- Hide main frame while selecting
	frame.Visible = not enabled

	if selectInputConnection then
		selectInputConnection:Disconnect()
		selectInputConnection = nil
	end

	if enabled then
		startHighlightTracking()
		selectInputConnection = UserInputService.InputBegan:Connect(function(input)
			if not selectMode then return end
			local tapPos = getTapPosition(input)
			if not tapPos then return end

			task.defer(function()
				if not selectMode then return end
				local objects = playerGui:GetGuiObjectsAtPosition(tapPos.X, tapPos.Y)
				for _, obj in ipairs(objects) do
					if obj.Visible
						and not obj:IsDescendantOf(gui)
						and not obj:IsDescendantOf(highlightGui)
						and matchesSelectType(obj) then
						selectedObject = obj
						setSelectMode(false)
						if dragMode then
							setDragMode(false)
						end
						updateHighlight()
						break
					end
				end
			end)
		end)
	else
		frame.Visible = true
	end
end

adjSelectButton.Activated:Connect(function()
	setSelectMode(not selectMode)
end)

-- Type toggle buttons
local function setSelectType(typeName)
	selectType = typeName
	if typeName == "frame" then
		adjFrameButton.BackgroundColor3 = Color3.fromRGB(50, 150, 85)
		adjButtonButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	else
		adjFrameButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		adjButtonButton.BackgroundColor3 = Color3.fromRGB(50, 150, 85)
	end
	-- Clear current selection if it doesn't match new type
	if selectedObject and selectedObject.Parent and not matchesSelectType(selectedObject) then
		selectedObject = nil
		if dragMode then
			setDragMode(false)
		end
		updateHighlight()
	end
end

