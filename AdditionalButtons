-- Drag implementation via global UserInputService events
local draggingObj = false
local dragObjStart
local dragObjStartPos

UserInputService.InputBegan:Connect(function(input)
	if not dragMode or not selectedObject or not selectedObject.Parent then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		local tapPos = getTapPosition(input)
		if not tapPos then return end
		local objPos = selectedObject.AbsolutePosition
		local objSize = selectedObject.AbsoluteSize
		if tapPos.X >= objPos.X and tapPos.X <= objPos.X + objSize.X
			and tapPos.Y >= objPos.Y and tapPos.Y <= objPos.Y + objSize.Y then
			draggingObj = true
			dragObjStart = input.Position
			dragObjStartPos = selectedObject.Position
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragMode or not draggingObj or not selectedObject or not selectedObject.Parent then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragObjStart
		selectedObject.Position = UDim2.new(
			dragObjStartPos.X.Scale,
			dragObjStartPos.X.Offset + delta.X,
			dragObjStartPos.Y.Scale,
			dragObjStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		draggingObj = false
	end
end)

