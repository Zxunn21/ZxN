local function findJumpButton()
	local touchGui = playerGui:FindFirstChild("TouchGui", true)
	if not touchGui then
		return nil
	end

	return touchGui:FindFirstChild("JumpButton", true)
end

local function applySavedJumpButton()
	jumpButton = findJumpButton()
	if not jumpButton then
		return
	end

	if jumpButtonSavedPosition then
		jumpButton.Position = jumpButtonSavedPosition
	end

	if jumpButtonSavedSize then
		jumpButton.Size = jumpButtonSavedSize
	end
end

local function setJumpDragMode(enabled)
	jumpButtonDragMode = enabled
	jumpDragButton.Text = enabled and "Drag ON" or "Drag"
	jumpDragButton.BackgroundColor3 = enabled
		and Color3.fromRGB(50, 150, 85)
		or Color3.fromRGB(70, 70, 70)

	jumpButton = findJumpButton()
	if not jumpButton then
		return
	end

	if jumpButtonDragConnection then
		jumpButtonDragConnection:Disconnect()
		jumpButtonDragConnection = nil
	end

	if jumpButtonInputConnection then
		jumpButtonInputConnection:Disconnect()
		jumpButtonInputConnection = nil
	end

	if not enabled then
		return
	end

	local draggingJump = false
	local dragStart
	local startPosition

	jumpButtonDragConnection = jumpButton.InputBegan:Connect(function(input)
		if not jumpButtonDragMode then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			draggingJump = true
			dragStart = input.Position
			startPosition = jumpButton.Position
		end
	end)

	jumpButtonInputConnection = jumpButton.InputChanged:Connect(function(input)
		if not jumpButtonDragMode or not draggingJump then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			jumpButton.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)

	if jumpButtonEndConnection then
		jumpButtonEndConnection:Disconnect()
	end

	jumpButtonEndConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if draggingJump and jumpButton then
				jumpButtonSavedPosition = jumpButton.Position
			end
			draggingJump = false
		end
	end)
end

jumpDragButton.Activated:Connect(function()
	setJumpDragMode(not jumpButtonDragMode)
end)

jumpPlusButton.Activated:Connect(function()
	jumpButton = findJumpButton()
	if not jumpButton then
		return
	end

	local size = jumpButton.Size
	jumpButton.Size = UDim2.new(
		size.X.Scale,
		math.min(size.X.Offset + 10, 180),
		size.Y.Scale,
		math.min(size.Y.Offset + 10, 180)
	)

	jumpButtonSavedSize = jumpButton.Size
end)

jumpMinusButton.Activated:Connect(function()
	jumpButton = findJumpButton()
	if not jumpButton then
		return
	end

	local size = jumpButton.Size
	jumpButton.Size = UDim2.new(
		size.X.Scale,
		math.max(size.X.Offset - 10, 40),
		size.Y.Scale,
		math.max(size.Y.Offset - 10, 40)
	)

	jumpButtonSavedSize = jumpButton.Size
end)

player.CharacterAdded:Connect(function()
	task.wait(1)
	applySavedJumpButton()

	if jumpButtonDragMode then
		setJumpDragMode(true)
	end
end)

task.spawn(function()
	for _ = 1, 30 do
		if findJumpButton() then
			applySavedJumpButton()
			break
		end
		task.wait(0.5)
	end
end)
